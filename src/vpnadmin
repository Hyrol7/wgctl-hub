                         else T("{0} ключі скоро відкличуться", len(st['expiring'])))
            elif down:
                title = T("{0} не відповідає", down[0])
            else:
                title = T("Скоро закінчиться сертифікат")
            why = [T("{0}: підозріла активність", n) for n in st["suspects"]]
            why += [T("{0}: скоро автовідкликання", n) for n in st["expiring"]]
