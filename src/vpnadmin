                self.flash(s, "bad", T("Ім'я локації: малі латинські літери, цифри, дефіс"))
            elif not self.need_code(s, f):
                self.flash(s, "bad", T("Потрібен правильний код із застосунку"))
            elif self.act(s, ["location", "add", name, opt("title", f.get("title", "")), opt("networks", f.get("networks", "")),
                              *(["--panel"] if f.get("panel") else [])], T("Локацію додано. Налаштуйте роутер за конфігом нижче.")):
                s["made"][f"loc:{name}"] = time.time()
