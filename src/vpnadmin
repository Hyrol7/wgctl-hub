    LOC_STATE = {"ok": ("ok", T("на зв'язку")), "warn": ("warn", T("затримка зв'язку")), "down": ("bad", T("немає зв'язку"))}

    def loc_lead(self, l):
        cls, text = self.LOC_STATE.get(l["state"], ("idle", l["state"]))
        when = T("останній зв'язок {0}", ago(l["handshake"])) if l.get("handshake") else T("роутер ще не підключався")
