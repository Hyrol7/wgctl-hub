    @staticmethod
    def conf_grace(s, name, c):
        """A key created or reissued in this session without panel access is shown without a code."""
        return not c.get("admin") and time.time() - s["made"].get(name, 0) < CONF_GRACE

    def conf_out(self, s, name, f):
        """Config and QR contain a private key: POST only, a TOTP code (or just issued), logged."""
        try:
            c = wgj("show", name)
        except RuntimeError:
            raise Redirect("/")
        if not self.conf_grace(s, name, c) and not self.need_code(s, f):
            self.flash(s, "bad", T("Щоб отримати конфіг, потрібен правильний код із застосунку"))
            raise Redirect(f"/c/{name}")
        kind = "qr" if f.get("act") == "qr" else "file"
        if kind == "file":
            rc, out, err = wg("conf", name)
            if rc != 0:
                self.flash(s, "bad", err)
                raise Redirect(f"/c/{name}")
            event(T("Завантажено конфіг {0} з панелі ({1})", name, s['ip']), "warning", "📥")
            return self.send(200, out, "application/octet-stream",
                             {"Content-Disposition": f'attachment; filename="{name}.conf"'})
        rc, svg, err = wg("qr", name, "--svg")
        if rc != 0 or "<svg" not in svg:
            self.flash(s, "bad", err or T("Не вдалося створити QR"))
            raise Redirect(f"/c/{name}")
        event(T("Показано QR конфігу {0} у панелі ({1})", name, s['ip']), "warning", "📱")
        hero = self.hero(T("QR для {0}", name), T("Відскануйте в застосунку WireGuard: «Додати тунель» → «Сканувати QR». QR містить приватний ключ: не показуйте його стороннім і закрийте сторінку після сканування."),
                         T("<a class=\"b fill\" href=\"/c/{0}\">Готово</a>", name), small=True)
        body = f'<section><div class="panel qrbox"><div class="qr">{svg[svg.find("<svg"):]}</div></div></section>'
        return self.send(200, self.layout(s, f"QR {name}", hero, body, "home"))

