# ---- sessions and protection -----------------------------------------------
SESSIONS = {}
FAILS = {}
_lock = threading.Lock()


def new_session(ip, ua, epoch):
    tok = secrets.token_urlsafe(32)
    t = time.time()
    with _lock:
        for k in [k for k, v in SESSIONS.items() if t - v["seen"] > IDLE_SEC or t - v["created"] > MAX_SEC]:
            SESSIONS.pop(k, None)
        while len(SESSIONS) >= MAX_SESSIONS:
            SESSIONS.pop(min(SESSIONS, key=lambda k: SESSIONS[k]["seen"]), None)
        # fresh=0: critical actions need a code even right after login
        SESSIONS[tok] = {"tok": tok, "csrf": secrets.token_urlsafe(24), "created": t, "seen": t, "ip": ip,
                         "ua": ua[:120], "fresh": 0, "code_fails": 0, "made": {}, "flash": [], "epoch": epoch}
    return tok


def failed(ip):
    """Records a failure; returns the number of failures from this IP within the window."""
    t = time.time()
    with _lock:
        for k in [k for k, v in FAILS.items() if not v or v[-1] < t - FAIL_WINDOW]:
            FAILS.pop(k, None)
        FAILS.setdefault(ip, []).append(t)
        FAILS[ip] = [x for x in FAILS[ip] if x > t - FAIL_WINDOW]
        return len(FAILS[ip])


def locked(ip):
    t = time.time()
    with _lock:
        mine = [x for x in FAILS.get(ip, []) if x > t - FAIL_WINDOW]
        total = sum(1 for v in FAILS.values() for x in v if x > t - FAIL_WINDOW)
    return len(mine) >= FAIL_LIMIT or total >= FAIL_LIMIT * 4


# ---- HTTP ------------------------------------------------------------------
class Redirect(Exception):
    def __init__(self, to):
        self.to = to


class H(http.server.BaseHTTPRequestHandler):
    server_version = "vpnadmin"
    sys_version = ""
    timeout = 30                                   # slow connections do not hold threads

    def log_message(self, fmt, *args):
        pass

    # -- helpers
    def ip(self):
        """Client address. X-Forwarded-For is trusted only from Caddy on this machine (the last value)."""
        peer = self.client_address[0]
        if peer in ("127.0.0.1", "::1"):
            xff = [x.strip() for x in self.headers.get("X-Forwarded-For", "").split(",") if x.strip()]
            if xff:
                return xff[-1]
        return peer

    def same_origin(self):
        """For POST: Origin must be ours; without Origin only Sec-Fetch-Site: same-origin is accepted."""
        origin = self.headers.get("Origin")
        if origin:
            return origin == ORIGIN
        return self.headers.get("Sec-Fetch-Site") == "same-origin"

    def session(self):
        cookie = self.headers.get("Cookie", "")
        m = re.search(rf"(?:^|;\s*){re.escape(COOKIE)}=([\w-]+)", cookie)
        if not m:
            return None, None
        tok = m.group(1)
        s = SESSIONS.get(tok)
        t = time.time()
        if not s:
            return None, None
        try:
            epoch = load_auth().get("epoch", 1)
        except OSError:
            epoch = -1
        if t - s["seen"] > IDLE_SEC or t - s["created"] > MAX_SEC or s["epoch"] != epoch:
            SESSIONS.pop(tok, None)
            return None, None
        s["seen"] = t
        return tok, s

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        if "Cache-Control" not in (headers or {}):
            self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; "
                         "frame-ancestors 'none'; form-action 'self'; base-uri 'none'")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "same-origin")
        self.send_header("Strict-Transport-Security", "max-age=31536000")
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), usb=()")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, to, headers=None):
        self.send_response(303)
        self.send_header("Location", to)
        self.send_header("Content-Length", "0")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()

    def form(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n < 0 or n > 64 * 1024:
            raise ValueError("too big")
        q = urllib.parse.parse_qs(self.rfile.read(n).decode(), keep_blank_values=True)
        return {k: v if len(v) > 1 else v[0] for k, v in q.items()}

    def flash(self, s, kind, text):
        s["flash"].append((kind, text))

    # -- routing
    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def route(self, method):
        url = urllib.parse.urlsplit(self.path)
        path, qs = url.path, urllib.parse.parse_qs(url.query)
        try:
            if path in STATIC:
                raw, gz, ctype, ver = STATIC[path]
                hdr = {"Cache-Control": "public, max-age=31536000, immutable" if qs.get("v") == [ver]
                       else "public, max-age=3600", "Vary": "Accept-Encoding"}
                if "gzip" in self.headers.get("Accept-Encoding", ""):
                    return self.send(200, gz, ctype, {**hdr, "Content-Encoding": "gzip"})
                return self.send(200, raw, ctype, hdr)
            mf = re.fullmatch(r"/static/f/([a-z-]+)\.woff2", path)
            if mf and mf.group(1) in FONT_BIN:
                return self.send(200, FONT_BIN[mf.group(1)], "font/woff2",
                                 {"Cache-Control": "public, max-age=2592000, immutable"})
            if path == "/login":
                return self.login(method)
            self.qs = qs
            tok, s = self.session()
            if not s:
                return self.redirect("/login")
            if method == "POST":
                f = self.form()
                if not self.same_origin() or not same(f.get("csrf", ""), s["csrf"]):
                    return self.send(403, T("Запит відхилено (CSRF)"), "text/plain; charset=utf-8")
            else:
                f = {}
            # names as in wgctl: start with a letter or digit, so "/c/--admin" never becomes a wgctl option
            m = re.fullmatch(rf"/c/({NAME_PATTERN})(/conf)?", path)
            ms = re.fullmatch(rf"/s/({NAME_PATTERN})", path)
            mt = re.fullmatch(rf"/t/({NAME_PATTERN})", path)
            ml = re.fullmatch(rf"/l/({NAME_PATTERN})(/conf)?", path)
            if path == "/":
                body = self.page_overview(s, qs.get("f", [""])[0])
            elif path == "/logout" and method == "POST":
                SESSIONS.pop(tok, None)
                return self.redirect("/login", {"Set-Cookie": f"{COOKIE}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Strict"})
            elif path == "/new":
                body = self.page_new(s, method, f)
            elif m and m.group(2):
                if method != "POST":
                    raise Redirect(f"/c/{m.group(1)}")
                return self.conf_out(s, m.group(1), f)
            elif m:
                body = self.page_client(s, m.group(1), method, f)
            elif path == "/locations":
                body = self.page_locations(s, method, f)
            elif ml and ml.group(2):
                if method != "POST":
                    raise Redirect(f"/l/{ml.group(1)}")
                return self.location_conf(s, ml.group(1), f)
            elif ml:
                body = self.page_location(s, ml.group(1), method, f)
            elif path == "/sites":
                body = self.page_sites(s, method, f)
            elif ms:
                body = self.page_site(s, ms.group(1), method, f)
            elif mt:
                body = self.page_svc(s, mt.group(1), method, f)
            elif path == "/log":
                body = self.page_log(s, qs.get("client", [""])[0], qs.get("cat", [""])[0])
            elif path == "/settings":
                body = self.page_settings(s, tok, method, f)
            elif path == "/server":
                body = self.page_server(s, method, f)
            else:
                return self.send(404, self.layout(s, T("Не знайдено"), self.hero(T("Сторінку не знайдено"), small=True), ""))
            self.send(200, body)
        except Redirect as r:
            self.redirect(r.to)
        except ValueError:
            self.send(400, T("Некоректний запит"), "text/plain; charset=utf-8")
        except Exception as ex:      # no tracebacks to the outside
            sys.stderr.write(f"error {self.path}: {ex!r}\n")
            self.send(500, T("Внутрішня помилка панелі. Деталі: journalctl -u vpnadmin"), "text/plain; charset=utf-8")


