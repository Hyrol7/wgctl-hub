# ---- calling wgctl -----------------------------------------------------------
# Every wgctl call is a separate process through sudo (~0.1-0.3 s). Reads are cached for a few seconds
# and run in parallel; any change clears the cache, so after an action the page is always fresh.
CACHE_SEC = 3
_cache, _cache_lock = {}, threading.Lock()
_READ = {"status", "list", "show", "log", "conf", "qr", "server", "config", "history", "visits"}
_READ2 = {("site", "list"), ("notify", "show"), ("notify", "groups"), ("tcp", "list")}


def _is_read(args):
    return bool(args) and (args[0] in _READ or tuple(args[:2]) in _READ2)


def wg(*args, timeout=60):
    args = [str(a) for a in args]
    write = not _is_read(args)
    if write:
        with _cache_lock:
            _cache.clear()
    try:
        r = subprocess.run(WGCTL + args, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return 124, "", T("wgctl не відповів вчасно")
    finally:
        if write:
            with _cache_lock:
                _cache.clear()
    return r.returncode, r.stdout, (r.stderr or r.stdout).strip()


def wgj(*args):
    key = tuple(str(a) for a in args)
    with _cache_lock:
        hit = _cache.get(key)
    if hit and time.monotonic() - hit[0] < CACHE_SEC:
        return json.loads(hit[1])            # a new copy: pages may modify the data
    rc, out, err = wg(*args, "--json")
    if rc != 0:
        raise RuntimeError(err)
    data = json.loads(out)
    with _cache_lock:
        _cache[key] = (time.monotonic(), out)
    return data


_pool = ThreadPoolExecutor(max_workers=6)


def event(text, level="warning", icon="🛡"):
    """A security event to the log and Signal. In the background: sending does not delay the page.
    level: critical — also to admins privately; warning — to the group chat."""
    _pool.submit(wg, "event", "--cat", "security", "--level", level, opt("icon", icon), "--", text)


def prefetch(*calls):
    """Runs several wgctl reads at once; errors surface in the normal wgj()."""
    futs = [_pool.submit(wgj, *c) for c in calls]
    for f in futs:
        try:
            f.result()
        except Exception:
            pass


