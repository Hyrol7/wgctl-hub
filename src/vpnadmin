        body = T("{0}{1}{2}\n<section><h2>Пароль</h2><div class=\"panel\"><form method=\"post\">{3}<input type=\"hidden\" name=\"act\" value=\"passwd\">\n<div class=\"g2\"><div><label class=\"f\" for=\"o\">Поточний пароль</label><input type=\"password\" id=\"o\" name=\"old\" autocomplete=\"current-password\" required></div>\n{4}\n<div><label class=\"f\" for=\"n1\">Новий пароль, мінімум 12 символів</label><input type=\"password\" id=\"n1\" name=\"new\" autocomplete=\"new-password\" minlength=\"12\" required></div>\n<div><label class=\"f\" for=\"n2\">Ще раз</label><input type=\"password\" id=\"n2\" name=\"new2\" autocomplete=\"new-password\" minlength=\"12\" required></div></div>\n<div class=\"row\"><button class=\"btn pri\">Змінити пароль</button></div></form></div></section>\n{5}\n<section><h2>Резервні коди</h2><div class=\"panel\"><p class=\"muted small\">Кожен код діє один раз замість коду з телефона.</p>\n<form method=\"post\" class=\"row\" data-confirm=\"Старі резервні коди перестануть діяти. Продовжити?\">{6}<input type=\"hidden\" name=\"act\" value=\"backup\">\n{7}<button class=\"btn\">Перевидати коди</button></form>\n<p class=\"small muted\">Втратили телефон: увійдіть резервним кодом, відновіть коди із секрету TOTP з менеджера паролів або через SSH виконайте vpnadmin reset-totp.</p></div></section>\n<section><h2>Сесії</h2><div class=\"lines\">{8}</div>\n<div class=\"row\"><form method=\"post\">{9}<input type=\"hidden\" name=\"act\" value=\"logout_all\"><button class=\"btn\">Завершити інші сесії</button></form>\n<form method=\"post\" action=\"/logout\">{10}<button class=\"btn\">Вийти з панелі</button></form></div></section>", codes_html, low, self.notify_block(s), cs, self.code_field('cd1', True), self.keys_block(s), cs, self.code_field('cd2', True), sess, cs, cs)
        return self.layout(s, T("Налаштування"), hero, body, "settings", self.sys_state()[0])


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


SESSIONS_FILE = f"{AUTH_DIR}/sessions.restart.json"


def restart_soon():
    """Restart the panel in a moment (e.g. new language): sessions are handed over through a short-lived file."""
    def go():
        time.sleep(0.6)
        with _lock:
            data = json.dumps({"ts": time.time(), "sessions": SESSIONS})
        fd = os.open(SESSIONS_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(data)
        os.execv(sys.executable, getattr(sys, "orig_argv", [sys.executable] + sys.argv))   # keeps flags such as -I
    threading.Thread(target=go, daemon=True).start()


def restore_sessions():
    try:
        with open(SESSIONS_FILE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return
    finally:
        try:
            os.remove(SESSIONS_FILE)
        except OSError:
            pass
    if time.time() - data.get("ts", 0) < 30:             # only a restart we just did ourselves
        SESSIONS.update({k: v for k, v in data.get("sessions", {}).items() if isinstance(v, dict) and v.get("tok") == k})


def serve():
    restore_sessions()
    if not os.path.exists(AUTH_FILE):
        sys.stderr.write(T("Обліковий запис не створено: vpnadmin setup\n"))
    srv = Server((BIND, PORT), H)
    sys.stderr.write(T("vpnadmin {0} на {1}:{2}\n", VERSION, BIND, PORT))
    srv.serve_forever()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "serve":
        serve()
    elif cmd == "setup":
        cli_setup("--force" in sys.argv)
    elif cmd == "passwd":
        cli_passwd()
    elif cmd == "reset-totp":
        cli_reset_totp()
    elif cmd == "backup-codes":
        cli_backup_codes()
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
