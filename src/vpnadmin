    def page_svc(self, s, name, method, f):
        if name == "new" and method == "POST":
            sname, ip = norm_name(f.get("name", "")), str(f.get("target", "")).strip()
            kind = f.get("kind") if f.get("kind") in SVC_KINDS else "tcp"
            port = str(f.get("tport", "")).strip() or str(SVC_KINDS[kind][1] or "")
            if not NAME_RE.match(sname) or not re.fullmatch(r"[\d.]{7,15}", ip) or not port.isdigit():
                self.flash(s, "bad", T("Перевірте ім'я, адресу цілі (напр. 192.168.1.20) і порт"))
                raise Redirect("/sites#add-tcp")
            args = ["tcp", "add", sname, f"{ip}:{port}"] + ([opt("note", f["note"])] if f.get("note") else [])
            if self.act(s, args, T("Сервіс додано. Тепер дайте до нього доступ ключам.")):
                raise Redirect(f"/t/{sname}")
            raise Redirect("/sites#add-tcp")
        tcp = self.tcp_list()
        sv = next((x for x in tcp["services"] if x["name"] == name), None)
        if not sv:
            return self.layout(s, name, self.hero(T("Сервіс не знайдено"), small=True), "", "sites")
        if method == "POST":
            a = f.get("act")
            if a == "access":
                want = f.get("who", [])
                want = {want} if isinstance(want, str) else set(want)
                cand = [w for w in f.get("cand", "").split(",") if NAME_RE.match(w)]
                add = sorted(w for w in cand if w in want and w not in sv["allow"])
                rem = sorted(w for w in cand if w not in want and w in sv["allow"])
                if add:
                    self.act(s, ["tcp", "allow", name] + add, T("Доступ надано: {0}", ', '.join(add)))
                if rem:
                    self.act(s, ["tcp", "deny", name] + rem, T("Доступ забрано: {0}", ', '.join(rem)))
            elif a == "save":
                tgt = f"{str(f.get('target', '')).strip()}:{str(f.get('tport', '')).strip()}"
                self.act(s, ["tcp", "set", name, opt("target", tgt), opt("note", f.get("note", ""))], T("Сервіс збережено"))
            elif a == "delete":
                if self.act(s, ["tcp", "rm", name], T("Сервіс видалено")):
                    raise Redirect("/sites")
            raise Redirect(f"/t/{name}")
        clients = wgj("list")
        h = sv.get("health") or {}
        state = "s-ok" if h.get("ok") else ("s-bad" if h else "s-idle")
        lead = (T("{0} на {1}:{2}, розміщено: {3}. Доступ мають {4} ключів.", e(SVC_KINDS.get(sv['kind'], SVC_KINDS['tcp'])[0]), e(sv['target']), sv['target_port'], e(self.where(sv)), len(sv['allow'])))
        facts = [(f"{sv['port']}", T("порт на хабі")), (f"{sv['target']}:{sv['target_port']}", T("ціль")),
                 (len(sv["allow"]), T("мають доступ")), (T("{0} мс", h['ms']) if h.get("ok") else "-", T("відповідь цілі"))]
        hero = self.hero(f"{sv['host']}:{sv['port']}", lead, "", facts,
                         chip=T("Відповідає") if h.get("ok") else (T("Ціль не відповідає") if h else T("Ще не перевірено")))
        cs = self.csrf(s)
        togs, cands = [], []
        for c in clients:
            if c["status"] == "revoked":
                continue
            cands.append(c["name"])
