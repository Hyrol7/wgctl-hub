                      "guest_more": (["extend", name, "--hours", "2"], "")}
            if a in simple:
                if self.act(s, *simple[a]) and a == "reissue":
                    s["made"][name] = time.time()
            elif a == "save":
                # --option=value: user text never becomes a separate wgctl option
                args = ["set", name, opt("note", f.get("note", "")), opt("notes", f.get("notes", "")),
                        opt("phone", f.get("phone", "") or "none"), opt("expires", f.get("expires", "") or "none"),
