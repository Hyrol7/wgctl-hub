                sens = set(admins) != set(cur.get("admins", [])) or group != cur.get("group", "")
                if sens and not self.need_code(s, {"code": f.get("code", "")}):
                    self.flash(s, "bad", T("Щоб змінити адміністраторів чи групу, потрібен код із застосунку"))
                    raise Redirect("/settings")
                if set(admins) != set(cur.get("admins", [])):
                    args.append(opt("admins", ",".join(admins) or "none"))
                if group != cur.get("group", ""):
                    names = {g["id"]: g["name"] for g in self.groups()}
                    args += [opt("group", group or "none"), opt("group-name", names.get(group, ""))]
                self.act(s, args, T("Налаштування сповіщень збережено"))
            elif a == "notify_group":
                if not self.need_code(s, {"code": f.get("code", "")}):
                    self.flash(s, "bad", T("Потрібен правильний код із застосунку"))
