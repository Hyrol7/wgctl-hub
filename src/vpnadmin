    # -- settings
    def page_settings(self, s, tok, method, f):
        codes = None
        if method == "POST":
            a = f.get("act")
            if a == "logout_all":
                with _lock:
                    for t in [t for t in SESSIONS if t != tok]:
                        SESSIONS.pop(t, None)
                self.flash(s, "ok", T("Інші сесії завершено"))
            elif a == "notify":
                cur = wgj("notify", "show")
                admins = [x for x in re.split(r"[\s,;]+", str(f.get("admins", ""))) if x]
                group = str(f.get("group", ""))
                args = ["notify", "set", "--connect", "on" if f.get("connect") else "off",
