        if problems:
            return "s-bad", problems[0][:1].upper() + problems[0][1:], problems
        attn = st["suspects"] + st["expiring"]
        down = [x["name"] for grp in st["topology"]["locations"].values() for x in grp if x["ok"] is False]
        down += [x["name"] for x in st["topology"]["other"] + st["topology"]["vps"] if x["ok"] is False]
        down += [x["name"] for d in st["topology"]["devices"] for x in d["sites"] if x["ok"] is False and d["online"]]
        if attn or down or (st.get("cert_days") is not None and st["cert_days"] <= 14):
            if st["suspects"]:
                title = (T("{0} під підозрою", st['suspects'][0]) if len(st["suspects"]) == 1
