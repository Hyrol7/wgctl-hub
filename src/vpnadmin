def load_auth():
    with open(AUTH_FILE) as f:
        return json.load(f)


def save_auth(auth):
    tmp = AUTH_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with open(fd, "w") as f:
        json.dump(auth, f, indent=2)
    try:
        st = os.stat(AUTH_DIR)
        os.chown(tmp, st.st_uid, st.st_gid)      # setup runs as root
    except OSError:
        pass
    os.replace(tmp, AUTH_FILE)


# ---- CLI -------------------------------------------------------------------
def ask_password():
    while True:
        p1 = getpass.getpass(T("Новий пароль (мін. 12 символів): "))
        if len(p1) < 12:
            print(T("Закороткий"))
            continue
        if p1 != getpass.getpass(T("Ще раз: ")):
            print(T("Не збігається"))
            continue
        return p1


def enroll_totp(user):
    secret = base64.b32encode(secrets.token_bytes(20)).decode()
    uri = (f"otpauth://totp/{urllib.parse.quote(BRAND)}:{urllib.parse.quote(user)}?secret={secret}"
           f"&issuer={urllib.parse.quote(BRAND)}")
    print(T("\nВідскануйте QR у застосунку для кодів (Google Authenticator, 1Password, Authy):\n"))
    try:
        subprocess.run(["qrencode", "-t", "ansiutf8"], input=uri.encode())
    except FileNotFoundError:
        print(T("(немає qrencode, введіть секрет вручну)"))
    print(T("Секрет текстом (збережіть у менеджері паролів):"), " ".join(secret[i:i + 4] for i in range(0, 32, 4)))
    for _ in range(3):
        code = input(T("\nВведіть код із застосунку для перевірки: "))
        if totp_check({"totp": secret}, code):
            return secret
        print(T("Код не підходить. Перевірте час на телефоні і спробуйте ще раз"))
    sys.exit(T("TOTP не підтверджено, нічого не змінено"))


def print_codes(codes):
    print(T("\nРезервні коди (кожен діє один раз, замість коду з телефона). ЗБЕРЕЖІТЬ ЇХ:\n"))
    for i in range(0, 10, 2):
        print(f"   {codes[i]}     {codes[i + 1]}")
    print()


def cli_setup(force):
    if os.path.exists(AUTH_FILE) and not force:
        sys.exit(T("Обліковий запис уже є ({0}). Повторно: vpnadmin setup --force", AUTH_FILE))
    os.makedirs(AUTH_DIR, mode=0o700, exist_ok=True)
    user = input(T("Логін [admin]: ")).strip() or "admin"
    pw = ask_password()
    secret = enroll_totp(user)
    codes, recs = make_backup_codes()
    save_auth({"user": user, "pw": make_pw(pw), "totp": secret, "totp_last": 0, "backup": recs,
               "created": int(time.time()), "pw_changed": int(time.time()), "epoch": 1})
    print_codes(codes)
    print(T("Готово. Обліковий запис створено."))


def cli_passwd():
    auth = load_auth()
    auth["pw"] = make_pw(ask_password())
    auth["pw_changed"] = int(time.time())
    auth["epoch"] = auth.get("epoch", 1) + 1          # ends all sessions
    save_auth(auth)
    print(T("Пароль змінено, усі сесії завершено (після перезапуску служби)."))


def cli_reset_totp():
    auth = load_auth()
    auth["totp"] = enroll_totp(auth["user"])
    auth["totp_last"] = 0
    codes, auth["backup"] = make_backup_codes()
    auth["epoch"] = auth.get("epoch", 1) + 1
    save_auth(auth)
    print_codes(codes)
    print(T("TOTP скинуто, старі резервні коди більше не діють."))


def cli_backup_codes():
