# ---- credentials ------------------------------------------------------------
def scrypt(password, salt):
    return hashlib.scrypt(password.encode(), salt=salt, n=2 ** 15, r=8, p=1, maxmem=64 * 1024 * 1024).hex()


def make_pw(password):
    salt = secrets.token_bytes(16)
    return {"salt": salt.hex(), "hash": scrypt(password, salt)}


def check_pw(rec, password):
    return hmac.compare_digest(scrypt(password, bytes.fromhex(rec["salt"])), rec["hash"])


def same(a, b):
    """Constant-time comparison; str.compare_digest fails on non-ASCII."""
    return hmac.compare_digest(str(a).encode(), str(b).encode())


def totp_at(secret, counter):
    key = base64.b32decode(secret)
    h = hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
    o = h[-1] & 0x0F
    return f"{(struct.unpack('>I', h[o:o + 4])[0] & 0x7FFFFFFF) % 1000000:06d}"


def totp_check(auth, code):
    """TOTP code (±30 s), the same code is never accepted twice."""
    code = re.sub(r"\s", "", code or "")
    if not re.fullmatch(r"\d{6}", code):
        return False
    now = int(time.time()) // 30
    for c in (now - 1, now, now + 1):
        if c > auth.get("totp_last", 0) and hmac.compare_digest(totp_at(auth["totp"], c), code):
            auth["totp_last"] = c
            return True
    return False


def make_backup_codes():
    codes, recs = [], []
    for _ in range(10):
        raw = base64.b32encode(secrets.token_bytes(5)).decode().lower()
        code = f"{raw[:4]}-{raw[4:8]}"
        salt = secrets.token_bytes(8)
        codes.append(code)
        recs.append({"salt": salt.hex(), "hash": hashlib.sha256(salt + code.encode()).hexdigest(), "used": 0})
    return codes, recs


def backup_check(auth, code):
    code = (code or "").strip().lower().replace(" ", "")
    if not re.fullmatch(r"[a-z2-7]{4}-[a-z2-7]{4}", code):
        return False
    for r in auth["backup"]:
        if not r["used"] and hmac.compare_digest(
                hashlib.sha256(bytes.fromhex(r["salt"]) + code.encode()).hexdigest(), r["hash"]):
            r["used"] = int(time.time())
            return True
    return False


