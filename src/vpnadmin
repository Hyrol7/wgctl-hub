    def location_conf(self, s, name, f):
        """Router config holds the router's private key: POST only, TOTP code (or just created), logged."""
        fmt = f.get("fmt", "")
        if fmt not in ("wg", "mikrotik", "openwrt"):
            raise Redirect(f"/l/{name}")
        if not self.loc_grace(s, name) and not self.need_code(s, f):
            self.flash(s, "bad", T("Щоб отримати конфіг, потрібен правильний код із застосунку"))
            raise Redirect(f"/l/{name}")
        rc, out, err = wg("location", "conf", name, "--format", fmt)
        if rc != 0:
            self.flash(s, "bad", err)
            raise Redirect(f"/l/{name}")
        event(T("Показано конфіг роутера локації {0} ({1})", name, s['ip']), "warning", "📍")
        if fmt == "wg":
            return self.send(200, out, "application/octet-stream",
                             {"Content-Disposition": f'attachment; filename="location-{name}.conf"'})
        what = "MikroTik (RouterOS 7)" if fmt == "mikrotik" else "OpenWrt"
        hero = self.hero(T("Конфіг роутера: {0}", what),
                         T("Вставте ці команди в термінал роутера. Вони містять приватний ключ: не пересилайте їх і закрийте сторінку після налаштування."),
                         T("<a class=\"b fill\" href=\"/l/{0}\">Готово</a>", name), small=True)
        body = f'<section><div class="panel"><pre class="code">{e(out)}</pre></div></section>'
        return self.send(200, self.layout(s, T("Конфіг роутера"), hero, body, "locations"))

