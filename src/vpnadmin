def ago(ts):
    if not ts:
        return T("ніколи")
    s = max(0, int(time.time()) - ts)
    if s < 60:
        return T("{0} с тому", s)
    if s < 3600:
        return T("{0} хв тому", s // 60)
    if s < 86400:
        return T("{0} год тому", s // 3600)
    return T("{0} дн тому", s // 86400)


def hm(sec):
    """3700 -> "1 h 1 min"."""
    sec = max(0, int(sec or 0))
    h, m = sec // 3600, sec % 3600 // 60
    return ((T("{0} год ", h) if h else "") + T("{0} хв", m)) if h or m else T("менше хвилини")


