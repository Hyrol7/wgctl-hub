uted\">Ключів ще немає.</p>"), self.availability(f"/s/{name}", name), self.visits_block(self.site_visits(name)), pub, cs, self.code_field('pc'), pcls, pact, plabel, cs, e(site['backend']), e(site.get('note') or ''), ' checked' if site.get('insecure') else '', ' checked' if site.get('upstream_host') else '', self.bform(s, "delete", T("Видалити сайт"), "btn danger", T("Видалити {0}? Доступ до нього зникне в усіх.", site['host'])),
