    def sys_state(self, st=None):
        """System state for the status strip: (class, sentence, subline)."""
        st = st or wgj("status")
        problems = []
        if st["wg0"] != "ok":
            problems.append(T("WireGuard на VPS не працює"))
        if st["caddy"] != "ok":
