увати</a></div></form>", f'<div class="note bad">{e(err)}</div>' if err else '', self.csrf(s), '' if f.get('kind') == 'guest' else ' checked', ' checked' if f.get('kind') == 'guest' else '', ''.join(T("<label class=\"tog\"><input type=\"radio\" name=\"hours\" value=\"{0}\"{1}><span>{2} год</span></label>", h, " checked" if str(h) == str(f.get("hours", "4")) else "", h) for h in GUEST_HOURS), NAME_PATTERN, NAME_HINT, g('name'), NAME_HINT, g('note'), g('phone'), g('expires'), self.toggles(sites, []), self.code_field('cd', label=T("Код із застосунку (лише для доступу до панелі)")))
