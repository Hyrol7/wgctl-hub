    def login(self, method):
        ip = self.ip()
        err = ""
        if method == "POST":
            f = self.form()
            if not self.same_origin():
                return self.send(403, T("Запит відхилено"), "text/plain; charset=utf-8")
            # the lockout check is inside the lock: parallel requests cannot bypass the limit
            with _auth_lock:
                if locked(ip):
                    err = T("Забагато невдалих спроб. Спробуйте через 15 хвилин.")
                    ok = None
                else:
                    try:
                        auth = load_auth()
                    except OSError:
                        return self.send(503, T("Обліковий запис не створено: vpnadmin setup"), "text/plain; charset=utf-8")
                    # scrypt always runs: response time does not reveal whether the login was right
                    pw_ok = check_pw(auth["pw"], str(f.get("password", ""))[:1024])
                    ok = same(f.get("user", ""), auth["user"]) and pw_ok
                    code = str(f.get("code", ""))
                    used_backup = False
                    if ok and not totp_check(auth, code):
                        used_backup = backup_check(auth, code)
                        ok = used_backup
                    if ok:
                        save_auth(auth)
                    else:
                        n = failed(ip)
            if ok is None:
                pass                                   # locked out, nothing is computed
            elif ok:
                left = sum(1 for r in auth["backup"] if not r["used"])
                tok = new_session(ip, self.headers.get("User-Agent", ""), auth.get("epoch", 1))
                s = SESSIONS[tok]
                if used_backup:
                    self.flash(s, "warn", T("Вхід за резервним кодом. Лишилось кодів: {0}. Якщо телефон втрачено, скиньте TOTP: vpnadmin reset-totp (через SSH).", left))
                event(T("Вхід у панель з {0}", ip) + (T(" (резервний код)") if used_backup else ""),
                      "critical" if used_backup else "warning", "🔓")
                return self.redirect("/", {"Set-Cookie": f"{COOKIE}={tok}; Path=/; Secure; HttpOnly; SameSite=Strict"})
            else:
                # only the first failure and the lockout go to Signal, no spam during brute force
                if n == 1:
                    event(T("Невдала спроба входу в панель з {0}", ip), "warning", "🔐")
                elif n == FAIL_LIMIT:
                    event(T("Вхід із {0} заблоковано на 15 хв: {1} невдалих спроб", ip, n), "critical", "⛔")
                err = T("Невірний логін, пароль або код.")
        body = T("<div class=\"login\"><span class=\"logo\">{0}</span><div class=\"panel\">\n<h2>Вхід у панель</h2>{1}\n<form method=\"post\" action=\"/login\" autocomplete=\"on\">\n<label class=\"f\" for=\"u\">Логін</label><input type=\"text\" id=\"u\" name=\"user\" autocomplete=\"username\" required>\n<label class=\"f\" for=\"p\">Пароль</label><input type=\"password\" id=\"p\" name=\"password\" autocomplete=\"current-password\" required>\n<label class=\"f\" for=\"c\">Код із застосунку або резервний код</label>\n<input type=\"text\" id=\"c\" name=\"code\" inputmode=\"numeric\" autocomplete=\"one-time-code\" placeholder=\"123456\" required>\n<div class=\"row\"><button class=\"btn pri\">Увійти</button></div></form>\n<p class=\"small muted\">Телефону з кодами немає під рукою? Введіть резервний код (xxxx-xxxx) або скиньте TOTP через SSH: vpnadmin reset-totp.</p></div></div>", e(BRAND), f'<div class="note bad">{e(err)}</div>' if err else '')
        page = T("<!doctype html><html lang=\"uk\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\"><title>Вхід · {0}</title><link rel=\"icon\" href=\"/favicon.svg?v={1}\">\n<link rel=\"stylesheet\" href=\"/static/app.css?v={2}\"></head><body>{3}</body></html>", e(BRAND), ASSET_V['/favicon.svg'], ASSET_V['/static/app.css'], body)
        self.send(200 if not err else 401, page)

    def need_code(self, s, f):
        """Re-confirmation with a TOTP code for critical actions. 5 wrong codes end the session."""
        if not str(f.get("code", "")).strip():
            return time.time() - s.get("fresh", 0) < FRESH_SEC     # an empty field does not count as an attempt
        with _auth_lock:
            auth = load_auth()
            ok = totp_check(auth, str(f.get("code", "")))
            if ok:
                save_auth(auth)
        if ok:
            s["fresh"], s["code_fails"] = time.time(), 0
            return True
        s["code_fails"] = s.get("code_fails", 0) + 1
        if s["code_fails"] >= CODE_FAILS:
            SESSIONS.pop(s.get("tok"), None)
            event(T("Сесію з {0} завершено: {1} невірних кодів підтвердження", s['ip'], CODE_FAILS), "critical", "⛔")
            raise Redirect("/login")
        return False

