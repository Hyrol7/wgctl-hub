    # -- client
    def page_client(self, s, name, method, f):
        if method == "POST":
            a = f.get("act", "")
            simple = {"disable": (["disable", name], T("Доступ вимкнено")),
                      "block": (["disable", name, "--reason", "suspicious"], T("Заблоковано")),
