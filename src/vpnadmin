    @staticmethod
    def nice_max(v):
        if v <= 0:
            return 1
        import math
        e = 10 ** math.floor(math.log10(v))
        for m in (1, 2, 2.5, 5, 10):
            if v <= m * e:
                return m * e
        return 10 * e

    def ticks(self, h):
        """X axis labels in the hub's time zone: [(time, label)]."""
        frm, to, rng = h["from"], h["to"], h["range"]
        out = []
        d = datetime.fromtimestamp(frm, TZ).replace(minute=0, second=0, microsecond=0)
        from datetime import timedelta
        if rng == "24h":
            d = d.replace(hour=d.hour // 6 * 6) + timedelta(hours=6)
            while d.timestamp() < to:
                out.append((d.timestamp(), d.strftime("%H:00")))
                d += timedelta(hours=6)
        else:
            d = d.replace(hour=0) + timedelta(days=1)
            every = 1 if rng == "7d" else 7
            while d.timestamp() < to:
                if (d.toordinal() % every) == 0 or every == 1:
                    out.append((d.timestamp(), f"{self.WEEKDAYS[d.weekday()]} {d.day}" if rng == "7d" else d.strftime("%d.%m")))
                d += timedelta(days=1)
        return out

    def chart(self, h, series, kind="line", fmt=str, unit=""):
        """series: [(key, name, colour class)]. kind: bars (stacked) | line.
        Two SVG versions: wide and narrow (phone), so axis labels stay readable."""
        legend = ""
        if len(series) > 1:
            legend = '<div class="lg">' + "".join(f'<span><i class="{c}"></i>{e(t)}</span>' for _, t, c in series) + "</div>"
        return (f'<div class="chart">{legend}{self._chart_svg(h, series, kind, fmt, unit, 640, "wide")}'
                f'{self._chart_svg(h, series, kind, fmt, unit, 340, "narrow")}</div>')

    def _chart_svg(self, h, series, kind, fmt, unit, W, cls):
        H, x0, x1, y0, y1 = 156, 46 if W < 400 else 52, W - 6, 10, 132
        frm, to, step = h["from"], h["to"], h["step"]
        n = max(1, (to - frm) // step + 1)
        bw = (x1 - x0) / n
        data = {k: dict((b, v) for b, v in h["series"].get(k, [])) for k, _, _ in series}
        buckets = range(frm, frm + n * step, step)
        if kind == "bars":
            tot = [sum(data[k].get(b, 0) for k, _, _ in series) for b in buckets]
        else:
            tot = [v for k, _, _ in series for v in data[k].values()]
        top = self.nice_max(max(tot, default=0))
        Y = lambda v: y1 - (y1 - y0) * min(v, top) / top
        X = lambda b: x0 + (b - frm) / step * bw
        g = [f'<svg viewBox="0 0 {W} {H}" class="ch {cls}" role="img" aria-label="{e(", ".join(t for _, t, _ in series))}">']
        for fr in (0, .5, 1):
            yy = Y(top * fr)
            g.append(f'<line class="gl" x1="{x0}" x2="{x1}" y1="{yy:.1f}" y2="{yy:.1f}"/>'
                     f'<text class="ax" x="{x0 - 6}" y="{yy + 4:.1f}" text-anchor="end">{e(fmt(top * fr))}</text>')
        tks = self.ticks(h)
        if W < 400 and len(tks) > 4:
            tks = tks[::2]
        for ts, lab in tks:
            xx = X(ts)
            if x0 + 10 < xx < x1 - 10:
                g.append(f'<line class="tk" x1="{xx:.1f}" x2="{xx:.1f}" y1="{y1}" y2="{y1 + 4}"/>'
                         f'<text class="ax" x="{xx:.1f}" y="{H - 6}" text-anchor="middle">{e(lab)}</text>')
        if kind == "bars":
            for b in buckets:
                base = y1
                for k, _, c in series:
                    v = data[k].get(b, 0)
                    if v <= 0:
                        continue
                    hgt = max(1.5, (y1 - y0) * min(v, top) / top)
                    g.append(f'<rect class="{c}" x="{X(b) + 1:.1f}" y="{base - hgt:.1f}" width="{max(1, bw - 2):.1f}" height="{hgt:.1f}" rx="1"/>')
                    base -= hgt + 1                   # 1 px gap between stacked parts
        else:
            for k, _, c in series:
                pts, seg = sorted(data[k].items()), []
                prev = None
                for b, v in pts:
                    if prev is not None and b - prev > 2 * step:
                        seg.append(None)              # a gap where there was no data
                    seg.append((X(b) + bw / 2, Y(v)))
                    prev = b
                d, pen = "", "M"
                for pt in seg:
                    if pt is None:
                        pen = "M"
                        continue
                    d += f"{pen}{pt[0]:.1f} {pt[1]:.1f} "
                    pen = "L"
                if d:
                    g.append(f'<path class="cl {c}" d="{d.strip()}"/>')
        # hover hints: one per time segment
        for b in buckets:
            vals = [(t, data[k].get(b)) for k, t, _ in series]
            if all(v is None for _, v in vals):
                continue
            when = datetime.fromtimestamp(b, TZ).strftime("%d.%m %H:%M")
            tip = when + ": " + ", ".join(f"{t} {fmt(v or 0)}{unit}" for t, v in vals)
            g.append(f'<rect class="hit" x="{X(b):.1f}" y="{y0}" width="{bw:.1f}" height="{y1 - y0}"><title>{e(tip)}</title></rect>')
        g.append("</svg>")
        return "".join(g)

    def strip(self, h, key, kind="status", label=""):
        """Availability strip: each time segment green, yellow (partial) or red."""
        return (f'<div class="strip">{self._strip_svg(h, key, kind, label, 640, "wide")}'
                f'{self._strip_svg(h, key, kind, label, 340, "narrow")}<p class="hint">{e(label)}</p></div>')

    def _strip_svg(self, h, key, kind, label, W, wcls):
        x0, x1 = (46 if W < 400 else 52), W - 6
        frm, to, step = h["from"], h["to"], h["step"]
        n = max(1, (to - frm) // step + 1)
        bw = (x1 - x0) / n
        data = dict((b, v) for b, v in h["series"].get(key, []))
        cells = []
        for i in range(n):
            b = frm + i * step
            v = data.get(b)
            if v is None:
                cls = "nd"
            elif kind == "status":
                cls = "up" if v >= .999 else ("dn" if v <= .001 else "pt")
            else:
                cls = "pr" + str(min(4, int(v * 4 + .999))) if v > 0 else "nd"
            when = datetime.fromtimestamp(b, TZ).strftime("%d.%m %H:%M")
            tip = f"{when}: " + (T("немає даних") if v is None else f"{v * 100:.0f}%")
            cells.append(f'<rect class="sc {cls}" x="{x0 + i * bw:.1f}" y="2" width="{max(1, bw - 1):.1f}" height="16" rx="2"><title>{e(tip)}</title></rect>')
        vals = list(data.values())
        pct = f"{sum(vals) / len(vals) * 100:.1f}%" if vals else T("немає даних")
        return (f'<svg viewBox="0 0 {W} 20" class="{wcls}" role="img" aria-label="{e(label)}: {pct}">'
                f'<text class="ax" x="{x0 - 6}" y="14" text-anchor="end">{pct}</text>{"".join(cells)}</svg>')

    def hist(self, *keys):
        try:
            return wgj("history", ",".join(keys), "--range", self.rng())
        except (RuntimeError, ValueError):
            return {"range": self.rng(), "step": 3600, "from": int(time.time()) - 86400, "to": int(time.time()),
                    "series": {k: [] for k in keys}}

    def availability(self, base, name):
        h = self.hist(f"up:{name}", f"ms:{name}")
        return (T("<section id=\"av\"><h2>Доступність і швидкість</h2>{0}<div class=\"panel\">", self.range_tabs(base, "av"))
                + self.strip(h, f"up:{name}", "status", T("частка перевірок, коли ціль відповідала"))
                + self.chart(h, [(f"ms:{name}", T("відповідь"), "c1")], "line", lambda v: f"{v:.0f}", T(" мс"))
                + T("<p class=\"hint\">Час відповіді, мс. Перевірка щохвилини з VPS.</p></div></section>"))

    def visits_block(self, rows, who_col=True):
        if not rows:
            return T("<p class=\"muted\">За 30 днів звернень не було.</p>")
        out = []
        for r in rows:
            who = r["who"]
            if who.startswith("web:"):
                label = T("інтернет, {0}", who[4:])
            elif r.get("who_kind") == "location":
                label = T("{0}, уся мережа", r.get('who_title') or who)
            else:
                label = who
            first = (f'<a href="/c/{who}">{e(label)}</a>' if who_col and r.get("who_kind") == "client"
                     else e(label)) if who_col else f'<a href="/s/{r["site"]}">{e(r["site"])}</a>'
            den = T(", <span class=\"bad-t\">відмов {0}</span>", r["denied"]) if r["denied"] else ""
            out.append(T("<div class=\"ln\"><span class=\"when\">{0}</span><span class=\"muted\">{1} запитів{2}, днів {3}</span><span class=\"muted small\">{4}</span></div>", first, r["n"], den, r["days"], fmt_ts(r["last"])))
        return '<div class="lines">' + "".join(out) + "</div>"

    # -- orbital network map

    def map_model(self, st):
        """A shared model for the map and the mobile list: planets (locations, "other") and devices."""
        topo = st["topology"]
        planets = []
        for l in st["locations"]:
            n = l["name"]
            cls = {"ok": "ok", "warn": "warn", "down": "bad"}[l["state"]]
            sub = (T("зв'язок {0}", ago(l.get('handshake'))) if l["state"] != "down" and l.get("handshake") else
                   T("роутер ще не підключався") if not l.get("handshake") else T("немає зв'язку"))
            planets.append({"t": l.get("title") or n, "s": sub, "cls": cls, "items": topo["locations"].get(n, []),
                            "href": f"/l/{n}"})
        other = topo["vps"] + topo["other"]
        if other:
            bad = any(x["ok"] is False for x in other)
            planets.append({"t": T("Інші сайти"), "s": T("на VPS і поза мережею"), "cls": "bad" if bad else "ok", "items": other,
                            "href": "/sites"})
        return planets, topo["devices"]

    @staticmethod
    def fold_svc(items):
        """For the map: sites separately, and all TCP services of a location as one "services · N" square."""
        svc = [x for x in items if x.get("svc")]
        if len(svc) < 2:
            return items
        oks = [x["ok"] for x in svc]
        agg = {"name": T("сервіси · {0}", len(svc)), "svc": True, "agg": True, "public": False, "ms": None,
               "ok": False if False in oks else (True if all(oks) else None)}
        return [x for x in items if not x.get("svc")] + [agg]

    @staticmethod
    def item_cls(it):
        return "ok" if it["ok"] else ("bad" if it["ok"] is False else "idle")

    @staticmethod
    def item_info(it):
        return ((T("{0} мс", it['ms']) if it["ok"] else T("не відповідає") if it["ok"] is False else "")
                + (T(", публ.") if it.get("public") else "") + (T(", порт {0}", it['port']) if it.get("port") else ""))

    def item_mark(self, it, x, y, r=9):
        """Site: a circle; TCP service: a rounded square."""
        cls = self.item_cls(it)
        if it.get("svc"):
            return f'<rect class="dt {cls}" x="{x - r:.0f}" y="{y - r:.0f}" width="{2 * r}" height="{2 * r}" rx="4"/>'
        return f'<circle class="dt {cls}" cx="{x:.0f}" cy="{y:.0f}" r="{r}"/>'

    def netmap(self, st):
        import math
        planets, devs = self.map_model(st)
        planets = [{**pl, "items": self.fold_svc(pl["items"])} for pl in planets]
        W, H, hx, hy = 1144, 540, 572, 258
        IRX, IRY, ORX, ORY = 270, 150, 450, 222

        def cut(t, n):
            return t if len(t) <= n else t[:n - 1] + "…"

        out = [T("<svg viewBox=\"0 0 {0} {1}\" role=\"img\" aria-label=\"Схема мережі: хаб, локації і пристрої\">", W, H),
               f'<ellipse class="ring" cx="{hx}" cy="{hy}" rx="{IRX}" ry="{IRY}"/>',
               f'<ellipse class="ring outer" cx="{hx}" cy="{hy}" rx="{ORX}" ry="{ORY}"/>']
        # planets on the inner orbit: the first two at the top left and top right, the rest at the bottom
        slots = [202, 338, 90, 250, 290, 140, 40]
        placed = []
        for i, pl in enumerate(planets):
            a = math.radians(slots[i % len(slots)])
            placed.append((pl, hx + IRX * math.cos(a), hy + IRY * math.sin(a)))
        for pl, x, y in placed:
            out.append(f'<line class="spoke {pl["cls"]}" x1="{hx}" y1="{hy}" x2="{x:.0f}" y2="{y:.0f}"/>')
        for pl, x, y in placed:
            items = pl["items"][:6]
            up = y < hy
            k = len(items)

            def spread(lo, hi):
                return [(lo + hi) / 2] if k == 1 else [lo + (hi - lo) * i / (k - 1) for i in range(k)]
            if up:        # a top planet: name above it, satellites fanned out below
                angs, rad = spread(35, 145) if k > 1 else [90], 80
            elif x < hx - 40:
                angs, rad = spread(150, 215), 76
            else:
                angs, rad = spread(-30, 40), 76
            g = []
            for j, (it, ad) in enumerate(zip(items, angs)):
                a = math.radians(ad)
                rr = rad + (30 * (j % 2) if k <= 4 else 26 * (j % 3)) if up else rad   # in tiers: labels do not overlap
                mx, my = x + rr * math.cos(a), y + rr * math.sin(a)
                if up:
                    anc, dx, dy = "middle", 0, 26
                else:
                    anc = "end" if math.cos(a) < 0 else "start"
                    dx, dy = (-15 if anc == "end" else 15), 5
                # above the planet only the name (ms in the hint), at the side also the state
                info = "" if (up and it["ok"] is not False) or it.get("agg") else self.item_info(it)
                g.append(f'<line class="tether" x1="{x:.0f}" y1="{y:.0f}" x2="{mx:.0f}" y2="{my:.0f}"/>'
                         f'<a href="{item_href(it)}"><title>{e(it["name"] + ": " + (self.item_info(it) or T("ще не перевірено")))}</title>{self.item_mark(it, mx, my)}'
                         f'<text class="mn" x="{mx + dx:.0f}" y="{my + dy:.0f}" text-anchor="{anc}">{e(cut(it["name"], 14))}'
                         + (f' <tspan class="mi">{e(info)}</tspan>' if info else "") + "</text></a>")
            if len(pl["items"]) > 6:
                g.append(T("<text class=\"ps\" x=\"{0:.0f}\" y=\"{1:.0f}\" text-anchor=\"middle\">і ще {2} на сторінці «Сайти»</text>", x, y + (150 if up else 98), len(pl["items"]) - 6))
            ty = y - 64 if up else y + 62
            g.append(f'<a href="{pl["href"]}"><title>{e(pl["t"])}</title><circle class="pl {pl["cls"]}" cx="{x:.0f}" cy="{y:.0f}" r="38"/>'
                     f'<circle class="dt {pl["cls"]}" cx="{x:.0f}" cy="{y:.0f}" r="7"/>'
                     f'<text class="pt" x="{x:.0f}" y="{ty:.0f}" text-anchor="middle">{e(pl["t"])}</text>'
                     f'<text class="ps" x="{x:.0f}" y="{ty + 18:.0f}" text-anchor="middle">{e(pl["s"])}</text></a>')
            out.append("".join(g))
        # devices on the outer orbit: two arcs, right and left
        n = len(devs)
        right = devs[:(n + 1) // 2]
        left = devs[(n + 1) // 2:]

        def arc(lo, hi, k):
            if k == 1:
                return [(lo + hi) / 2]
            return [lo + (hi - lo) * i / (k - 1) for i in range(k)]
        angs = arc(-52, 52, len(right)) + arc(128, 232, len(left))
        labels = n <= 24
        for d, ang in zip(right + left, angs):
            a = math.radians(ang)
            x, y = hx + ORX * math.cos(a), hy + ORY * math.sin(a)
            cls = {"ok": "ok", "warn": "warn", "bad": "bad", "off": "off"}.get(d["state"], "idle")
            halo = f'<circle class="dt {cls} halo" cx="{x:.0f}" cy="{y:.0f}" r="17"/>' if cls in ("ok", "warn", "bad") else ""
            r_side = math.cos(a) > 0
            name = cut(d["name"], 18)
            names = ", ".join(cut(it["name"], 12) for it in d["sites"][:3]) + (" …" if len(d["sites"]) > 3 else "")
            sub = T("на пристрої: {0}", names) if d["sites"] else ""
            # label width (roughly): if it would go past the edge of the map at the side, put it under the dot
            need = max(len(name) * 8.6, len(sub) * 6.6) + 30
            if (x + need > W - 6) if r_side else (x - need < 6):
                tx, ty, anc = x, y + 34, "middle"
            else:
                tx, ty, anc = x + (22 if r_side else -22), y + 5, "start" if r_side else "end"
            lab = (f'<text class="dn" x="{tx:.0f}" y="{ty:.0f}" text-anchor="{anc}">{e(name)}</text>'
                   if labels or cls in ("bad", "warn") else "")
            g = [f'<a href="/c/{d["name"]}"><title>{e(d["name"])}</title>{halo}<circle class="dt dv {cls}" cx="{x:.0f}" cy="{y:.0f}" r="9"/>{lab}</a>']
            # sites living on a device: a second line under the name
            if sub and lab:
                bad = any(it["ok"] is False for it in d["sites"])
                g.append(f'<text class="mi{" bad" if bad else ""}" x="{tx:.0f}" y="{ty + 17:.0f}" text-anchor="{anc}">{e(sub)}</text>')
            out.append("".join(g))
        on = sum(d["online"] for d in devs)
        out.append(T("<text class=\"ol\" x=\"{0}\" y=\"{1}\" text-anchor=\"middle\">зовнішня орбіта: пристрої з ключами, {2}, онлайн {3}</text>", hx, hy + ORY + 40, n, on))
        ok = st["wg0"] == "ok" and st["caddy"] == "ok"
        out.append(T("<circle class=\"hubr\" cx=\"{0}\" cy=\"{1}\" r=\"64\"/><circle class=\"hubc\" cx=\"{2}\" cy=\"{3}\" r=\"52\"/><text class=\"ht\" x=\"{4}\" y=\"{5}\" text-anchor=\"middle\">VPS хаб</text><text class=\"hs\" x=\"{6}\" y=\"{7}\" text-anchor=\"middle\">{8}</text>", hx, hy, hx, hy, hx, hy + 2, hx, hy + 20, T("wg0 і Caddy") if ok else T("є збій")))
        out.append("</svg>")
        return "".join(out)

    def netlist(self, st):
        """Phone: the same model as a list, no map."""
        planets, devs = self.map_model(st)
        rows = []
        for pl in planets:
            mm = "".join(f'<a class="mm {self.item_cls(it)}{" svc" if it.get("svc") else ""}" href="{item_href(it)}">{e(it["name"])}</a>' for it in pl["items"])
            rows.append(f'<div class="sy {pl["cls"]}"><span class="dot"></span><div><b><a href="{pl["href"]}">{e(pl["t"])}</a></b><small>{e(pl["s"])}</small>'
                        f'<div class="mms">{mm}</div></div></div>')
        hosted = [(d, it) for d in devs for it in d["sites"]]
        on = sum(d["online"] for d in devs)
        att = sum(d["state"] in ("bad", "warn") for d in devs)
        cls = "warn" if att else ("ok" if on else "off")
        mm = "".join(T("<a class=\"mm {0}{1}\" href=\"{2}\">{3} на {4}</a>", self.item_cls(it), " svc" if it.get("svc") else "", item_href(it), e(it["name"]), e(d["name"])) for d, it in hosted)
        rows.append(T("<div class=\"sy {0}\"><span class=\"dot\"></span><div><b>Пристрої · {1}</b><small>онлайн {2}", cls, len(devs), on) + (T(", увага {0}", att) if att else "") + f'</small><div class="mms">{mm}</div></div></div>')
        return "".join(rows)

    # -- overview
    def page_overview(self, s, flt=""):
        prefetch(("status",), ("list",), ("log", "-n", "8"))
        st = wgj("status")
        clients = wgj("list")
        log = wgj("log", "-n", "8")
        cls, title, issues = self.sys_state(st)
        topo = st["topology"]
        devs = topo["devices"]
        on = sum(d["online"] for d in devs)
        locs = st["locations"]
        locs_ok = sum(1 for l in locs if l["state"] != "down")
        nsites = sum(len(v) for v in topo["locations"].values()) + len(topo["vps"]) + len(topo["other"]) + \
            sum(len(d["sites"]) for d in devs)
        okn = sum(1 for v in topo["locations"].values() for x in v if x["ok"]) + \
            sum(1 for x in topo["vps"] + topo["other"] if x["ok"]) + sum(1 for d in devs for x in d["sites"] if x["ok"])
        if cls == "s-ok":
            lead = ((T("Локацій на зв'язку: {0} з {1}. ", locs_ok, len(locs)) if locs else "") + T("{0} з {1} сайтів і сервісів відповідають, {2} {3} зараз у мережі.", okn, nsites, on, T("пристрій") if on == 1 else T("пристрої") if 1 < on < 5 else T("пристроїв")))
            acts = T("<a class=\"b fill\" href=\"/new\">Видати ключ</a><a class=\"b\" href=\"/sites#add\">Додати сайт</a>")
        else:
            lead = "; ".join(e(x) for x in issues[:4]) + (T(" і ще {0}", len(issues) - 4) if len(issues) > 4 else "") + \
                T(". Решта працює.")
            first = (st["suspects"] or st["expiring"] or [None])[0]
            acts = (T("<a class=\"b fill\" href=\"/c/{0}\">Переглянути {1}</a>", first, e(first)) if first else
                    T("<a class=\"b fill\" href=\"/log\">Відкрити журнал</a>")) + T("<a class=\"b\" href=\"/new\">Видати ключ</a>")
        facts = [(T("{0} з {1}", on, len(devs)), T("пристроїв онлайн")),
                 (T("{0} з {1}", locs_ok, len(locs)) if locs else "0", T("локацій на зв'язку")),
                 (T("{0} з {1}", okn, nsites), T("сайти й сервіси відповідають")),
                 (T("{0} дн", st['cert_days']) if st.get("cert_days") is not None else "-", T("сертифікат дійсний"))]
        hero = self.hero(title, lead, acts, facts, chip=STATE_WORD[cls])
        live = [c for c in clients if c["status"] != "revoked"]
        groups = {"": live, "online": [c for c in live if c["online"]],
                  "attn": [c for c in live if self.client_state(c)[0] in ("bad", "warn")],
                  "off": [c for c in live if c["status"] == "disabled"]}
        flt = flt if flt in groups else ""
        fl = "".join(f'<a class="{"on" if flt == k else ""}" href="/{"?f=" + k if k else ""}">{t} {len(groups[k])}</a>'
                     for k, t in (("", T("Усі")), ("online", T("Онлайн")), ("attn", T("Увага")), ("off", T("Вимкнені"))))
        cards = "".join(self.key_card(c) for c in groups[flt])
        if not flt:
            cards += T("<a class=\"k new\" href=\"/new\">+ Видати ключ</a>")
        body = self.first_steps(locs, nsites, live) + (T("<section class=\"map-wrap\"><h2>Мережа</h2><div class=\"map\">{0}</div></section><section class=\"msys\"><h2>Мережа</h2>{1}</section><section><h2>Ключі <small>{2} видано. Кільце показує, скільки днів лишилось до автовідкликання</small></h2><div class=\"filters\">{3}</div><div class=\"keys\">{4}</div></section><section><h2>Останнє <a href=\"/log\">увесь журнал</a></h2>{5}</section>", self.netmap(st), self.netlist(st), len(live), fl, cards or T("<p class=muted>Нічого не знайдено.</p>"), self.events(log)))
        return self.layout(s, T("Огляд"), hero, body, "home", cls, refresh=True,
                           fab=T("<a class=\"fab\" href=\"/new\">Видати ключ</a>"))

    @staticmethod
    def first_steps(locs, nsites, live):
        """Setup checklist on a fresh hub; disappears once there is a location, a site and a key."""
        steps = [(bool(locs), "/locations", T("Додайте локацію"), T("Роутер у вашій мережі, через який хаб бачить сайти.")),
                 (nsites > 0, "/sites#add", T("Додайте сайт"), T("Сервіс у мережі локації отримає адресу на вашому домені.")),
                 (bool(live), "/new", T("Видайте ключ"), T("Конфіг WireGuard для телефона чи ноутбука з доступом до вибраних сайтів."))]
        if all(done for done, *_ in steps):
            return ""
        items = "".join(f'<a class="step{" done" if done else ""}" href="{href}"><b>{i}</b><span><strong>{e(t)}</strong>'
                        f'<small>{e(d)}</small></span></a>' for i, (done, href, t, d) in enumerate(steps, 1))
