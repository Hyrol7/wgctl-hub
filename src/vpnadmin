                    gname = str(f.get("gname", "")).strip().lstrip("-").strip()[:60] or BRAND
                    self.act(s, ["notify", "create-group", gname], "")
            elif a == "language":
                v = str(f.get("language", ""))
                if v in LANGUAGES and v != LANG and self.act(s, ["config", "--language", v], "✓"):
                    restart_soon()
            elif a == "rotate":
                v = str(f.get("rotate_days", ""))
                if v in {str(d) for d, _ in ROTATE_CHOICES}:
                    self.act(s, ["config", "--rotate-days", v], T("Нагадування збережено"))
            elif a == "notify_test":
                rc, out, err = wg("notify", "test")
                self.flash(s, "ok" if rc == 0 else "bad", (out.strip() or T("Надіслано")) if rc == 0 else err)
            elif a in ("passwd", "backup"):
                if not self.need_code(s, {"code": f.get("code", "")}):
                    self.flash(s, "bad", T("Потрібен правильний код із застосунку"))
                elif a == "passwd":
                    with _auth_lock:
                        auth = load_auth()
                        p1, p2 = str(f.get("new", "")), str(f.get("new2", ""))
                        if not check_pw(auth["pw"], str(f.get("old", ""))):
                            self.flash(s, "bad", T("Поточний пароль невірний"))
                        elif len(p1) < 12 or len(p1) > 1024 or p1 != p2 or p1 == auth["user"]:
                            self.flash(s, "bad", T("Новий пароль: від 12 символів, не логін, обидва поля однакові"))
                        else:
                            auth["pw"], auth["pw_changed"] = make_pw(p1), int(time.time())
                            auth["epoch"] = auth.get("epoch", 1) + 1
                            save_auth(auth)
                            s["epoch"] = auth["epoch"]
                            with _lock:
                                for t in [t for t in SESSIONS if t != tok]:
                                    SESSIONS.pop(t, None)
                            event(T("Змінено пароль панелі"), "critical", "🔑")
                            self.flash(s, "ok", T("Пароль змінено, інші сесії завершено"))
                else:
                    with _auth_lock:
                        auth = load_auth()
                        codes, auth["backup"] = make_backup_codes()
                        save_auth(auth)
                    event(T("Перевидано резервні коди панелі"), "warning", "🔑")
            if not codes:
                raise Redirect("/settings")
        prefetch(("notify", "show"), ("notify", "groups"), ("status",))
        auth = load_auth()
        left = sum(1 for r in auth["backup"] if not r["used"])
        cs = self.csrf(s)
        hero = self.hero(T("Налаштування"), T("Обліковий запис {0}, пароль змінено {1}, резервних кодів {2} з 10.", e(auth['user']), fmt_ts(auth.get('pw_changed')), left), small=True)
