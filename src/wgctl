def new_client(ip, pubkey, psk, **kw):
    c = {"ip": ip, "pubkey": pubkey, "psk": psk, "status": "active", "disabled_reason": "",
         "created": now(), "last_seen": 0, "reactivated": 0, "online": False, "warned": False,
         "endpoint": "", "endpoints": [], "suspect": "", "suspect_at": 0, "note": "",
         "countries": [], "trusted_orgs": [], "notes": "", "phone": "",
         "revoked_at": 0, "expires": None, "autorevoke": True, "admin": False, "sites": [],
         "conf": False, "guest_until": 0, "guest_hours": 0, "guest_warned": False,
         "rotated": 0, "rotate_warned": False}
    c.update(kw)
    return c


def load():
    if not os.path.exists(STATE):
        die(T("Хаб ще не налаштовано. Виконайте: sudo wgctl init"))
    with open(STATE) as f:
        st = json.load(f)
    for c in st["clients"].values():          # new fields in old records
        for k, v in new_client("", "", "").items():
            c.setdefault(k, v)
        if not c.get("rotated"):                 # for old keys: count from the moment of issue
            c["rotated"] = c.get("created") or now()
    # Locations: only real routers with a key. Placeholders from older versions (no key) are dropped.
    st["locations"] = {n: l for n, l in st.get("locations", {}).items() if l.get("pubkey") and l.get("ip")}
    for l in st["locations"].values():
        l.pop("configured", None)
        l.setdefault("sites", [])
        l.setdefault("networks", [])
        l.setdefault("title", "")
    return st


def save(st):
    write_file(STATE, json.dumps(st, ensure_ascii=False, indent=2) + "\n")


