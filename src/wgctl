def now():
    return int(os.environ.get("WGCTL_NOW") or time.time())


def fmt_ts(ts):
    return dt.datetime.fromtimestamp(ts, TZ).strftime("%Y-%m-%d %H:%M") if ts else "-"


def ago(ts):
    if not ts:
        return T("ніколи")
    s = max(0, now() - ts)
    if s < 60:
        return T("{0} с тому", s)
    if s < 3600:
        return T("{0} хв тому", s // 60)
    if s < 86400:
        return T("{0} год тому", s // 3600)
    return T("{0} дн тому", s // 86400)


def human(b):
    b = float(b)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if b < 1024 or unit == "TiB":
            return f"{b:.0f} {unit}" if unit == "B" else f"{b:.1f} {unit}"
        b /= 1024


def die(msg):
    sys.exit(msg)


LOG_MAX = 4 * 1024 * 1024


def log(msg):
    """One record = one line: line breaks in user text cannot forge events."""
    msg = re.sub(r"[\r\n\x00-\x08\x0b-\x1f]+", " ", str(msg))
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_MAX:
            os.replace(LOG, LOG + ".1")          # keep one previous part
        fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        with os.fdopen(fd, "a") as f:
            f.write(f"{fmt_ts(now())} {msg}\n")
    except OSError:
        pass


