def write_stubs():
    os.makedirs(STUB_DIR, exist_ok=True)
    os.chmod(STUB_DIR, 0o755)
    for name, (title, text) in STUBS.items():
        write_file(f"{STUB_DIR}/{name}.html", stub_html(title, text), 0o644)


def stub_lines(page, code, indent):
    t = "\t" * indent
    return [f"{t}rewrite * /{page}.html", f"{t}file_server {{", f"{t}\troot {STUB_DIR}",
            f"{t}\tstatus {code}", f"{t}}}"]


# Headers trusted only from Cloudflare. On the VPN path they are removed, so a key with access
# to a public site cannot hand the backend someone else's "real" client address.
CF_HEADERS = ("Cf-Connecting-Ip", "Cf-Connecting-Ipv6", "Cf-Ipcountry", "True-Client-Ip")


def proxy_lines(site, indent, strip_cf=False):
    t = "\t" * indent
    b = site["backend"]
    sub = [f"{t}\theader_up -{h}" for h in CF_HEADERS] if strip_cf else []
    if site.get("insecure") and b.startswith("https://"):
        sub += [f"{t}\ttransport http {{", f"{t}\t\ttls_insecure_skip_verify", f"{t}\t}}"]
    if site.get("upstream_host"):
        sub.append(f"{t}\theader_up Host {{upstream_hostport}}")
    if not sub:
        return [f"{t}reverse_proxy {b}"]
    return [f"{t}reverse_proxy {b} {{"] + sub + [f"{t}}}"]


def allowed_ips(st, site_name):
    ips = [c["ip"] for c in st["clients"].values()
           if c["status"] == "active" and has_site(c, site_name)]
    ips += [l["ip"] for l in st["locations"].values()
            if has_site(l, site_name)]
    return sorted(set(ips), key=octet)


def panel_ips(st):
    ips = [c["ip"] for c in st["clients"].values() if c["status"] == "active" and c.get("admin")]
    ips += [l["ip"] for l in st["locations"].values()
            if l.get("panel")]
    return sorted(set(ips), key=octet)


def render_caddy(st):
    tls = (["\ttls internal"] if TEST_TLS == "internal" else
           ["\ttls {", "\t\tdns cloudflare {env.CF_API_TOKEN}", "\t\tresolvers 1.1.1.1", "\t}"])
    L = [T("# Згенеровано wgctl. Не редагуйте вручну: зміни зітруться."),
         f"*.{DOMAIN} {{"] + tls
    # A site with a "hide-path" log goes to a separate filtered log (log_name), the rest as usual
    if any(s.get("log") == "hide-path" for s in st["sites"].values()):
        L += ["\tlog_name wgctl"] + caddy_log_lines(1, name="wgctl") + caddy_log_lines(1, "hide-path", name="wgctl_hidden") + [""]
    else:
        L += caddy_log_lines(1) + [""]
    L += ["\thandle_errors 502 503 504 {"] + stub_lines("unavailable", 503, 2) + ["\t}", ""]
    disabled = sorted({c["ip"] for c in st["clients"].values() if c["status"] == "disabled"},
                      key=octet)
    if disabled:
        L += [f"\t@wgctl_disabled remote_ip {' '.join(disabled)}", "\thandle @wgctl_disabled {"]
        L += stub_lines("disabled", 403, 2) + ["\t}", ""]
    panel = st.get("panel", {})
    if panel.get("enabled"):
        ips = panel_ips(st)
        L += [f"\t@wgctl_panel host {PANEL_HOST}", "\thandle @wgctl_panel {"]
        if ips:
            L += [f"\t\t@panel_ok remote_ip {' '.join(ips)}", "\t\thandle @panel_ok {",
                  "\t\t\theader {", "\t\t\t\tStrict-Transport-Security \"max-age=31536000\"",
                  "\t\t\t\tX-Frame-Options DENY", "\t\t\t\tX-Content-Type-Options nosniff",
                  "\t\t\t\tReferrer-Policy same-origin", "\t\t\t}",
                  f"\t\t\treverse_proxy 127.0.0.1:{panel.get('port', 8090)}", "\t\t}"]
        L += ["\t\thandle {", "\t\t\tabort", "\t\t}", "\t}", ""]
    for name in sorted(st["sites"]):
        s = st["sites"][name]
        ips = allowed_ips(st, name)
        m = name.replace("-", "_")          # different prefixes: sites "x" and "x-ok" do not produce the same matchers
        L += [f"\t@site_{m} host {name}.{DOMAIN}", f"\thandle @site_{m} {{"] + site_log_lines(s, m, 2)
        if ips:
            L += [f"\t\t@allow_{m} remote_ip {' '.join(ips)}", f"\t\thandle @allow_{m} {{"]
            L += proxy_lines(s, 3, strip_cf=True) + ["\t\t}"]
        L += ["\t\thandle {"] + stub_lines("noaccess", 403, 3) + ["\t\t}", "\t}", ""]
    L += ["\thandle {"] + stub_lines("notfound", 404, 2) + ["\t}", "}"]
    for name in sorted(n for n, s in st["sites"].items() if s.get("public")):
        L += ["", T("# Публічний сайт: лише через Cloudflare (443 на {0} відкритий тільки для Cloudflare)", PUBLIC_IP),
              f"{name}.{DOMAIN} {{", f"\tbind {PUBLIC_IP}"] + tls + caddy_log_lines(1, st["sites"][name].get("log", "full")) + [""]
        skip = st["sites"][name].get("log_skip") or []
        if skip and st["sites"][name].get("log", "full") != "off":
            L += [f"\t@nolog path {' '.join(skip)}", "\tlog_skip @nolog", ""]       # a separate block: its own log
        L += ["\thandle_errors 502 503 504 {"] + stub_lines("unavailable", 503, 2) + ["\t}"]
        L += proxy_lines(st["sites"][name], 1) + ["}"]
    return "\n".join(L) + "\n"


def caddy_env():
    env = dict(os.environ)
    if os.path.exists(CADDY_ENV):
        with open(CADDY_ENV) as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    env[k] = v
    return env


def caddy_log_owner():
    """`caddy validate` run as root creates the access log owned by root, and then Caddy itself (user caddy)
    cannot open it: config reloads fail with "permission denied". Give Caddy its files back."""
    if os.geteuid() != 0:
        return
    import pwd
    try:
        pw = pwd.getpwnam("caddy")
    except KeyError:
        return
    d = os.path.dirname(ACCESS_LOG)
    os.makedirs(d, mode=0o750, exist_ok=True)
    for path in [d] + [os.path.join(d, f) for f in os.listdir(d)]:
        st_ = os.lstat(path)
        if st_.st_uid == 0 and not os.path.islink(path):
            os.chown(path, pw.pw_uid, pw.pw_gid, follow_symlinks=False)


def apply_caddy(st):
    write_stubs()
    new = render_caddy(st)
    old = open(CADDY_GEN).read() if os.path.exists(CADDY_GEN) else None
    if new == old:
        return
    if old is not None:
        backup(CADDY_GEN)
    write_file(CADDY_GEN, new, 0o644)
    if not caddy_env().get("CF_API_TOKEN") and not TEST_TLS:
        # no Cloudflare token yet: Caddy cannot get certificates, so it is not running; the config waits for it
        print(T("Caddy ще не налаштовано: додайте токен у {0}, потім sudo wgctl render && sudo systemctl restart caddy", CADDY_ENV),
              file=sys.stderr)
        return
    if shutil.which(CADDY_BIN) or os.path.exists(CADDY_BIN):
        r = run([CADDY_BIN, "validate", "--config", CADDYFILE, "--adapter", "caddyfile"],
                check=False, env=caddy_env())
        caddy_log_owner()
        if r.returncode != 0:
            if old is None:
                os.remove(CADDY_GEN)
            else:
                write_file(CADDY_GEN, old, 0o644)
            die(T("Caddy не прийняв конфіг, повернуто попередній:\n") + (r.stderr or r.stdout)[-1500:])
    if not DRY:
        r = run(["systemctl", "reload", "caddy"], check=False)
        if r.returncode != 0:
            die(T("Не вдалося перезавантажити Caddy: ") + r.stderr.strip())


def apply(st, wg=True, caddy=True, force_tcp=False):
    if wg:
        apply_wg(st)
    if caddy:
        apply_caddy(st)
    apply_tcp(st, force_tcp)          # TCP service permissions depend on key state


# ---- output helpers ---------------------------------------------------------
def rotate_days(st):
    return int(st.get("settings", {}).get("rotate_days", ROTATE_DEFAULT))


def hm(sec):
    """3700 -> "1 h 1 min"."""
    sec = max(0, int(sec))
    h, m = sec // 3600, sec % 3600 // 60
    return (T("{0} год ", h) if h else "") + T("{0} хв", m) if h or m else T("менше хвилини")


def client_view(name, c, peers, rdays=ROTATE_DEFAULT):
    p = peers.get(c["pubkey"]) if c["status"] != "revoked" else None
    hs = p["hs"] if p else 0
    last = max(hs, c.get("last_seen", 0))
    online = bool(hs) and now() - hs < ONLINE_SEC
    left = None
    guest = bool(c.get("guest_until"))
    if c["status"] == "active" and c.get("autorevoke", True) and not guest:
        left = INACTIVE_DAYS - (now() - idle_from(c)) // 86400
    age = (now() - c.get("rotated", c["created"])) // 86400
    return {
        "name": name, "ip": c["ip"], "status": c["status"],
        "disabled_reason": c.get("disabled_reason", ""),
        "online": online, "last_seen": last, "endpoint": (p or {}).get("endpoint") or c.get("endpoint", ""),
        "rx": (p or {}).get("rx", 0), "tx": (p or {}).get("tx", 0),
        "created": c["created"], "note": c.get("note", ""), "expires": c.get("expires"),
        "autorevoke": c.get("autorevoke", True), "autorevoke_in_days": left,
        "admin": c.get("admin", False), "sites": c.get("sites", []),
        "conf_file": f"{CONF_DIR}/{name}.conf" if c.get("conf") else None,
        "suspect": c.get("suspect", ""), "suspect_at": c.get("suspect_at", 0),
        "endpoints": c.get("endpoints", [])[-50:], "revoked_at": c.get("revoked_at", 0),
        "geo": (c.get("endpoints") or [{}])[-1], "countries": c.get("countries", []),
        "notes": c.get("notes", ""), "phone": c.get("phone", ""),
        "services": [],
        "guest": guest, "guest_until": c.get("guest_until", 0), "guest_hours": c.get("guest_hours", 0),
        "guest_left": max(0, c.get("guest_until", 0) - now()) if guest else None,
        "rotated": c.get("rotated", c["created"]), "rotate_age": age, "rotate_days": rdays,
        "rotate_due": bool(rdays) and not guest and c["status"] == "active" and age >= rdays,
    }


def table(rows):
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(r)).rstrip())


def sites_str(v):
    return T("усі") if v == "*" else (", ".join(v) if v else "-")


# ---- clients ----------------------------------------------------------------
def parse_sites(st, value):
    if value in (None, ""):
        return None
    if value in ("*", "all", "усі"):
        return "*"
    if value in ("none", "-", "жодного"):
        return []
    names = [x.strip().lower() for x in value.split(",") if x.strip()]
    for n in names:
        get_site(st, n)
    return names


def used_octets(st):
    used = {octet(c["ip"]) for c in st["clients"].values() if c["status"] != "revoked"}
    with open(WG_CONF) as f:
        for m in re.finditer(re.escape(NET) + r"(\d+)/32", base_conf(f.read())):
            used.add(int(m.group(1)))
    return used


def cmd_add(a):
    name = a.name
    if not NAME_RE.match(name):
        die(T("Ім'я: малі латинські літери, цифри і дефіс, до 31 символу"))
    if a.hours is not None:
        if not 1 <= a.hours <= GUEST_MAX_HOURS:
            die(T("Гостьовий доступ: від 1 до {0} год", GUEST_MAX_HOURS))
        if a.admin:
            die(T("Гостьовому ключу не можна давати доступ до панелі"))
    with Lock():
        st = load()
        old = st["clients"].get(name)
        if old and old["status"] != "revoked":
            die(T("Клієнт {0} вже існує ({1})", name, STATUS_UA[old['status']]))
        if name in st["locations"]:
            die(T("{0} зайняте локацією", name))
        used = used_octets(st)
        if a.ip:
            if not IP_MIN <= a.ip <= IP_MAX or a.ip in used:
                die(T("Адреса {0}{1} недоступна (вільні {2}-{3})", NET, a.ip, IP_MIN, IP_MAX))
            n = a.ip
        else:
            free = [i for i in range(IP_MIN, IP_MAX + 1) if i not in used]
            if not free:
                die(T("Вільних адрес немає"))
            n = free[0]
        ip = f"{NET}{n}"
        priv, pub, psk = genkeys()
        sites = parse_sites(st, a.sites)
        phone = clean_phone(a.phone)
        if phone and not PHONE_RE.match(phone):
            die(T("Телефон у міжнародному форматі, напр. +380671234567"))
        guest = {}
        if a.hours:
            guest = dict(guest_until=now() + a.hours * 3600, guest_hours=a.hours, autorevoke=False, expires=None)
        kw = dict(note=clean_note(a.note), expires=parse_date(a.expires), autorevoke=not a.no_autorevoke,
                  admin=a.admin, sites=sites if sites is not None else [], conf=True, phone=phone, rotated=now())
        kw.update(guest)
        st["clients"][name] = new_client(ip, pub, psk, **kw)
        write_file(f"{CONF_DIR}/{name}.conf", client_conf(priv, ip, psk))
        save(st)
        apply(st)
    notify(T("Видано {0}доступ: {1} ({2})", T("гостьовий ") if a.hours else '', name, ip)
           + (T(" на {0} год, до {1}", a.hours, fmt_ts(now() + a.hours * 3600)[11:]) if a.hours else ""), "access", name)
    print(T("Клієнт {0} -> {1} створено. Сайти: {2}", name, ip, sites_str(st['clients'][name]['sites'])))
    print(T("Конфіг: {0}/{1}.conf", CONF_DIR, name))
    if a.qr:
        qr(f"{CONF_DIR}/{name}.conf")
    else:
        print(T("На Mac:  scp vps:{0}/{1}.conf ~/Downloads/", CONF_DIR, name))


def cmd_reissue(a):
    with Lock():
        st = load()
        c = get_client(st, a.name)
        if c["status"] == "revoked":
            die(T("{0} відкликаний; видайте заново: wgctl add {1}", a.name, a.name))
        priv, pub, psk = genkeys()
        c.update(pubkey=pub, psk=psk, conf=True, online=False, suspect="", rotated=now(), rotate_warned=False)
        write_file(f"{CONF_DIR}/{a.name}.conf", client_conf(priv, c["ip"], psk))
        save(st)
        apply(st, caddy=False)
    notify(T("Перевидано конфіг: {0} ({1}); старий більше не працює", a.name, c['ip']), "access", a.name,
           T("{0}: для пристрою «{1}» видано новий конфіг VPN. Старий більше не працює, отримайте новий в адміністратора.", BRAND, a.name))
    print(T("Новий конфіг: {0}/{1}.conf (старий більше не працює)", CONF_DIR, a.name))
    if a.qr:
        qr(f"{CONF_DIR}/{a.name}.conf")


def saved_conf(name):
    st = load()
    c = get_client(st, name)
    path = f"{CONF_DIR}/{name}.conf"
    if c["status"] == "revoked" or not os.path.exists(path):
        die(T("Збереженого конфігу {0} немає. Перевидати: wgctl reissue {1}", name, name))
    return path


def cmd_conf(a):
    with open(saved_conf(a.name)) as f:
        sys.stdout.write(f.read())


def cmd_qr(a):
    out = qr(saved_conf(a.name), svg=a.svg)
    if out:
        sys.stdout.write(out)


def cmd_list(a):
    st = load()
    peers = dump()
    items = sorted(st["clients"].items(), key=lambda x: octet(x[1]["ip"]))
    views = [client_view(n, c, peers, rotate_days(st)) for n, c in items if a.all or c["status"] != "revoked"]
    if a.json:
        print(json.dumps(views, ensure_ascii=False))
        return
    if not views:
        print(T("Клієнтів немає. Додати: wgctl add <ім'я>"))
        return
    rows = [(T("ІМ'Я"), "IP", T("СТАТУС"), T("ЗВ'ЯЗОК"), T("ОСТАННЄ ПІДКЛ."), T("ЗВІДКИ"), T("ТРАФІК"), T("САЙТИ"), T("УВАГА"), T("ПРИМІТКА"))]
    for v in views:
        status = STATUS_UA[v["status"]] + (T(" (адмін)") if v["admin"] else "")
        link = "-" if v["status"] == "revoked" else (T("онлайн") if v["online"] else T("офлайн"))
        traffic = f"{human(v['rx'])}/{human(v['tx'])}" if v["rx"] or v["tx"] else "-"
        warn = (T("підозра") if v["suspect"] else T("гість {0}", hm(v['guest_left'])) if v["guest"] else
                T("< 7 дн") if v["autorevoke_in_days"] is not None and v["autorevoke_in_days"] <= WARN_DAYS else
                T("змінити ключ") if v["rotate_due"] else "")
        g = v["geo"]
        where = " ".join(x for x in (g.get("cc", ""), g.get("city", "")) if x) or (g.get("ip") or "-")
        rows.append((v["name"], v["ip"], status, link, ago(v["last_seen"]), where, traffic,
                     sites_str(v["sites"]), warn, v["note"]))
    table(rows)


def cmd_show(a):
    st = load()
    v = client_view(a.name, get_client(st, a.name), dump(), rotate_days(st))
    v["services"] = [{"name": n, "port": sv["port"], "target": f"{sv['target']}:{sv['target_port']}"}
                     for n, sv in sorted(st.get("services", {}).items()) if a.name in sv.get("allow", [])]
    if a.json:
        print(json.dumps(v, ensure_ascii=False))
        return
    reason = f" ({REASON_UA.get(v['disabled_reason'], v['disabled_reason'])})" if v["disabled_reason"] else ""
    print(T("Ім'я:             {0}{1}", v['name'], T("  [адмін]") if v['admin'] else ''))
    print(T("Адреса:           {0}", v['ip']))
    print(T("Статус:           {0}{1}", STATUS_UA[v['status']], reason))
    print(T("Зв'язок:          {0}", T("онлайн") if v['online'] else T("офлайн")))
    print(T("Останнє підкл.:   {0} ({1})", fmt_ts(v['last_seen']), ago(v['last_seen'])))
    print(T("Звідки:           {0}", v['endpoint'] or '-'))
    print(T("Трафік (з/до):    {0} / {1}", human(v['rx']), human(v['tx'])))
    print(T("Сайти:            {0}", sites_str(v['sites'])))
    print(T("Створено:         {0}", fmt_ts(v['created'])))
    print(T("Термін дії:       {0}", v['expires'] or T("без обмеження")))
    if v["status"] == "active":
        print(T("Автовідкликання:  ") + (T("через {0} дн без підключень", v['autorevoke_in_days'])
                                       if v["autorevoke"] else T("вимкнено")))
    if v["guest"]:
        print(T("Гостьовий доступ: до {0} (ще {1}), потім відкличеться", fmt_ts(v['guest_until']), hm(v['guest_left'])))
    print(T("Ключ змінено:     {0} ({1} дн тому)", fmt_ts(v['rotated']), v['rotate_age'])
          + (T("  ЧАС ЗМІНИТИ: wgctl reissue ") + v["name"] if v["rotate_due"] else ""))
    print(T("Конфіг:           {0}", v['conf_file'] or T("не збережено (wgctl reissue)")))
    if v["suspect"]:
        print(T("Підозра:          {0} ({1})", v['suspect'], fmt_ts(v['suspect_at'])))
    if v["revoked_at"]:
        print(T("Відкликано:       {0}", fmt_ts(v['revoked_at'])))
    print(T("Примітка:         {0}", v['note'] or '-'))
    print(T("Телефон:          {0}", v['phone'] or '-'))
    if v["notes"]:
        print(T("Нотатки:          ") + v["notes"].replace("\n", "\n                  "))
    if v["geo"]:
        g = v["geo"]
        marks = (T(" [хостинг/VPN]") if g.get("hosting") else "") + (" [Tor]" if g.get("tor") else "")
        print(T("Місцезнаходження: {0}{1}", place(g), marks))
        print(T("Довірені країни:  {0}", ', '.join(v['countries']) or '-'))
    if v["endpoints"]:
        print(T("Історія адрес:"))
        for e in reversed(v["endpoints"][-8:]):
            print(f"  {fmt_ts(e['ts'])}  {e['ip']:<16} {place(e)}")


def change_status(name, status, reason, why, cat="access", user=None, icon=None):
    with Lock():
        st = load()
        c = get_client(st, name)
        if c["status"] == "revoked":
            die(T("{0} уже відкликаний; видати заново: wgctl add {1}", name, name))
        if c["status"] == status:
            die(T("{0} уже {1}", name, STATUS_UA[status]))
        c["status"], c["disabled_reason"] = status, reason
        if status == "active":
            c.update(warned=False, reactivated=now(), suspect="")
        if status == "revoked":
            c.update(revoked_at=now(), psk="", online=False, conf=False)
            shred(f"{CONF_DIR}/{name}.conf")
            for sv in st.get("services", {}).values():
                if name in sv.get("allow", []):
                    sv["allow"].remove(name)
        save(st)
        apply(st)
