def set_config_value(section, key, value):
    """Change one `key = "value"` line in config.toml, keeping comments and the rest of the file."""
    with open(CONFIG_FILE) as f:
        text = f.read()
    line = f'{key} = "{value}"'
    sec = re.search(rf"(?m)^\[{re.escape(section)}\]\s*$", text)
    if not sec:
        text = text.rstrip("\n") + f"\n\n[{section}]\n{line}\n"
    else:
        nxt = re.search(r"(?m)^\[", text[sec.end():])
        end = sec.end() + (nxt.start() if nxt else len(text) - sec.end())
        body = text[sec.end():end]
        if re.search(rf"(?m)^{key}\s*=", body):
            body = re.sub(rf"(?m)^{key}\s*=.*$", line, body, count=1)
        else:
            body = "\n" + line + body
        text = text[:sec.end()] + body + text[end:]
    write_file(CONFIG_FILE, text, 0o644)


