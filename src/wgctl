            "uci set network.wghub.proto='wireguard'\n"
            f"uci set network.wghub.private_key='{priv}'\n"
            f"uci add_list network.wghub.addresses='{ip}/24'\n"
            "uci add network wireguard_wghub\n"
            f"uci set network.@wireguard_wghub[-1].public_key='{server_pubkey()}'\n"
