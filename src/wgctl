def cf_api(method, path, body=None):
    if os.environ.get("WGCTL_CF_FAKE"):
        log(f"CF-FAKE {method} {path} {json.dumps(body, ensure_ascii=False) if body else ''}")
        return {"success": True, "result": [] if method == "GET" else {"id": "fake-" + str(now())}}
    token = caddy_env().get("CF_API_TOKEN")
    if not token:
        die(T("Немає токена Cloudflare у {0}", CADDY_ENV))
    req = urllib.request.Request(CF_API + path, method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read()).get("errors", [])
            msg = "; ".join(f"{x.get('code')}: {x.get('message')}" for x in err)
        except Exception:
            msg = str(e)
        die(T("Cloudflare відповів помилкою: {0}", msg))
    except Exception as e:
        die(T("Немає зв'язку з Cloudflare: {0}", e))


def cf_zone(st):
    z = st.get("cloudflare", {}).get("zone")
    if not z:
        die(T("Не задано зону Cloudflare: wgctl cloudflare --zone <Zone ID> (Cloudflare -> домен -> Overview -> API)"))
    return z


def cf_publish(st, name):
    """Proxied A record name.domain -> public IP of the VPS. Returns the record id."""
    zone, fqdn = cf_zone(st), f"{name}.{DOMAIN}"
    rec = {"type": "A", "name": fqdn, "content": PUBLIC_IP, "proxied": True, "ttl": 1,
           "comment": T("wgctl: публічний сайт")}
    found = cf_api("GET", f"/zones/{zone}/dns_records?type=A&name={fqdn}")["result"]
    if found:
        return cf_api("PATCH", f"/zones/{zone}/dns_records/{found[0]['id']}", rec)["result"]["id"]
    return cf_api("POST", f"/zones/{zone}/dns_records", rec)["result"]["id"]


def cf_unpublish(st, name, rec_id):
    zone = cf_zone(st)
    if rec_id and not rec_id.startswith("fake"):
        cf_api("DELETE", f"/zones/{zone}/dns_records/{rec_id}")
    else:
        for r in cf_api("GET", f"/zones/{zone}/dns_records?type=A&name={name}.{DOMAIN}")["result"]:
            cf_api("DELETE", f"/zones/{zone}/dns_records/{r['id']}")


