def cmd_report(a):
    st = load()
    peers = dump()
    t = now()
    lines = [T("📊 {0} · звіт за {1}", BRAND, dt.datetime.fromtimestamp(t, TZ).strftime('%d.%m.%Y'))]
    exp = cert_expiry()
    days = (exp - t) // 86400 if exp else None
    loc = []
    for n, l in st["locations"].items():
        v = location_view(n, l, peers)
        loc.append((l.get("title") or n) + (" ✅" if v['state'] == 'ok' else " ❌"))
    lines.append(T("🖥 Система: ") + ", ".join(["WireGuard ✅", "Caddy " + ("✅" if service_active("caddy") else "❌")] + loc))
    if days is not None:
        lines.append(T("🔐 Сертифікат: ще {0} дн", days) + (" ⚠️" if days <= 14 else ""))
    cl = st["clients"]
    active = [n for n, c in cl.items() if c["status"] == "active"]
    disabled = [n for n, c in cl.items() if c["status"] == "disabled"]
    seen = sorted(n for n, c in cl.items() if c["status"] != "revoked" and t - c.get("last_seen", 0) < 86400)
    lines.append(T("👥 Ключі: активних {0}, вимкнених {1}", len(active), len(disabled)))
    lines.append(T("📶 За добу підключались: ") + (", ".join(seen) if seen else T("ніхто")))
    attn = [T("{0} (підозра)", n) for n, c in cl.items() if c.get("suspect") and c["status"] != "revoked"]
    attn += [T("{0} (відкликання через {1} дн)", n, INACTIVE_DAYS - (t - idle_from(c)) // 86400) for n, c in cl.items()
             if c["status"] == "active" and c.get("autorevoke", True) and not c.get("guest_until")
             and INACTIVE_DAYS - (t - idle_from(c)) // 86400 <= WARN_DAYS]
    attn += [T("{0} (термін до {1})", n, c['expires']) for n, c in cl.items() if c["status"] == "active" and c.get("expires")
             and (dt.date.fromisoformat(c["expires"]) - dt.datetime.now(TZ).date()).days <= EXPIRY_WARN_DAYS]
    attn += [T("{0} (час змінити ключ)", n) for n, c in cl.items() if c["status"] == "active" and not c.get("guest_until")
             and rotate_days(st) and (t - c.get("rotated", c["created"])) // 86400 >= rotate_days(st)]
    guests = [T("{0} до {1}", n, fmt_ts(c['guest_until'])[11:]) for n, c in cl.items() if c["status"] != "revoked" and c.get("guest_until")]
    if guests:
        lines.append(T("🎟 Гості: ") + ", ".join(guests))
    lines.append((T("⚠️ Потребують уваги: ") + ", ".join(attn)) if attn else T("👌 Нічого не потребує уваги"))
    bad = [n for n, s in st["sites"].items() if s.get("health") and not s["health"].get("ok")]
    pub = [n for n, s in st["sites"].items() if s.get("public")]
    lines.append(T("🌐 Сайти: {0}", len(st['sites'])) + (T(", не відповідають: {0} ❌", ', '.join(bad)) if bad else T(", усі відповідають ✅"))
                 + (T("; публічні: {0}", ', '.join(pub)) if pub else ""))
    cnt = {}
    since = dt.datetime.fromtimestamp(t - 86400, TZ).strftime("%Y-%m-%d %H:%M")
    for path in (LOG + ".1", LOG):
        if not os.path.exists(path):
            continue
        for l in open(path, errors="replace"):
            m = re.match(r"^(\S+ \S+) EVENT(?::(\w+))? ", l)
            if m and m.group(1) >= since:
                c = m.group(2) or "info"
                cnt[c] = cnt.get(c, 0) + 1
    b = backup_status()
    if b["configured"]:
        lines.append(T("💾 Резервна копія: {0}", fmt_ts(b['last_ok']) if b['last_ok'] else T("ще не було"))
                     + (T(", помилка: {0} ❌", b['last_error']) if b["last_error"] else " ✅"))
    rel = read_json(SERVER_CACHE, {}).get("rel")
    if rel:
        lines.append(T("⬆️ Доступна версія {0}: sudo wgctl-update", rel))
    lines.append(T("🧾 Події за добу: ") + (", ".join(f"{CAT_UA.get(k, k)} {v}" for k, v in sorted(cnt.items()))
                                      if cnt else T("немає")))
    text = "\n".join(lines)
    if a.print or not notify_cfg().get("report", True):
        print(text)
        return
    cfg = notify_cfg()
    targets = admin_targets(cfg)
    if not targets:
        die(T("Немає ні групи, ні номерів адміністраторів: wgctl notify set --admins +380..."))
    enqueue([{**t, "kind": "report", "text": text} for t in targets])
    log(T("EVENT:info Сформовано щоденний звіт"))
    print(T("Звіт у черзі, надіслано: {0}", flush_outbox()))


