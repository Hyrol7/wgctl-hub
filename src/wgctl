def detect_public_ip():
    r = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False)
    m = re.search(r"\bsrc (\d+\.\d+\.\d+\.\d+)", r.stdout)
    return m.group(1) if m else ""


def detect_timezone():
    try:
        return os.path.realpath("/etc/localtime").split("/zoneinfo/", 1)[1]
    except (IndexError, OSError):
        return "UTC"


def ask(prompt, default="", check=None):
    while True:
        v = input(f"{prompt}" + (f" [{default}]" if default else "") + ": ").strip() or default
        if not check or check(v):
            return v
        print(T("  Невірне значення, спробуйте ще раз"))


def cmd_init(a):
    """Creates config.toml, WireGuard keys, an empty state and the main Caddyfile. Overwrites nothing without --force."""
    if os.path.exists(CONFIG_FILE) and not a.force:
        die(T("{0} уже є. Перезаписати: wgctl init --force", CONFIG_FILE))
    inter = not a.yes
    if inter:
        need_tty(T("Перше налаштування"))
    v = {"domain": a.domain, "public_ip": a.public_ip or detect_public_ip(), "listen_port": a.port,
         "subnet": a.subnet, "timezone": a.timezone or detect_timezone(), "language": a.language,
         "brand": a.brand, "clients_from": 10, "clients_to": 250}
    if inter:
        v["domain"] = ask(T("Домен для сайтів і панелі (напр. example.com)"), v["domain"] or "",
                          lambda x: re.fullmatch(r"[a-z0-9-]+(\.[a-z0-9-]+)+", x or ""))
        v["public_ip"] = ask(T("Публічна IP-адреса VPS"), v["public_ip"], lambda x: bool(re.fullmatch(r"[\d.]+", x)))
        v["listen_port"] = int(ask(T("Порт WireGuard (UDP)"), str(v["listen_port"]), str.isdigit))
        v["subnet"] = ask(T("Внутрішня мережа VPN (/24)"), v["subnet"], lambda x: x.endswith("/24"))
        v["timezone"] = ask(T("Часовий пояс"), v["timezone"])
        v["language"] = ask(T("Мова ({0})", "/".join(LANGUAGES)), v["language"], lambda x: x in LANGUAGES)
        v["brand"] = ask(T("Назва в панелі"), v["brand"])
    if not v["domain"] or not v["public_ip"]:
        die(T("Потрібні --domain і --public-ip"))
    try:
        ZoneInfo(v["timezone"])
    except Exception:
        die(T("Невідомий часовий пояс {0}", v['timezone']))
    try:
        net = ipaddress.ip_network(v["subnet"])
    except ValueError:
        die(T("wgctl: network.subnet має бути IPv4 /24, напр. 10.77.0.0/24"))
    if net.prefixlen != 24 or net.version != 4 or not net.is_private:
        die(T("Мережа має бути /24"))
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+", v["domain"] or ""):
        die(T("Домен для сайтів і панелі (напр. example.com)"))
    if any(c in (v["brand"] or "") for c in '"\\\n\r<>'):
        die(T("Назва в панелі") + ": \" \\ < >")
    v["endpoint_host"] = v["public_ip"]
    global TZ
    TZ = ZoneInfo(v["timezone"])
    write_file(CONFIG_FILE, CONFIG_TEMPLATE.format(**v), 0o644)
    hub = str(net.network_address).rsplit(".", 1)[0] + ".1"
    if not os.path.exists(WG_CONF):
        priv = run(["wg", "genkey"]).stdout.strip()
        write_file(WG_CONF, f"[Interface]\nAddress = {hub}/24\nListenPort = {v['listen_port']}\nPrivateKey = {priv}\n")
        print(T("Створено {0} з новим ключем сервера", WG_CONF))
    if not os.path.exists(STATE):
        os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
        save({"version": 3, "clients": {}, "locations": {}, "sites": {}, "services": {},
              "panel": {"enabled": False, "port": 8090}})
    if not os.path.exists(CADDYFILE) or a.force or "import" not in open(CADDYFILE).read():
        if os.path.exists(CADDYFILE):
            backup(CADDYFILE)
        write_file(CADDYFILE, "{\n\tdefault_bind " + hub + T("\n}}\n\n# Сайти, права і заглушки генерує wgctl\nimport {0}\n", CADDY_GEN), 0o644)
    log(T("EVENT:security Перше налаштування: {0}, {1}:{2}, {3}", v['domain'], v['public_ip'], v['listen_port'], v['subnet']))
    print(T("Налаштування записано в {0}.", CONFIG_FILE))
    print(T("Далі: токен Cloudflare у /etc/caddy/cloudflare.env (CF_API_TOKEN=...), потім sudo wgctl render"))


