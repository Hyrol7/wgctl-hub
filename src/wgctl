def build_archive(out_path):
    """tar.gz straight into age: there is never an unencrypted archive on disk. Returns (file count, fingerprint)."""
    with open(BACKUP_PUB) as f:
        recipient = f.read().strip()
    fp = hashlib.sha256()
    files = backup_files()
    manifest = {"version": VERSION, "host": os.uname().nodename, "created": now(),
                "files": [arc for _, arc in files] + ["/var/lib/wgctl/history.db"]}
    tmp = out_path + ".part"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with open(fd, "wb") as out:
        proc = subprocess.Popen([age_bin(), "-r", recipient], stdin=subprocess.PIPE, stdout=out, stderr=subprocess.PIPE)
        try:
            with tarfile.open(fileobj=proc.stdin, mode="w|gz") as tar:
                def add_bytes(name, data, mode=0o600, mtime=None, owner=("root", "root")):
                    ti = tarfile.TarInfo(name.lstrip("/"))
                    ti.size, ti.mode, ti.mtime = len(data), mode, mtime or now()
                    ti.uname, ti.gname = owner
                    tar.addfile(ti, io.BytesIO(data))
                add_bytes("MANIFEST.json", json.dumps(manifest, ensure_ascii=False, indent=1).encode())
                for full, arc in files:
                    try:                                  # O_NOFOLLOW: the file cannot be swapped for a link between the check and the read
                        fd = os.open(full, os.O_RDONLY | os.O_NOFOLLOW)
                    except OSError:
                        continue
                    with os.fdopen(fd, "rb") as f:
                        stt = os.fstat(f.fileno())
                        data = f.read()
                    add_bytes(arc, data, stt.st_mode & 0o7777, int(stt.st_mtime), owner_names(stt))
                    if not VOLATILE.search(arc):
                        fp.update(arc.encode() + b"\0" + hashlib.sha256(norm_for_fingerprint(arc, data)).digest())
                h = hist_bytes()
                if h:
                    add_bytes("/var/lib/wgctl/history.db", h)
        finally:
            proc.stdin.close()
            err = proc.stderr.read().decode(errors="replace")
            rc = proc.wait()
    if rc != 0:
        os.remove(tmp)
        raise RuntimeError(f"age: {err.strip()}")
    os.replace(tmp, out_path)
    return len(files) + 1, fp.hexdigest()


def cmd_backup_run(a):
    if not os.path.exists(BACKUP_PUB):
        die(T("Спершу створіть ключ шифрування: sudo wgctl backup init"))
    if not age_bin():
        die(T("Потрібна програма age: sudo apt install age"))
    os.makedirs(BACKUP_OUT, mode=0o700, exist_ok=True)
    stamp = dt.datetime.now(TZ).strftime("%Y%m%d-%H%M%S")
    path = f"{BACKUP_OUT}/wgctl-{stamp}.tar.gz.age"
    bs = read_json(BACKUP_STATE, {})
    try:
        n, fp = build_archive(path)
    except Exception as ex:
        bs["last_error"] = str(ex)[:300]
        write_file(BACKUP_STATE, json.dumps(bs) + "\n", 0o644)
        notify(T("Резервна копія не створилась: {0}", bs['last_error']), "health", level="critical", icon="💾", link="/server")
        flush_outbox()
        die(T("Помилка: {0}", ex))
    for f in backup_status()["files"][BACKUP_KEEP:]:
        os.remove(f"{BACKUP_OUT}/{f['name']}")
    size = os.path.getsize(path)
    changed = fp != bs.get("fingerprint")
    bs.update(last_ok=now(), last_error="", last_size=size, last_file=os.path.basename(path))
    if changed:
        bs["fingerprint"], bs["last_changed"] = fp, now()
    send = a.signal or changed and bs.get("signal_fp") != fp or now() - bs.get("last_signal", 0) > BACKUP_SIGNAL_DAYS * 86400
    sent_to = []
    if send and not a.no_signal:
        sent_to = backup_to_signal(path, changed)
        if sent_to:
            bs["last_signal"], bs["signal_fp"] = now(), fp
    write_file(BACKUP_STATE, json.dumps(bs) + "\n", 0o644)
    log(T("EVENT:info Резервна копія {0}: файлів {1}, {2}", os.path.basename(path), n, human(size))
        + (T(", конфігурація змінилась") if changed else "") + (T(", у Signal: {0}", ', '.join(sent_to)) if sent_to else ""))
    print(T("Копія {0}: файлів {1}, {2}", path, n, human(size)) + (T(", у черзі в Signal") if sent_to else ""))
    flush_outbox()


def backup_to_signal(path, changed):
    """A copy of the archive for signal-cli and one message to each admin privately (not to the group)."""
    cfg = notify_cfg()
    admins = cfg.get("admins", [])
    if not admins or not cfg.get("sender"):        # the sender number is not registered yet: the backup stays on the VPS only
        return []
    # The directory belongs to user signal: do not trust what is in it (links could make root
    # write or chown someone else's file), so links are never followed.
    if os.path.islink(SIGNAL_OUT) or (os.path.lexists(SIGNAL_OUT) and not os.path.isdir(SIGNAL_OUT)):
        os.remove(SIGNAL_OUT)
    os.makedirs(SIGNAL_OUT, mode=0o700, exist_ok=True)
    uid = gid = None
    if os.geteuid() == 0 and not DRY:
        import pwd
        try:
            pw = pwd.getpwnam(SIGNAL_USER)
            uid, gid = pw.pw_uid, pw.pw_gid
            os.chown(SIGNAL_OUT, uid, gid, follow_symlinks=False)
        except KeyError:
            pass
    dst = f"{SIGNAL_OUT}/{os.path.basename(path)}"
    if os.path.lexists(dst):
        os.remove(dst)
    fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as out, open(path, "rb") as src:
        shutil.copyfileobj(src, out)
        if uid is not None:
            os.fchown(out.fileno(), uid, gid)
    text = (T("Резервна копія {0} {1}, {2}. ", DOMAIN, fmt_ts(now()), human(os.path.getsize(path)))
            + (T("Конфігурація змінилась. ") if changed else T("Щотижнева копія. "))
            + T("Зашифровано: відкрити можна лише вашим ключем age. Відновлення: wgctl backup restore"))
    enqueue([{"to": x, "group": False, "kind": "backup", "text": text, "attach": dst} for x in admins], replace_kind="backup")
    return admins


def ask_identity():
    """age key from hidden input into a file on tmpfs (0600) that is removed after use."""
    import getpass
    secret = os.environ.get("WGCTL_AGE_KEY") or getpass.getpass(T("Ключ розшифрування (AGE-SECRET-KEY-...): ")).strip()
    if not secret.startswith("AGE-SECRET-KEY-"):
        die(T("Це не схоже на ключ age"))
    d = "/dev/shm" if os.path.isdir("/dev/shm") else None
    fd, path = tempfile.mkstemp(dir=d, prefix="wgctl-id-")
    with os.fdopen(fd, "w") as f:
        f.write(secret + "\n")
    return path


def open_archive(path, identity):
    """Decrypts into memory and returns {name: (TarInfo, bytes)}."""
    r = subprocess.run([age_bin(), "-d", "-i", identity, path], capture_output=True)
    if r.returncode != 0:
        die(T("Не вдалося розшифрувати: ") + r.stderr.decode(errors="replace").strip()
            + T("\nПеревірте, що це ключ саме від цих копій."))
    out = {}
    with tarfile.open(fileobj=io.BytesIO(r.stdout), mode="r:gz") as tar:
        for ti in tar.getmembers():
            if not ti.isfile() or ti.name.startswith("/") or ".." in ti.name.split("/"):
                continue                                   # only regular files with safe paths
            out[ti.name] = (ti, tar.extractfile(ti).read())
    return out


def pick_backup(name):
    if name:
        return name if os.path.sep in name else f"{BACKUP_OUT}/{name}"
    files = backup_status()["files"]
    if not files:
        die(T("Копій ще немає: sudo wgctl backup run"))
    return f"{BACKUP_OUT}/{files[0]['name']}"


def cmd_backup_status(a):
