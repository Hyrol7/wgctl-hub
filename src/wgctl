def mikrotik_snippet(priv, ip, psk):
    host, port = ENDPOINT.rsplit(":", 1)
    return (f'/interface wireguard add name=wg-hub listen-port=13231 private-key="{priv}" comment="{BRAND}"\n'
            f'/interface wireguard peers add interface=wg-hub public-key="{server_pubkey()}" preshared-key="{psk}" '
            f'endpoint-address={host} endpoint-port={port} allowed-address={HUB_IP}/32 persistent-keepalive=25s\n'
            f"/ip address add address={ip}/24 interface=wg-hub\n")


def openwrt_snippet(priv, ip, psk):
