class OLock(Lock):
    def __enter__(self):
        os.makedirs(os.path.dirname(OUTBOX_LOCK), exist_ok=True)
        self.f = open(OUTBOX_LOCK, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self


def notify_cfg():
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        return {}
    n = {"admins": [], "group": "", "group_name": "", "group_managed": False, "sender": "", "connect": False, "report": True, "users": True,
         **st.get("notify", {})}
    return n


def admin_targets(cfg, level="info"):
    """Where an event goes: everything to the group; critical events also to admins privately.
    Until there is a group, everything goes to admins privately."""
    admins = [{"to": a, "group": False} for a in cfg.get("admins", [])]
    if not cfg.get("group"):
        return admins
    return [{"to": cfg["group"], "group": True}] + (admins if level == "critical" else [])


def parse_phones(v):
    if v in (None,):
        return None
    out = []
    for x in v.replace(" ", "").split(","):
        if not x or x == "none":
            continue
        if not PHONE_RE.match(x):
            die(T("Телефон {0}: потрібен міжнародний формат, напр. +380671234567", x))
        if x not in out:
            out.append(x)
    return out


def load_outbox():
    try:
        with open(OUTBOX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"queue": [], "last_sent": 0, "last_error": "", "last_receive": 0, "sent_total": 0}


def save_outbox(ob):
    write_file(OUTBOX, json.dumps(ob, ensure_ascii=False, indent=1) + "\n")


def drop_attach(q):
    if q.get("attach") and os.path.exists(q["attach"]):
        os.remove(q["attach"])


def enqueue(items, replace_kind=None):
    t = now()
    with OLock():
        ob = load_outbox()
        if replace_kind:                       # e.g. a backup: only the newest one stays in the queue
            keep = []
            for q in ob["queue"]:
                if q.get("kind") == replace_kind:
                    drop_attach(q)
                else:
                    keep.append(q)
            ob["queue"] = keep
        ob["recent"] = [r for r in ob.get("recent", []) if t - r[0] < 600]
        for it in items:
            key = hashlib.sha256(f"{it['to']}|{it['text']}".encode()).hexdigest()[:16]
            if any(r[1] == key for r in ob["recent"]):
                continue                                  # the same text to the same recipient within 10 minutes
            ob["recent"].append([t, key])
            ob["queue"].append({**it, "ts": t, "tries": 0, "err": ""})
        del ob["queue"][:-500]
        save_outbox(ob)


def signal_bin():
    return shutil.which("signal-cli") or ("/usr/local/bin/signal-cli" if os.path.exists("/usr/local/bin/signal-cli") else None)


def signal_run(args, timeout=60, raw=False):
    """Runs signal-cli as user signal. Returns (rc, output); raw=True: full stdout."""
    if SIGNAL_FAKE:
        if os.environ.get("WGCTL_SIGNAL_FAIL"):
            return 1, "fake failure"
        with open(SIGNAL_FAKE, "a") as f:
            f.write(json.dumps(args, ensure_ascii=False) + "\n")
        if "listGroups" in args:
            return 0, os.environ.get("WGCTL_SIGNAL_GROUPS", "[]")
        if "updateGroup" in args:
            return 0, 'Created new group: "FAKEGROUPID0000000000000000000000000000000="'
        return 0, ""
    b = signal_bin()
    if not b:
        return 127, T("signal-cli не встановлено")
    cmd = [b, "--config", SIGNAL_DIR] + args
    if os.geteuid() == 0:
        cmd = ["runuser", "-u", SIGNAL_USER, "--"] + cmd
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return 124, T("signal-cli: тайм-аут")
    if raw and r.returncode == 0:
        return 0, r.stdout
    return r.returncode, (r.stderr or r.stdout).strip()[-500:]


def utf16_len(text):
    return len(text.encode("utf-16-le")) // 2


def format_batch(batch):
    """A message for one recipient: a header (bold), events with icons and panel links;
    the report and messages to users as separate paragraphs. Returns (text, header length in UTF-16)."""
    adm = [q for q in batch if q["kind"] == "admin"]
    other = [q["text"] for q in batch if q["kind"] != "admin"]
    levels = {q.get("level") for q in adm}
    head = ""
    lines = []
    if adm:
        top = "🚨" if "critical" in levels else "⚠️" if "warning" in levels else "🛡"
        crit = T("Потрібна увага") if "critical" in levels else ""
        head = f"{top} {BRAND}" + (f" · {crit}" if crit else "")
        for q in adm:
            icon = q.get("icon") or "•"
            lines.append(f"{icon} {fmt_ts(q['ts'])[11:]}  {q['text']}")          # event time right after the icon
            if q.get("url"):
                lines.append(f"    ↳ {q['url']}")
    parts = ([head + "\n" + "\n".join(lines)] if adm else []) + other
    if not adm and other:                          # report: its first line in bold
        head = other[0].split("\n", 1)[0]
    return "\n\n".join(parts), utf16_len(head)


def flush_outbox(force=False):
    """Sends the queue. Does nothing without a configured number (messages wait up to 24 hours)."""
    cfg = notify_cfg()
    t = now()
    with OLock():
        ob = load_outbox()
        old = [q for q in ob["queue"] if t - q["ts"] > 86400]
        if old:
            for q in old:
                drop_attach(q)
            ob["queue"] = [q for q in ob["queue"] if t - q["ts"] <= 86400]
            log(T("signal: {0} повідомлень старші за 24 год, не надіслано", len(old)))
        sender = cfg.get("sender")
        if not sender or not (SIGNAL_FAKE or signal_bin()):
            save_outbox(ob)
            return 0
        if force or t - ob.get("last_receive", 0) > 1800:      # Signal requires receiving regularly
            rc, out = signal_run(["-a", sender, "receive", "--timeout", "5"], timeout=90)
            ob["last_receive"] = t
            if rc != 0:
                ob["last_error"] = f"receive: {out}"
        sent, keep = 0, []
        by_to = {}
        for q in ob["queue"]:
            if q.get("attach"):                      # a file: as a separate message
                if not os.path.exists(q["attach"]):
                    continue
                rc, out = signal_run(["-a", sender, "send", "-m", q["text"], "-a", q["attach"], q["to"]], timeout=180)
                if rc == 0:
                    sent += 1
                    ob["last_sent"], ob["last_error"] = t, ""
                    ob["sent_total"] = ob.get("sent_total", 0) + 1
                else:
                    q["tries"] += 1
                    q["err"] = ob["last_error"] = f"{q['to']}: {out}"
                    if q["tries"] < 5:
                        keep.append(q)
                    else:
                        log(T("signal: копію не надіслано ({0}) після 5 спроб: {1}", q['to'], out))
                continue
            by_to.setdefault((q["to"], bool(q.get("group"))), []).append(q)
        for (to, grp), items in by_to.items():
            batch, rest = items[:10], items[10:]
            text, bold = format_batch(batch)
            dest = ["-g", to] if grp else [to]
            rc, out = 1, ""
            if bold:                                   # header in bold; an older signal-cli without --text-style: without it
                rc, out = signal_run(["-a", sender, "send", "-m", text, "--text-style", f"0:{bold}:BOLD"] + dest)
            if rc != 0:
                rc, out = signal_run(["-a", sender, "send", "-m", text] + dest)
            if rc == 0:
                sent += len(batch)
                ob["last_sent"], ob["last_error"] = t, ""
                ob["sent_total"] = ob.get("sent_total", 0) + len(batch)
            else:
                ob["last_error"] = f"{T('група') if grp else to}: {out}"
                for q in batch:
                    q["tries"] += 1
                    q["err"] = out
                    if q["tries"] < 5:
                        keep.append(q)
                    else:
                        log(T("signal: не вдалося надіслати ({0}) після 5 спроб: {1}", T("група") if grp else to, out))
            keep += rest
        ob["queue"] = keep
        save_outbox(ob)
        pending = {q["attach"] for q in keep if q.get("attach")}
        if os.path.isdir(SIGNAL_OUT):                # remove sent and abandoned files
            for fn in os.listdir(SIGNAL_OUT):
                if f"{SIGNAL_OUT}/{fn}" not in pending:
                    os.remove(f"{SIGNAL_OUT}/{fn}")
    return sent


def sync_group(old, new):
    """Group members = admins: add the new ones, remove the removed ones."""
    cfg = notify_cfg()
    if not cfg.get("group") or not cfg.get("sender"):
        return
    add = [x for x in new if x not in old]
    rem = [x for x in old if x not in new]
    if not cfg.get("group_managed"):
        if add or rem:
            msg = (T("Склад групи «{0}» не змінено автоматично (група створена не wgctl). ", cfg.get('group_name') or T("сповіщень"))
                   + (T("Додайте вручну: {0}. ", ', '.join(add)) if add else "")
                   + (T("Видаліть вручну: {0}.", ', '.join(rem)) if rem else ""))
            log(f"EVENT:security {msg}")
            print(msg)
        return
    for flag_, nums, what in (("-m", add, T("додано до групи")), ("-r", rem, T("видалено з групи"))):
        if not nums:
            continue
        rc, out = signal_run(["-a", cfg["sender"], "updateGroup", "-g", cfg["group"], flag_] + nums)
        if rc == 0:
            log(T("EVENT:security {0}: {1} сповіщень", ', '.join(nums), what))
        else:
            msg = (T("Не вдалося оновити групу сповіщень ({0}: {1}): {2}. Перевірте склад групи вручну у Signal", what, ', '.join(nums), out))
            log(f"EVENT:security {msg}")
            enqueue([{"to": x, "group": False, "kind": "admin", "text": msg, "level": "warning", "icon": "👥", "url": ""} for x in new])
            flush_outbox()
            print(msg)


def cmd_notify(a):
    if a.ncmd == "set":
        changes = []
        with Lock():
            st = load()
            n = st.setdefault("notify", {})
            if n.get("admin") and not n.get("admins"):
                n["admins"] = [n["admin"]]
            n.pop("admin", None)
            old_admins = list(n.get("admins", []))
            admins = parse_phones(a.admins)
            if admins is not None:
                n["admins"] = admins
                changes.append(f"admins={','.join(admins) or '-'}")
            if a.sender is not None:
                v = parse_phones(a.sender)
                if len(v) > 1:
                    die(T("Відправник лише один"))
                n["sender"] = v[0] if v else ""
                changes.append(f"sender={n['sender'] or '-'}")
            if a.group is not None:
                grp = "" if a.group in ("", "none") else a.group.strip()
                if grp and not GROUP_RE.fullmatch(grp):
                    die(T("ID групи Signal: base64, напр. з wgctl notify groups"))
                n["group"] = grp
                n["group_name"] = clean_note(a.group_name) or ("" if not n["group"] else n.get("group_name", ""))
                n["group_managed"] = False          # a group chosen by hand: members are left alone
                changes.append(f"group={n['group'][:12] + '…' if n['group'] else '-'}")
            for key in ("connect", "report", "users"):
                v = getattr(a, key)
                if v is not None:
                    n[key] = onoff(v)
                    changes.append(f"{key}={'on' if n[key] else 'off'}")
            if not changes:
                die(T("Нічого не змінено. Див. wgctl notify set -h"))
            save(st)
        log(T("EVENT:info Налаштування сповіщень: ") + ", ".join(changes))
        if admins is not None and set(admins) != set(old_admins):
            msg = (T("Змінено номери адміністраторів: {0} -> {1}", ', '.join(old_admins) or '-', ', '.join(admins) or '-'))
            log(f"EVENT:security {msg}")
