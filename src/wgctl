# ---- history for charts -----------------------------------------------------
RANGES = {"24h": (86400, 600), "7d": (7 * 86400, 3600), "30d": (30 * 86400, 6 * 3600), "90d": (90 * 86400, 86400)}


def is_counter(k):
    return k.startswith(("rx:", "tx:"))


def history(keys, rng):
    """{key: [[segment start, value], ...]}: counters are summed, the rest is averaged."""
    span, step = RANGES[rng]
    t = now()
    since = (t - span) // step * step
    out = {k: {} for k in keys}
    if not os.path.exists(HISTORY_DB):
        return {"range": rng, "step": step, "from": since, "to": t, "series": {k: [] for k in keys}}
    db = hist_db()
    try:
        for k in keys:
            agg = "SUM" if is_counter(k) else "AVG"
            if rng == "24h":
                rows = db.execute(f"SELECT ts / ? * ?, {agg}(v) FROM m WHERE k = ? AND ts >= ? GROUP BY ts / ?",
                                  (step, step, k, since, step)).fetchall()
            else:
                col = "sum" if is_counter(k) else "avg"
                last_h = db.execute("SELECT MAX(ts) FROM h WHERE k = ?", (k,)).fetchone()[0] or 0
                hours = db.execute(f"SELECT ts, {col}, n FROM h WHERE k = ? AND ts >= ?", (k, since)).fetchall()
                hours += db.execute(f"SELECT ts / 3600 * 3600, {agg}(v), COUNT(*) FROM m WHERE k = ? AND ts >= ? "
                                    "GROUP BY ts / 3600", (k, max(since, last_h + 3600))).fetchall()
                buckets = {}
                for ts, v, n in hours:
                    b = buckets.setdefault(ts // step * step, [0.0, 0])
                    if is_counter(k):
                        b[0] += v
                        b[1] = 1
                    else:
                        b[0] += v * n
                        b[1] += n
                rows = [(b, s / max(n, 1)) for b, (s, n) in buckets.items()]
            out[k] = {int(b): round(v, 3) for b, v in rows if v is not None}
    finally:
        db.close()
    return {"range": rng, "step": step, "from": since, "to": t,
            "series": {k: sorted([b, v] for b, v in out[k].items()) for k in keys}}


def cmd_history(a):
    keys = [k for k in a.keys.split(",") if re.fullmatch(r"[a-z]+(:[a-z0-9-]+)?", k)]
    print(json.dumps(history(keys, a.range)))


