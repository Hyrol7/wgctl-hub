    print(T("Ключ підходить. {0}: файлів {1}, створено {2}, wgctl {3}", os.path.basename(path), len(items) - 1, fmt_ts(man.get('created')), man.get('version', '?')))
    log(T("EVENT:info Перевірено ключ розшифрування резервних копій"))


def cmd_backup_restore(a):
    """Restore: show the contents; with --apply write the files back and restart the services."""
    need_tty(T("Відновлення"))
    path = pick_backup(a.file)
    ident = ask_identity()
    try:
        items = open_archive(path, ident)
    finally:
        shred(ident)
    files = sorted(n for n in items if n != "MANIFEST.json")
    skipped = [n for n in files if not restorable(n)]
    files = [n for n in files if restorable(n)]
    if skipped:
        print(T("Пропущено {0} файлів поза переліком копії: {1}", len(skipped), ", ".join(skipped[:5])))
    print(T("У копії {0} файлів:", len(files)))
    for n in files:
        print(f"  /{n}")
    if not a.apply:
        print(T("\nЦе лише перегляд. Записати файли на місце: sudo wgctl backup restore <файл> --apply"))
        return
    if not a.yes and input(T("Перезаписати поточні файли цими? Напишіть так: ")).strip().lower() != T("так"):
        die(T("Скасовано"))
    if os.path.exists(BACKUP_PUB) and age_bin():
        try:
            pre = f"{BACKUP_OUT}/wgctl-before-restore-{dt.datetime.now(TZ).strftime('%Y%m%d-%H%M%S')}.tar.gz.age"
            os.makedirs(BACKUP_OUT, mode=0o700, exist_ok=True)
            build_archive(pre)
            print(T("Поточний стан збережено: {0}", pre))
        except Exception as ex:
            print(T("Не вдалося зберегти поточний стан ({0}), продовжую", ex))
    for n in files:
        if n.startswith("var/log/"):
            continue                          # the current log is not overwritten: it holds events after the backup
        ti, data = items[n]
        dst = P("/" + n)
        uid, gid = restore_owner(n, ti)
        makedirs_owned(os.path.dirname(dst), uid, gid)
        tmp = dst + ".wgctl-restore"
        if os.path.lexists(tmp):
            os.remove(tmp)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, ti.mode & 0o777 or 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            if os.geteuid() == 0:
                os.fchown(f.fileno(), uid, gid)
        os.replace(tmp, dst)
    log(T("EVENT:security Відновлено з резервної копії {0} ({1} файлів)", os.path.basename(path), len(files)))
    if not DRY:
        for cmd in (["systemctl", "daemon-reload"], ["nft", "-f", "/etc/nftables.conf"],
                    ["systemctl", "restart", "wg-quick@wg0"], ["systemctl", "reload-or-restart", "caddy"],
                    ["systemctl", "restart", "vpnadmin"], ["systemctl", "reload", "ssh"],
                    ["/usr/local/sbin/wgctl", "render"]):
            r = run(cmd, check=False)
            print((T("ок   ") if r.returncode == 0 else T("збій ")) + " ".join(cmd)
                  + ("" if r.returncode == 0 else f": {(r.stderr or r.stdout).strip()[:200]}"))
    print(T("Готово. Перевірте: sudo wgctl status"))


