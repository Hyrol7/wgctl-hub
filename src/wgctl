    table(rows)


# ---- history (SQLite) -------------------------------------------------------
# Per-minute values are kept for 2 days, hourly totals for 90 days; the panel charts read them.
HISTORY_DB = P("/var/lib/wgctl/history.db")
HIST_MINUTE_KEEP = 2 * 86400
HIST_HOUR_KEEP = 90 * 86400


def hist_db():
    import sqlite3
    os.makedirs(os.path.dirname(HISTORY_DB), exist_ok=True)
    db = sqlite3.connect(HISTORY_DB, timeout=10)
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript("""
CREATE TABLE IF NOT EXISTS m (ts INTEGER NOT NULL, k TEXT NOT NULL, v REAL NOT NULL);
CREATE INDEX IF NOT EXISTS m_k_ts ON m(k, ts);
CREATE TABLE IF NOT EXISTS h (ts INTEGER NOT NULL, k TEXT NOT NULL, avg REAL, min REAL, max REAL, sum REAL, n INTEGER,
                              PRIMARY KEY (k, ts));
CREATE TABLE IF NOT EXISTS last (k TEXT PRIMARY KEY, v REAL NOT NULL);
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT NOT NULL);
""")
    return db


def hist_record(st, peers, srv):
    """One record per minute: key traffic and online state, location connectivity, sites, VPS load."""
    t = now() // 60 * 60
    rows = []
    try:
        db = hist_db()
    except Exception as ex:
        log(f"history: {ex!r}")
        return
    try:
        last = dict(db.execute("SELECT k, v FROM last"))
        newlast = {}
        for name, c in st["clients"].items():
            if c["status"] == "revoked":
                continue
            p = peers.get(c["pubkey"]) or {}
            for d in ("rx", "tx"):
                cur = p.get(d, 0)
                prev = last.get(f"{d}:{name}")
                newlast[f"{d}:{name}"] = cur
                if prev is not None:
                    rows.append((t, f"{d}:{name}", cur - prev if cur >= prev else cur))   # the counter was reset
            rows.append((t, f"on:{name}", 1 if p.get("hs") and now() - p["hs"] < ONLINE_SEC else 0))
        for name, l in st["locations"].items():
            v = location_view(name, l, peers)["state"]
            rows.append((t, f"loc:{name}", {"ok": 1, "warn": .5}.get(v, 0)))
        for name, s in list(st["sites"].items()) + list(st.get("services", {}).items()):
            h = s.get("health") or {}
            if h:
                rows.append((t, f"up:{name}", 1 if h.get("ok") else 0))
                if h.get("ok") and h.get("ms") is not None:
                    rows.append((t, f"ms:{name}", h["ms"]))
        if srv:
            rows += [(t, "load", srv["load"][0]), (t, "mem", srv["mem_pct"]), (t, "disk", srv["disk_pct"])]
        with db:
            db.execute("DELETE FROM m WHERE ts = ?", (t,))           # a second run within the same minute
            db.executemany("INSERT INTO m (ts, k, v) VALUES (?, ?, ?)", rows)
            db.executemany("INSERT OR REPLACE INTO last (k, v) VALUES (?, ?)", newlast.items())
            hour = t // 3600 * 3600
            done = int((db.execute("SELECT v FROM meta WHERE k='rolled'").fetchone() or ["0"])[0])
            if done < hour - 3600:
                db.execute("""INSERT OR REPLACE INTO h (ts, k, avg, min, max, sum, n)
                              SELECT ts / 3600 * 3600, k, AVG(v), MIN(v), MAX(v), SUM(v), COUNT(*) FROM m
                              WHERE ts >= ? AND ts < ? GROUP BY ts / 3600, k""", (max(done, t - HIST_MINUTE_KEEP), hour))
                db.execute("INSERT OR REPLACE INTO meta (k, v) VALUES ('rolled', ?)", (str(hour - 3600),))
                db.execute("DELETE FROM m WHERE ts < ?", (t - HIST_MINUTE_KEEP,))
                db.execute("DELETE FROM h WHERE ts < ?", (t - HIST_HOUR_KEEP,))
    finally:
        db.close()


def hist_bytes():
    """A consistent copy of the database for the archive (through the backup API, not by copying the file)."""
    import sqlite3
    if not os.path.exists(HISTORY_DB):
        return None
    src = sqlite3.connect(HISTORY_DB, timeout=10)
    mem = sqlite3.connect(":memory:")
    try:
        src.backup(mem)
        return mem.serialize()
    finally:
        src.close()
        mem.close()


# ---- site visit journal -----------------------------------------------------
# Caddy writes its access log as JSON; every minute the monitor reads what is new and keeps only a daily summary:
# who (key, location or country for public sites), which site, how many requests and refusals, first and last time.
ACCESS_LOG = P("/var/log/caddy/wgctl-access.log")
ACCESS_POS = P("/var/lib/wgctl/access.pos")
VISITS_KEEP_DAYS = 90
ACCESS_CHUNK = 8 * 1024 * 1024


LOG_MODES = ("full", "hide-path", "off")
LOG_SKIP_RE = re.compile(r"/[A-Za-z0-9._~/*-]{0,200}")


def parse_log_skip(values):
    """Paths a site does not write to the log (Caddy path matcher: /s, /health, /static/*).
    Accepts several flags and comma-separated lists; none clears."""
    out = []
    for v in values:
        for x in (y.strip() for y in v.split(",")):
            if not x:
                continue
            if x == "none":
                out = []
                continue
            if not LOG_SKIP_RE.fullmatch(x):
                die(T("Шлях для --log-skip: починається з /, латиниця, цифри, . _ ~ - / і * (напр. /s або /static/*)"))
            if x not in out:
                out.append(x)
    if len(out) > 20:
        die(T("Не більше 20 шляхів у --log-skip"))
    return out


def site_log_lines(s, m, indent):
    """A site's log inside the shared *.domain block (the VPN path)."""
    t = "\t" * indent
    mode, skip = s.get("log", "full"), s.get("log_skip") or []
    if mode == "off":
        return [f"{t}log_skip"]
    out = [f"{t}log_name wgctl_hidden"] if mode == "hide-path" else []
    if skip:
        out += [f"{t}@nolog_{m} path {' '.join(skip)}", f"{t}log_skip @nolog_{m}"]
    return out


def caddy_log_lines(indent, mode="full", name=""):
    """A site's access log. full: as is; hide-path: only the first path segment is logged
    (/hook/<secret>?x=1 -> /hook/[hidden], / stays /), so secrets in the path and query never reach the file;
    off: the site is not logged (and not counted in visits)."""
    if mode == "off":
        return []
    t = "\t" * indent
    path = ACCESS_LOG[len(ROOT):] if ROOT else ACCESS_LOG
    fmt = [f"{t}\tformat json"]
    if mode == "hide-path":
        fmt = [f"{t}\tformat filter {{", f"{t}\t\twrap json", f"{t}\t\tfields {{",
               f'{t}\t\t\trequest>uri regexp "^(/[^/?]*)[/?].*$" "$1/[hidden]"', f"{t}\t\t}}", f"{t}\t}}"]
    return [f"{t}log {name + ' ' if name else ''}{{", f"{t}\toutput file {path} {{", f"{t}\t\troll_size 20MiB",
            f"{t}\t\troll_keep 3", f"{t}\t}}"] + fmt + [f"{t}}}"]


def visits_db():
    db = hist_db()
    db.executescript("""
CREATE TABLE IF NOT EXISTS visits (day TEXT NOT NULL, site TEXT NOT NULL, who TEXT NOT NULL, n INTEGER NOT NULL,
    denied INTEGER NOT NULL, bytes INTEGER NOT NULL, first INTEGER NOT NULL, last INTEGER NOT NULL,
    PRIMARY KEY (day, site, who));
CREATE INDEX IF NOT EXISTS visits_who ON visits(who, day);
""")
    return db


def visits_ingest(st):
    """Reads Caddy's log from where it stopped last time (handles rotation)."""
    if not os.path.exists(ACCESS_LOG):
        return 0
    pos = read_json(ACCESS_POS, {})
    stt = os.stat(ACCESS_LOG)
    off = pos.get("off", 0) if pos.get("ino") == stt.st_ino and pos.get("off", 0) <= stt.st_size else 0
    if off == stt.st_size:
        return 0
    with open(ACCESS_LOG, "rb") as f:
        f.seek(off)
        chunk = f.read(ACCESS_CHUNK)
    cut = chunk.rfind(b"\n") + 1                    # complete lines only
    if not cut:
        return 0
    by_ip = {c["ip"]: n for n, c in st["clients"].items() if c["status"] != "revoked"}
    by_ip.update({l["ip"]: n for n, l in st["locations"].items() if l.get("ip")})
    public = {n for n, s in st["sites"].items() if s.get("public")}
    agg = {}
    for ln in chunk[:cut].splitlines():
        try:
            r = json.loads(ln)
            req = r["request"]
            host = req.get("host", "").split(":")[0].lower()
        except (ValueError, KeyError, AttributeError):
            continue
        if not host.endswith("." + DOMAIN) or host == PANEL_HOST:
            continue
        site = host[:-len(DOMAIN) - 1]
        if site not in st["sites"]:
            continue
        ip = req.get("client_ip") or req.get("remote_ip", "")
        if site in public:                        # behind Cloudflare: the real visitor address is in a header
            hdr = (req.get("headers") or {}).get("Cf-Connecting-Ip") or []
            real = hdr[0] if hdr else ip
            who = "web:" + (geo_lookup(real).get("cc") or "??")
        else:
            who = by_ip.get(ip, ip)
        ts = int(r.get("ts", now()))
        day = dt.datetime.fromtimestamp(ts, TZ).date().isoformat()
        a = agg.setdefault((day, site, who), [0, 0, 0, ts, ts])
        a[0] += 1
        a[1] += 1 if r.get("status") == 403 else 0
        a[2] += int(r.get("size") or 0)
        a[3], a[4] = min(a[3], ts), max(a[4], ts)
    if agg:
        db = visits_db()
        try:
            with db:
                db.executemany("""INSERT INTO visits (day, site, who, n, denied, bytes, first, last) VALUES (?,?,?,?,?,?,?,?)
                    ON CONFLICT(day, site, who) DO UPDATE SET n = n + excluded.n, denied = denied + excluded.denied,
                    bytes = bytes + excluded.bytes, first = MIN(first, excluded.first), last = MAX(last, excluded.last)""",
                               [(k[0], k[1], k[2], *v) for k, v in agg.items()])
                keep = (dt.datetime.now(TZ).date() - dt.timedelta(days=VISITS_KEEP_DAYS)).isoformat()
                db.execute("DELETE FROM visits WHERE day < ?", (keep,))
        finally:
            db.close()
    write_file(ACCESS_POS, json.dumps({"ino": stt.st_ino, "off": off + cut}) + "\n", 0o600)
    return sum(v[0] for v in agg.values())


def cmd_visits(a):
    since = (dt.datetime.now(TZ).date() - dt.timedelta(days=a.days - 1)).isoformat()
    q = ("SELECT site, who, SUM(n), SUM(denied), SUM(bytes), MIN(first), MAX(last), COUNT(DISTINCT day) FROM visits "
         "WHERE day >= ?")
    args = [since]
    if a.site:
        q += " AND site = ?"
        args.append(a.site)
    if a.client:
        q += " AND who = ?"
        args.append(a.client)
    q += " GROUP BY site, who ORDER BY MAX(last) DESC LIMIT 200"
    rows = []
    if os.path.exists(HISTORY_DB):
        db = visits_db()
        try:
            rows = [dict(zip(("site", "who", "n", "denied", "bytes", "first", "last", "days"), r))
                    for r in db.execute(q, args)]
            st = load()
            for r in rows:                                   # who it is: a key, a location, the internet or an unknown address
                w = r["who"]
                r["who_kind"] = ("web" if w.startswith("web:") else "client" if w in st["clients"] else
                                 "location" if w in st["locations"] else "ip")
                if r["who_kind"] == "location":
                    r["who_title"] = st["locations"][w].get("title") or w
        finally:
            db.close()
    if a.json:
        print(json.dumps({"days": a.days, "logging": os.path.exists(ACCESS_LOG), "rows": rows}, ensure_ascii=False))
        return
    if not rows:
        print(T("Відвідувань за цей час немає") + ("" if os.path.exists(ACCESS_LOG) else T(" (журнал Caddy ще не створено: wgctl render)")))
        return
