def cmd_log(a):
    lines = []
    for path in (LOG + ".1", LOG):          # the previous part after rotation + the current one
        if os.path.exists(path):
            with open(path, errors="replace") as f:
                lines += f.read().splitlines()
    if a.events:
        lines = [l for l in lines if " EVENT" in l[:24]]
    if a.client:
        lines = [l for l in lines if re.search(rf"\b{re.escape(a.client)}\b", l)]
    out = []
    for l in lines:
        m = re.match(r"^(\S+ \S+) EVENT(?::(\w+))? (.*)$", l)
        if m:
            out.append({"ts": m.group(1), "cat": m.group(2) or "info", "text": m.group(3)})
        elif not a.events:
            out.append({"ts": l[:16], "cat": "system", "text": l[17:]})
    if a.cat:
        out = [x for x in out if x["cat"] == a.cat]
    out = out[-a.n:]
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print("\n".join(f"{x['ts']} [{CAT_UA.get(x['cat'], x['cat'])}] {x['text']}" for x in out)
              if out else T("Журнал порожній"))


