def _check_config():
    """Values from config.toml end up in Caddy and WireGuard configs and in commands: check them right away."""
    bad = []
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+", DOMAIN):
        bad.append("network.domain")
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?", PANEL_SUB):
        bad.append("panel.subdomain")
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", IFACE):
        bad.append("network.interface")
    try:
        if ipaddress.ip_address(PUBLIC_IP).version != 4:
            bad.append("network.public_ip")
    except ValueError:
        bad.append("network.public_ip")
    if not re.fullmatch(r"[A-Za-z0-9.-]+", cfg("network", "endpoint_host", PUBLIC_IP)):
        bad.append("network.endpoint_host")
    if not 1 <= LISTEN_PORT <= 65535:
        bad.append("network.listen_port")
    if not 2 <= LOC_MIN <= LOC_MAX < IP_MIN:
        bad.append("network.locations_from/locations_to (2..clients_from-1)")
    if not 3 <= IP_MIN <= IP_MAX <= 254:
        bad.append("network.clients_from/clients_to (3..254)")
    if not _NETW.is_private:
        bad.append("network.subnet (private)")
    if any(c in BRAND for c in '"\\\n\r<>'):
        bad.append("panel.brand")
    if bad:
        sys.exit(f"wgctl: {CONFIG_FILE}: " + ", ".join(bad))


