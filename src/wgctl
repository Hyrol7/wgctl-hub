def age_bin():
    return shutil.which("age")


def owner_names(stt):
    import grp
    import pwd
    try:
        u = pwd.getpwuid(stt.st_uid).pw_name
    except KeyError:
        u = "root"
    try:
        g = grp.getgrgid(stt.st_gid).gr_name
    except KeyError:
        g = "root"
    return u, g


# Owners for backups made before the archive started to store owner names
DEFAULT_OWNERS = (("etc/vpnadmin/", "vpnadmin"), ("var/lib/signal-cli/", "signal"))


def restorable(name):
    """Only what goes into a backup can be restored: otherwise a forged archive could write anything as root."""
    path = "/" + name
    for pat in BACKUP_PATHS:
        if path == pat or path.startswith(pat.rstrip("/") + "/") or ("*" in pat and fnmatch.fnmatchcase(path, pat)):
            return not BACKUP_SKIP.search(path) or path == "/var/lib/wgctl/history.db"
    return False


def restore_owner(name, ti):
    """(uid, gid) for a restored file: from the archive, or the default for old backups; unknown names -> root."""
    import grp
    import pwd
    user, group = ti.uname or "", ti.gname or ""
    if not user:
        user = group = next((u for pre, u in DEFAULT_OWNERS if name.startswith(pre)), "root")
    try:
        uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        uid = 0
    try:
        gid = grp.getgrnam(group).gr_gid
    except KeyError:
        gid = 0
    return uid, gid


def makedirs_owned(path, uid, gid):
    """Like os.makedirs, but new directories get the file's owner (e.g. signal-cli data) and mode 0700."""
    missing = []
    while path and not os.path.isdir(path):
        missing.append(path)
        path = os.path.dirname(path)
    for d in reversed(missing):
        os.mkdir(d, 0o700)
        if os.geteuid() == 0:
            os.chown(d, uid, gid, follow_symlinks=False)


def backup_files():
    """Paths for the archive: (path on disk, name in the archive)."""
    out = []
    for pat in BACKUP_PATHS:
        for path in sorted(glob.glob(P(pat))):
            for root, dirs, files in (os.walk(path) if os.path.isdir(path) else [(os.path.dirname(path), [], [os.path.basename(path)])]):
                dirs.sort()
                for fn in sorted(files):
                    full = os.path.join(root, fn)
                    arc = full[len(ROOT):] if ROOT and full.startswith(ROOT) else full
                    if BACKUP_SKIP.search(arc) or os.path.islink(full) or not os.path.isfile(full):
                        continue
                    out.append((full, arc))
    return out


def norm_for_fingerprint(arc, data):
    """What counts as a configuration change: key state without live counters, auth without the TOTP counter."""
    if arc.endswith("/etc/wgctl/state.json"):
        st = json.loads(data)
        st["clients"] = {n: {k: c.get(k) for k in CLIENT_KEYS} for n, c in st.get("clients", {}).items()}
        for s in st.get("sites", {}).values():
            s.pop("health", None)
        for l in st.get("locations", {}).values():
            l.pop("last_state", None)
        return json.dumps(st, sort_keys=True).encode()
    if arc.endswith("/etc/vpnadmin/auth.json"):
        a = json.loads(data)
        a.pop("totp_last", None)
        return json.dumps(a, sort_keys=True).encode()
    return data


def backup_status():
    bs = read_json(BACKUP_STATE, {})
    files = []
    if os.path.isdir(BACKUP_OUT):
        for fn in os.listdir(BACKUP_OUT):
            if fn.endswith(".tar.gz.age"):
                p = f"{BACKUP_OUT}/{fn}"
                files.append({"name": fn, "size": os.path.getsize(p), "ts": int(os.path.getmtime(p))})
        files.sort(key=lambda x: (x["ts"], x["name"]), reverse=True)          # newest first
    return {"configured": os.path.exists(BACKUP_PUB), "age": bool(age_bin()), "files": files,
            "last_ok": bs.get("last_ok", 0), "last_error": bs.get("last_error", ""), "last_signal": bs.get("last_signal", 0),
            "last_size": bs.get("last_size", 0), "last_changed": bs.get("last_changed", 0)}


