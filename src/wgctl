    p.add_argument("--networks", default="", help=T("мережі за роутером через кому, напр. 192.168.1.0/24"))
    p.add_argument("--title")
    p.add_argument("--panel", action="store_true", help=T("пускати мережу локації в панель"))
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("set", help=T("змінити локацію"))
    p.add_argument("name")
    p.add_argument("--networks")
    p.add_argument("--title")
    p.add_argument("--note")
    p.add_argument("--panel", choices=("on", "off"))
    p.add_argument("--sites", help=T("сайти, які відкриває мережа локації (потрібен NAT на роутері): через кому, * або none"))
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("rm", help=T("видалити локацію"))
    p.add_argument("name")
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("conf", help=T("конфіг роутера: wg (файл WireGuard), mikrotik, openwrt"))
    p.add_argument("name")
    p.add_argument("--format", choices=list(ROUTER_FORMATS), default="wg")
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("reissue", help=T("нові ключі для роутера; старий конфіг перестає працювати"))
    p.add_argument("name")
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("adopt", help=T("передати під керування wgctl локацію, яку налаштовано вручну у wg0.conf"))
    p.add_argument("name")
    p.set_defaults(f=cmd_location)
    p = lc.add_parser("list", help=T("список локацій"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_location, name="")

    p = sp.add_parser("server", help=T("стан самого VPS: диск, пам'ять, оновлення, служби, копії"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_server)
    bk = sp.add_parser("backup", help=T("зашифровані резервні копії")).add_subparsers(dest="bcmd", required=True)
    p = bk.add_parser("init", help=T("створити ключ шифрування і щоденний таймер"))
    p.add_argument("--force", action="store_true")
    p.set_defaults(f=cmd_backup_init)
    p = bk.add_parser("run", help=T("зробити копію зараз"))
    p.add_argument("--signal", action="store_true", help=T("надіслати в Signal, навіть якщо нічого не змінилось"))
    p.add_argument("--no-signal", action="store_true")
    p.set_defaults(f=cmd_backup_run)
    p = bk.add_parser("status", help=T("стан копій"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_backup_status)
    p = bk.add_parser("verify", help=T("перевірити, що ваш ключ розшифровує копію"))
    p.add_argument("file", nargs="?")
    p.set_defaults(f=cmd_backup_verify)
    p = bk.add_parser("restore", help=T("відновити з копії"))
    p.add_argument("file", nargs="?")
    p.add_argument("--apply", action="store_true", help=T("записати файли на місце (без нього лише перегляд)"))
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(f=cmd_backup_restore)

    p = sp.add_parser("status", help=T("стан системи"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_status)
    sp.add_parser("monitor", help=T("перевірка (таймер щохвилини)")).set_defaults(f=cmd_monitor)
    p = sp.add_parser("event", help=T("записати подію в журнал і сповіщення (для панелі)"))
    p.add_argument("text")
    p.add_argument("--cat", choices=list(CAT_UA), default="info")
    p.add_argument("--level", choices=LEVELS)
    p.add_argument("--icon", help=T("значок (емодзі)"))
    p.set_defaults(f=lambda a: (notify(a.text[:300].replace("\n", " "), a.cat, level=a.level,
                                       icon=(a.icon or "")[:8] or None), flush_outbox()))
    sp.add_parser("render", help=T("перегенерувати конфіги WireGuard, Caddy і TCP-сервісів")).set_defaults(
        f=lambda a: apply(load(), force_tcp=True) or print(T("Конфіги перегенеровано")))
    p = sp.add_parser("log", help=T("журнал"))
    p.add_argument("-n", type=int, default=30)
    p.add_argument("--client")
    p.add_argument("--cat", choices=list(CAT_UA))
    p.add_argument("--all", dest="events", action="store_false", help=T("разом зі службовими рядками"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_log)

    a = ap.parse_args()
    if os.environ.get("SUDO_USER") == PANEL_USER and not panel_allowed(a):
        die(T("Ця команда недоступна з вебпанелі: запустіть її з терміналу через SSH"))
    if not CFG and a.cmd != "init":
        die(T("Немає {0}. Спершу: sudo wgctl init", CONFIG_FILE))
    for attr in ("name", "who"):
        if isinstance(getattr(a, attr, None), str):
            setattr(a, attr, getattr(a, attr).lower())
        elif isinstance(getattr(a, attr, None), list):
            setattr(a, attr, [x.lower() for x in getattr(a, attr)])
    if isinstance(getattr(a, "sites", None), list):
        a.sites = [s.lower() for s in a.sites]
    a.f(a)


if __name__ == "__main__":
    main()
