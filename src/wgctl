def site_host(st, s):
    """Where a site's backend lives: ("location", name) | ("client", name) | ("vps", "") | ("other", address)."""
    m = re.match(r"^https?://([^/:]+)", s.get("backend", ""))
    host = m.group(1) if m else ""
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return ("other", host)
    if str(ip) in ("127.0.0.1", HUB_IP, PUBLIC_IP):
        return ("vps", "")
    for n, c in st["clients"].items():
        if c["status"] != "revoked" and c.get("ip") == str(ip):
            return ("client", n)
    for n, l in st["locations"].items():
        if l.get("ip") == str(ip):
            return ("location", n)
        for net in l.get("networks", []):
            try:
                if ip in ipaddress.ip_network(net, strict=False):
                    return ("location", n)
            except ValueError:
                pass
    return ("other", str(ip))


