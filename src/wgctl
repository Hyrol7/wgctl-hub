def location_keys(name):
    """Router keys from the saved config (written on add/reissue)."""
    try:
        with open(f"{CONF_DIR}/location-{name}.conf") as f:
            text = f.read()
    except FileNotFoundError:
        die(T("Конфіг роутера для {0} не збережено. Нові ключі: wgctl location reissue {1}", name, name))
    get = lambda k: (re.search(rf"^{k}\s*=\s*(\S+)", text, re.M) or die(T("Пошкоджений конфіг {0}", name))).group(1)
    return get("PrivateKey"), get("Address").split("/")[0], get("PresharedKey")


def host_networks():
    """Networks the VPS itself sits in (its own addresses and gateway): a location must never take them over,
    or the hub would route its own traffic, SSH included, into the tunnel."""
    out = []
    try:
        r = run(["ip", "-4", "-o", "addr", "show"], check=False)
        for dev, cidr in re.findall(r"^\d+:\s+(\S+)\s+inet\s+(\S+)", r.stdout, re.M):
            if dev != IFACE and not cidr.startswith("127."):
                out.append(ipaddress.ip_interface(cidr).network)
        r = run(["ip", "-4", "route", "show", "default"], check=False)
        out += [ipaddress.ip_network(g + "/32") for g in re.findall(r"\bvia (\d+\.\d+\.\d+\.\d+)", r.stdout)]
    except (OSError, ValueError):
        pass
    if os.environ.get("WGCTL_HOST_NETS"):         # tests
        out += [ipaddress.ip_network(x) for x in os.environ["WGCTL_HOST_NETS"].split(",")]
    return out


def parse_networks(v, st=None, skip=None):
    """Networks behind the router. They must not overlap the VPN or another location's networks:
    in WireGuard an address leads to one peer only, so a second location would take over the first one's network."""
    out = []
    for x in (v or "").split(","):
        x = x.strip()
        if not x:
            continue
        try:
            n = ipaddress.ip_network(x, strict=False)
        except ValueError:
            die(T("Мережа {0}: потрібен формат 192.168.1.0/24", x))
        if (n.version != 4 or n.overlaps(_NETW) or not n.is_private or n.prefixlen < 8
                or n.is_loopback or n.is_link_local or n.is_multicast or n.is_reserved
                or n.overlaps(ipaddress.ip_network("0.0.0.0/8"))):
            die(T("Мережа {0}: лише приватна IPv4, що не перетинається з {1}", x, _NETW))
        own = next((h for h in host_networks() if n.overlaps(h)), None)
        if own:
            die(T("Мережа {0} перетинається з мережею самого VPS ({1})", x, own))
        for other, l in (st or {}).get("locations", {}).items():
            if other != skip and any(n.overlaps(ipaddress.ip_network(o, strict=False)) for o in l.get("networks", [])):
                die(T("Мережа {0} перетинається з мережею локації {1}", x, other))
        if any(n.overlaps(ipaddress.ip_network(o)) for o in out):
            die(T("Мережа {0} повторюється", x))
        out.append(str(n))
    return out


def print_router_conf(name, priv, ip, psk):
    print(T("Локація {0}: адреса {1}. Конфіг для роутера: {2}/location-{3}.conf", name, ip, CONF_DIR, name))
    print(T("\nДля MikroTik (RouterOS 7), команди для терміналу:\n"))
    print(mikrotik_snippet(priv, ip, psk))
    print(T("Інші роутери: wgctl location conf {0} --format wg|openwrt", name))
    print(T("Далі: правила брандмауера на роутері, див. docs/uk/locations.md"))


def remove_manual_peer(pubkey):
    """`location adopt`: drop a hand-written [Peer] with this key from the manual part of wg0.conf."""
    with open(WG_CONF) as f:
        text = f.read()
    base = base_conf(text)
    blocks = re.split(r"(?m)^(?=\[)", base)
    keep = [b for b in blocks if not (b.lstrip().startswith("[Peer]") and re.search(
        rf"^PublicKey\s*=\s*{re.escape(pubkey)}\s*$", b, re.M))]
    if len(keep) == len(blocks):
        return False
    shutil.copy2(WG_CONF, WG_CONF + ".before-adopt")
    write_file(WG_CONF, text.replace(base, "".join(keep).rstrip("\n") + "\n\n", 1), 0o600)
    return True


def cmd_location(a):
    if a.lcmd == "list":
        st = load()
        peers = dump()
        rows = [location_view(n, l, peers) for n, l in st["locations"].items()]
        if a.json:
            print(json.dumps(rows, ensure_ascii=False))
            return
        if not rows:
            print(T("Локацій немає. Додайте: wgctl location add <ім'я> --networks 192.168.1.0/24"))
            return
        table([(T("ЛОКАЦІЯ"), T("НАЗВА"), "IP", T("МЕРЕЖІ"), T("СТАН"))] +
              [(r["name"], r["title"], r["ip"], ", ".join(r["networks"]) or "-", r["state"]) for r in rows])
        return
    name = a.name
    if not NAME_RE.match(name):
        die(T("Ім'я локації: малі латинські літери, цифри, дефіс"))
    if a.lcmd == "conf":
        st = load()
        st["locations"].get(name) or die(T("Локації {0} немає", name))
        print(ROUTER_FORMATS[a.format](*location_keys(name)), end="")
        return
    with Lock():
        st = load()
        locs = st["locations"]
        if a.lcmd == "add":
            if name in locs or name in st["clients"] or name in RESERVED:
                die(T("Ім'я {0} уже зайняте", name))
            used = {l.get("ip") for l in locs.values()}
            free = [f"{NET}{i}" for i in range(LOC_MIN, LOC_MAX + 1) if f"{NET}{i}" not in used]
            if not free:
                die(T("Вільних адрес для локацій немає"))
            priv, pub, psk = genkeys()
            locs[name] = {"ip": free[0], "pubkey": pub, "psk": psk, "networks": parse_networks(a.networks, st),
                          "managed": True, "sites": [], "panel": bool(a.panel),
                          "title": clean_note(a.title) or name, "note": "", "created": now()}
            write_file(f"{CONF_DIR}/location-{name}.conf", router_conf(priv, free[0], psk))
            save(st)
            apply(st)
            notify(T("Додано локацію {0} ({1}, мережі: {2})", name, free[0], ', '.join(locs[name]['networks']) or '-'),
                   "access", icon="📍")
            print_router_conf(name, priv, free[0], psk)
            return
        l = locs.get(name) or die(T("Локації {0} немає", name))
        if a.lcmd == "rm":
            if not l.get("managed"):
                die(T("Локацію {0} налаштовано вручну у {1}. Спершу: wgctl location adopt {2}", name, WG_CONF, name))
            if not a.yes:
                need_tty(T("Видалення локації"))
                if input(T("Видалити локацію {0}? Хаб утратить зв'язок з її мережами. [y/N] ", name)).strip().lower() not in ("y", "yes", "т", "так"):
                    die(T("Скасовано"))
            del locs[name]
            shred(f"{CONF_DIR}/location-{name}.conf")
            save(st)
            apply(st)
            notify(T("Видалено локацію {0}", name), "access", level="warning", icon="📍")
            print(T("Локацію {0} видалено", name))
        elif a.lcmd == "reissue":
            if not l.get("managed"):
                die(T("Локацію {0} налаштовано вручну у {1}. Спершу: wgctl location adopt {2}", name, WG_CONF, name))
            priv, pub, psk = genkeys()
            l.update(pubkey=pub, psk=psk)
            write_file(f"{CONF_DIR}/location-{name}.conf", router_conf(priv, l["ip"], psk))
            save(st)
            apply(st)
            notify(T("Нові ключі для локації {0}: роутер треба налаштувати заново", name), "security", level="warning", icon="📍")
            print_router_conf(name, priv, l["ip"], psk)
        elif a.lcmd == "adopt":
            need_tty(T("Передача локації під керування"))
            if l.get("managed"):
                die(T("Локацією {0} уже керує wgctl", name))
            removed = remove_manual_peer(l["pubkey"])
            l["managed"] = True
            save(st)
            apply(st)
            log(T("EVENT:info Локацію {0} передано під керування wgctl", name))
            print(T("Локацією {0} тепер керує wgctl{1}. Конфіг роутера не змінився.", name,
                    T(" (ручний [Peer] прибрано з {0}, копія: {0}.before-adopt)", WG_CONF) if removed else ""))
        elif a.lcmd == "set":
            if a.title is not None:
                l["title"] = clean_note(a.title) or name
            if a.networks is not None:
                if not l.get("managed"):
                    die(T("Мережі локації {0} задано вручну у {1}. Спершу: wgctl location adopt {2}", name, WG_CONF, name))
                l["networks"] = parse_networks(a.networks, st, skip=name)
            if a.panel is not None:
                l["panel"] = onoff(a.panel)
            if a.note is not None:
                l["note"] = clean_note(a.note)
            if a.sites is not None:
                l["sites"] = parse_sites(st, a.sites)
            save(st)
            apply(st)
            log(T("EVENT:info Змінено локацію {0}", name))
            print(T("Локацію {0} оновлено", name))


# ---- CLI -------------------------------------------------------------------
# The panel runs as user vpnadmin and calls wgctl through sudo. If the panel were compromised, sudo would give
# an attacker any wgctl command as root, so only what the panel really uses is allowed.
# Commands that change the system beyond VPN state (init, tcp setup, backup init/restore/verify, location adopt,
# panel, cloudflare, geo update, render, monitor) are available from a terminal only.
PANEL_USER = "vpnadmin"
PANEL_CMDS = {"status", "list", "show", "log", "conf", "qr", "server", "config", "history", "visits",
              "add", "reissue", "disable", "enable", "extend", "revoke", "trust", "clear", "set", "grant", "deny", "event"}
PANEL_SUBCMDS = {"location": {"add", "set", "rm", "list", "conf", "reissue"}, "site": {"add", "set", "rm", "list"}, "tcp": {"add", "set", "rm", "allow", "deny", "list"},
             "notify": {"show", "set", "test", "groups", "create-group"}, "backup": {"run", "status"}}


def panel_allowed(a):
    if a.cmd in PANEL_CMDS:
        return True
    sub = {"location": "lcmd", "site": "scmd", "tcp": "tcmd", "notify": "ncmd", "backup": "bcmd"}.get(a.cmd)
    return bool(sub) and getattr(a, sub, None) in PANEL_SUBCMDS.get(a.cmd, ())


