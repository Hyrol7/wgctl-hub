def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def apt_updates(cache):
    """(all, security) updates. apt-check is slow, so it is cached for 6 hours."""
    try:
        dpkg_changed = os.path.getmtime("/var/lib/dpkg/status") > cache.get("apt_ts", 0)
    except OSError:
        dpkg_changed = False
    if cache.get("apt_ts", 0) > now() - 6 * 3600 and "apt" in cache and not dpkg_changed:
        return cache["apt"]
    res = None
    if DRY:
        res = [int(x) for x in os.environ.get("WGCTL_FAKE_APT", "3;1").split(";")]
    elif os.path.exists("/usr/lib/update-notifier/apt-check"):
        r = subprocess.run(["/usr/lib/update-notifier/apt-check"], capture_output=True, text=True, timeout=120)
        m = re.match(r"^(\d+);(\d+)", r.stderr.strip())
        if m:
            res = [int(m.group(1)), int(m.group(2))]
    if res is None:
        r = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, timeout=120)
        lines = [ln for ln in r.stdout.splitlines() if "/" in ln]
        res = [len(lines), sum(1 for ln in lines if "-security" in ln)]
    cache["apt"], cache["apt_ts"] = res, now()
    return res


def release_check(cache):
    """Latest release on GitHub via `wgctl-update --check`, at most once a day. Returns the newer version or ""."""
    if cache.get("rel_ts", 0) > now() - 86400 and "rel" in cache:
        return cache["rel"]
    if os.environ.get("SUDO_USER") == PANEL_USER:      # the panel never waits for GitHub: the monitor refreshes it
        return cache.get("rel", "")
    tool = shutil.which("wgctl-update", path=f"/usr/local/sbin:{os.environ.get('PATH', '')}")
    if DRY:
        res = os.environ.get("WGCTL_FAKE_RELEASE", "")
    elif not tool:
        return ""
    else:
        try:
            r = subprocess.run([tool, "--check"], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return cache.get("rel", "")
        m = re.search(r"-> (\d+(?:\.\d+)+)", r.stdout) if r.returncode == 10 else None
        if r.returncode not in (0, 10):
            return cache.get("rel", "")
        res = m.group(1) if m else ""
    cache["rel"], cache["rel_ts"] = res, now()
    return res


def systemd_units():
    if DRY:
        svc = {s: "active" for s in SERVICES}
        tim = {t: {"active": "active", "last": now() - 60, "next": now() + 60} for t in TIMERS}
        return svc, tim
    r = run(["systemctl", "is-active"] + SERVICES, check=False)
    svc = dict(zip(SERVICES, (r.stdout.split() + ["unknown"] * len(SERVICES))[:len(SERVICES)]))
    tim = {}
    r = run(["systemctl", "show", "--timestamp=unix", "-p", "Id,ActiveState,LastTriggerUSec,NextElapseUSecRealtime"]
            + [f"{t}.timer" for t in TIMERS], check=False)
    for block in r.stdout.strip().split("\n\n"):
        kv = dict(ln.split("=", 1) for ln in block.splitlines() if "=" in ln)
        name = kv.get("Id", "").removesuffix(".timer")
        if name in TIMERS:
            tim[name] = {"active": kv.get("ActiveState", ""), "last": systemd_ts(kv.get("LastTriggerUSec")),
                         "next": systemd_ts(kv.get("NextElapseUSecRealtime"))}
    return svc, tim


def systemd_ts(v):
    """'@1793210000' (systemctl --timestamp=unix) -> unix time; 'n/a' -> 0."""
    m = re.search(r"@(\d+)", v or "")
    return int(m.group(1)) if m else 0


def server_info(slow=True):
    """State of the VPS itself. slow=False: without apt (for the per-minute monitor)."""
    cache = read_json(SERVER_CACHE, {})
    mem = {}
    try:
        with open("/proc/meminfo") as f:
            for ln in f:
                k, v = ln.split(":", 1)
                mem[k] = int(v.split()[0]) * 1024
    except OSError:
        pass
    du = shutil.disk_usage(ROOT or "/")
    try:
        with open("/proc/uptime") as f:
            up = int(float(f.read().split()[0]))
    except OSError:
        up = 0
    total, avail = mem.get("MemTotal", 0), mem.get("MemAvailable", 0)
    rr = P("/var/run/reboot-required")
    reboot = os.path.exists(rr)
    pkgs = []
    if reboot and os.path.exists(rr + ".pkgs"):
        with open(rr + ".pkgs") as f:
            pkgs = sorted(set(f.read().split()))
    unattended = False
    try:
        with open(P("/etc/apt/apt.conf.d/20auto-upgrades")) as f:
            unattended = bool(re.search(r'Unattended-Upgrade\s+"1"', f.read()))
    except OSError:
        pass
    os_name = ""
    try:
        with open("/etc/os-release") as f:
            os_name = dict(ln.rstrip().split("=", 1) for ln in f if "=" in ln).get("PRETTY_NAME", "").strip('"')
    except OSError:
        pass
    info = {
        "ts": now(), "host": os.uname().nodename, "os": os_name, "kernel": os.uname().release,
        "uptime": up, "load": [round(x, 2) for x in os.getloadavg()], "cpus": os.cpu_count() or 1,
        "mem_total": total, "mem_used": total - avail, "mem_pct": round((total - avail) * 100 / total, 1) if total else 0,
        "disk_total": du.total, "disk_used": du.used, "disk_pct": round(du.used * 100 / du.total, 1) if du.total else 0,
        "reboot": reboot, "reboot_since": int(os.path.getmtime(rr)) if reboot else 0, "reboot_pkgs": pkgs,
        "unattended": unattended,
    }
    if slow:
        try:
            info["updates"], info["security"] = apt_updates(cache)
        except Exception as ex:
            info["updates"] = info["security"] = None
            log(f"apt: {ex!r}")
        info["services"], info["timers"] = systemd_units()
        exp = cert_expiry()
        info["cert_days"] = (exp - now()) // 86400 if exp else None
        info["backup"] = backup_status()
        info["release"] = release_check(cache)
        write_file(SERVER_CACHE, json.dumps({k: cache[k] for k in ("apt", "apt_ts", "rel", "rel_ts") if k in cache}) + "\n", 0o644)
    return info


def server_checks(info):
    """Problems worth a notification: [(key, level, text)]."""
    out = []
    if info["disk_pct"] >= DISK_WARN:
        out.append(("disk", "bad" if info["disk_pct"] >= DISK_BAD else "warn",
                    T("Диск VPS заповнений на {0:.0f}% (вільно {1})", info['disk_pct'], human(info['disk_total'] - info['disk_used']))))
    if info["reboot"] and now() - info["reboot_since"] > 7 * 86400:
        out.append(("reboot", "warn", T("VPS чекає перезавантаження вже {0} дн (оновлено: {1})", (now() - info['reboot_since']) // 86400, ', '.join(info['reboot_pkgs'][:4]) or T("ядро"))))
    if info.get("security") and not info.get("unattended"):
        out.append(("security", "warn", T("Оновлень безпеки: {0}, автоматичні оновлення вимкнено", info['security'])))
    for s, v in (info.get("services") or {}).items():
        if v != "active":
            out.append((f"svc:{s}", "bad", T("Служба {0} не працює ({1})", s, v)))
    b = info.get("backup") or {}
    if b.get("configured"):
        if b.get("last_error"):
            out.append(("backup", "bad", T("Резервна копія не створилась: {0}", b['last_error'])))
        elif now() - (b.get("last_ok") or 0) > 36 * 3600:
            out.append(("backup", "warn", T("Резервної копії не було понад 36 год")))
    if info.get("release"):
        out.append((f"release:{info['release']}", "info", T("Доступна нова версія wgctl {0} (зараз {1}): sudo wgctl-update", info["release"], VERSION)))
    if info.get("cert_days") is not None and info["cert_days"] <= 14:
        out.append(("cert", "warn", T("Сертифікат *.{0} закінчиться через {1} дн", DOMAIN, info['cert_days'])))
    return out


def server_alerts(info):
