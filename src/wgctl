def probe(url):
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
    t0 = time.time()
    try:
        r = urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=4, context=ctx)
        code = r.status
    except urllib.error.HTTPError as e:
        code = e.code
    except Exception:
        return {"ok": False, "code": None, "ms": None, "ts": now()}
    return {"ok": True, "code": code, "ms": int((time.time() - t0) * 1000), "ts": now()}


def cmd_monitor(a):
    events, wg_changed, caddy_changed = [], False, False
    with Lock():
        st = load()
        peers = dump()
        t = now()
        today = dt.datetime.now(TZ).date().isoformat()
        for name, c in st["clients"].items():
            if c["status"] == "revoked":
                continue
            p = peers.get(c["pubkey"])
            hs = p["hs"] if p else 0
            if hs > c.get("last_seen", 0):
                c["last_seen"] = hs
            ep = p["endpoint"] if p and p["endpoint"] not in ("(none)", "") else ""
            if ep:
                ip = ep.rsplit(":", 1)[0]
                hist = c["endpoints"]
                if not hist or hist[-1]["ip"] != ip:
                    entry = {"ts": t, "ip": ip, **geo_lookup(ip)}
                    prev = hist[-1] if hist else None
                    hist.append(entry)
                    del hist[:-50]
                    geo_rules(name, c, entry, prev, events)
                elif not hist[-1].get("cc"):          # the record appeared before the geo databases: fill it in
                    g = geo_lookup(ip)
                    if g.get("cc"):
                        hist[-1].update(g)
                        if not c["countries"]:
                            c["countries"].append(g["cc"])
                c["endpoint"] = ep
                recent = [e for e in hist if e["ts"] >= t - FLAP_WINDOW]
                switches = len(recent) - 1
                if switches >= FLAP_COUNT and len({e["ip"] for e in recent}) >= 2:
                    flag(c, name, T("подвійна активність, {0} зміни адреси за 10 хв ({1})", switches, ', '.join(sorted({e['ip'] for e in recent}))), events)
            online = bool(hs) and t - hs < ONLINE_SEC
            if online != c.get("online", False):
                c["online"] = online
                tag = T(" [вимкнений]") if c["status"] == "disabled" else ""
                where = place(c["endpoints"][-1]) if c.get("endpoints") else c.get("endpoint", "").rsplit(":", 1)[0]
                events.append(ev(T("Підключився: {0} ({1}){2}", name, where, tag) if online else T("Відключився: {0}{1}", name, tag),
                                 "connect", name, icon="🟢" if online else "⚪"))
            if c.get("guest_until"):
                left = c["guest_until"] - t
                if left <= 0:
                    c.update(status="revoked", revoked_at=t, psk="", online=False, conf=False)
                    shred(f"{CONF_DIR}/{name}.conf")
                    wg_changed = caddy_changed = True
                    events.append(ev(T("Гостьовий доступ завершився: {0}, ключ відкликано", name), "access", name, icon="⌛"))
                    continue
                if left <= GUEST_WARN_SEC and not c.get("guest_warned") and c["status"] == "active":
                    c["guest_warned"] = True
                    events.append(ev(T("Гостьовий доступ {0} закінчиться о {1}. Продовжити: панель або wgctl extend {2} --hours 2", name, fmt_ts(c['guest_until'])[11:], name), "warn", name, icon="⏳"))
                continue                                     # guests do not need the other rules
            if c["status"] != "active":
                continue
            rd = rotate_days(st)
            if rd and not c.get("rotate_warned") and (t - c.get("rotated", c["created"])) // 86400 >= rd:
                c["rotate_warned"] = True
                events.append(ev(T("Час змінити ключ: {0} (не змінювався {1} дн). Перевидайте конфіг у панелі або wgctl reissue {2}", name, (t - c['rotated']) // 86400, name), "warn", name, icon="🔄"))
            if c.get("expires") and c["expires"] < today:
                c["status"], c["disabled_reason"] = "disabled", "expired"
                caddy_changed = True
                events.append(ev(T("Минув термін дії: {0} ({1}), доступ вимкнено", name, c['expires']), "access", name, level="warning", icon="⛔", user=
                                 T("{0}: термін дії доступу пристрою «{1}» закінчився ({2}). Щоб поновити, зверніться до адміністратора.", BRAND, name, c['expires'])))
                continue
            if c.get("expires") and not c.get("expiry_warned"):
                left = (dt.date.fromisoformat(c["expires"]) - dt.datetime.now(TZ).date()).days
                if left <= EXPIRY_WARN_DAYS:
                    c["expiry_warned"] = True
                    events.append(ev(T("Скоро закінчиться термін дії: {0} (до {1}, {2} дн)", name, c['expires'], left), "warn",
                                     name, icon="📅", user=T("{0}: доступ пристрою «{1}» діє до {2}. Щоб продовжити, зверніться до адміністратора.", BRAND, name, c['expires'])))
            if not c.get("autorevoke", True):
                continue
            idle = (t - idle_from(c)) // 86400
            if idle < INACTIVE_DAYS - WARN_DAYS:
                c["warned"] = False
            elif idle >= INACTIVE_DAYS and not c.get("admin"):
                c.update(status="revoked", revoked_at=t, psk="", online=False, conf=False)
                shred(f"{CONF_DIR}/{name}.conf")
                wg_changed = caddy_changed = True
                events.append(ev(T("Автоматично відкликано: {0} (не підключався {1} дн)", name, idle), "access", name, icon="🗑"))
            elif not c.get("warned"):
                c["warned"] = True
                if idle >= INACTIVE_DAYS:
                    events.append(ev(T("Адмін-клієнт {0} не підключався {1} дн. Продовжте (wgctl extend) або відкличте вручну", name, idle), "warn", name))
                else:
                    events.append(ev(T("Увага: {0} не підключався {1} дн, буде відкликаний через {2} дн", name, idle, INACTIVE_DAYS - idle), "warn", name, icon="⏳", user=
                                     T("{0}: пристрій «{1}» не підключався до VPN {2} дн. Через {3} дн доступ буде автоматично відкликано. Щоб зберегти доступ, просто підключіться до VPN.", BRAND, name, idle, INACTIVE_DAYS - idle)))
        for name, l in st["locations"].items():
            v = location_view(name, l, peers)
            prev = l.get("last_state", "ok")
            if v["state"] == "down" and prev != "down":
                events.append(ev(T("Локація {0}: немає зв'язку понад {1} хв", l.get("title") or name, LOCATION_DOWN_SEC // 60), "health",
                                 level="critical", icon="📡", link="/"))
            if v["state"] == "ok" and prev == "down":
                events.append(ev(T("Локація {0}: зв'язок відновлено", l.get("title") or name), "health", level="info", icon="✅"))
            l["last_state"] = v["state"]
        if not os.environ.get("WGCTL_NO_PROBE"):
            for name, sv in st.get("services", {}).items():
                h = tcp_probe(sv["target"], sv["target_port"])
                if sv.get("health") and sv["health"].get("ok") != h["ok"]:
                    events.append(ev(T("Сервіс {0}: {1}", name, T("знову відповідає") if h['ok'] else T("ціль не відповідає")), "health",
                                     level="info" if h["ok"] else "warning", icon="✅" if h["ok"] else "⚠️", link=f"/t/{name}"))
                sv["health"] = h
            for name, s in st["sites"].items():
                h = probe(s["backend"])
                if s.get("health") and s["health"].get("ok") != h["ok"]:
                    events.append(ev(T("Сайт {0}: {1}", name, T("знову працює") if h['ok'] else T("бекенд не відповідає")), "health",
                                     level="info" if h["ok"] else "warning", icon="✅" if h["ok"] else "⚠️", link=f"/s/{name}"))
                s["health"] = h
        save(st)
        if wg_changed or caddy_changed:
            apply(st, wg=wg_changed, caddy=caddy_changed)
    notify_events(events)
    try:
        hist_record(st, peers, server_info(slow=False))
    except Exception as ex:
        log(f"history: {ex!r}")
    try:
        visits_ingest(st)
    except Exception as ex:
        log(f"visits: {ex!r}")
    if now() // 60 % 10 == 0:                  # every 10 minutes: VPS health
        try:
            server_alerts(server_info())
        except Exception as ex:
            log(f"server check: {ex!r}")
    flush_outbox()


# ---- TCP services: SSH, RDP and so on through the hub ------------------------
# A client connects to <hub>:<service port>, and systemd-socket-proxyd on the VPS connects it to the target.
# Packet forwarding on the VPS stays off; nftables (chain wgctl_tcp) decides who may connect.
TCP_DIR = f"{STATE_DIR}/tcp"
TCP_NFT = P("/etc/nftables.d/wgctl-tcp.nft")
NFT_CONF = P("/etc/nftables.conf")
TCP_PORTS = (2201, 2999)                   # service ports on the hub
PROXYD = "/usr/lib/systemd/systemd-socket-proxyd"
TCP_PRESETS = {"ssh": 22, "rdp": 3389, "vnc": 5900}


def tcp_units():
    sock = (T("[Unit]\nDescription=wgctl TCP-сервіс на порту %i\n\n[Socket]\nListenStream={0}:%i\nFreeBind=true\nBacklog=64\n\n[Install]\nWantedBy=sockets.target\n", HUB_IP))
    svc = (T("[Unit]\nDescription=wgctl TCP-сервіс на порту %i\nRequires=wgctl-tcp@%i.socket\nAfter=wgctl-tcp@%i.socket\n\n[Service]\nEnvironmentFile={0}/%i.env\nExecStart={1} --connections-max=32 ${{TARGET}}\nDynamicUser=yes\nPrivateTmp=yes\nPrivateDevices=yes\nProtectSystem=strict\nProtectHome=yes\nNoNewPrivileges=yes\nCapabilityBoundingSet=\nRestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX\nSystemCallFilter=@system-service\nMemoryMax=64M\n", TCP_DIR, PROXYD))
    return {P("/etc/systemd/system/wgctl-tcp@.socket"): sock, P("/etc/systemd/system/wgctl-tcp@.service"): svc}


def tcp_ready():
    """Whether the one-time setup is done: service templates and the jump to the wgctl_tcp chain in nftables.conf."""
    try:
        conf = open(NFT_CONF).read()
    except OSError:
        return False
    return "jump wgctl_tcp" in conf and all(os.path.exists(p) for p in tcp_units())


def nft_conf_patched(text):
    """Adds the include of wgctl's file and the jump to the chain. Returns the new text or None if no place was found."""
    if "jump wgctl_tcp" in text:
        return text
    inc = f'include "{TCP_NFT[len(ROOT):] if ROOT else TCP_NFT}"'
    lines = text.splitlines()
    out, inc_done, jump_done = [], False, False
    for ln in lines:
        if not inc_done and re.match(r"\s*table\s+inet\s+filter\s*\{", ln):
            out += [T("# wgctl: TCP-сервіси (ланцюг wgctl_tcp; файл оновлює wgctl)"), inc, ""]
            inc_done = True
        out.append(ln)
        if not jump_done and re.search(rf"udp dport {LISTEN_PORT} accept", ln):
            ind = re.match(r"\s*", ln).group(0)
            out.append(T("{0}jump wgctl_tcp        # wgctl: дозволені TCP-сервіси", ind))
            jump_done = True
    return "\n".join(out) + "\n" if inc_done and jump_done else None


def render_tcp_nft(st):
    lines = [T("# Згенеровано wgctl. Не редагуйте вручну: зміни зітруться."), "table inet filter {", "\tchain wgctl_tcp {"]
    for name, sv in sorted(st.get("services", {}).items(), key=lambda x: x[1]["port"]):
        ips = sorted({st["clients"][n]["ip"] for n in sv.get("allow", [])
                      if n in st["clients"] and st["clients"][n]["status"] == "active"}, key=octet)
        if ips:
            lines.append(f'\t\tiifname "{IFACE}" ip saddr {{ {", ".join(ips)} }} tcp dport {sv["port"]} accept   # {name}')
    lines += ["\t}", "}"]
    return "\n".join(lines) + "\n"


def apply_tcp(st, force=False):
    """Updates nftables rules and services. Does nothing before the one-time `wgctl tcp setup`.
    force: enable the sockets of all services (after a restore from backup)."""
    if not tcp_ready():
        return
    new = render_tcp_nft(st)
    old = open(TCP_NFT).read() if os.path.exists(TCP_NFT) else None
    if new != old:
        write_file(TCP_NFT, new, 0o644)
        if not DRY:
            body = new.split("\n", 1)[1]
            r = run(["nft", "-f", "-"], f"flush chain inet filter wgctl_tcp\n{body}", check=False)
            if r.returncode != 0:
                if old is not None:
                    write_file(TCP_NFT, old, 0o644)
                die(T("nftables не прийняв правила TCP-сервісів: ") + r.stderr.strip())
    os.makedirs(TCP_DIR, exist_ok=True)
    want = {str(sv["port"]): f"TARGET={sv['target']}:{sv['target_port']}\n" for sv in st.get("services", {}).values()}
    have = {f[:-4] for f in os.listdir(TCP_DIR) if f.endswith(".env")}
    for port, env in want.items():
        path = f"{TCP_DIR}/{port}.env"
        changed = not os.path.exists(path) or open(path).read() != env
        if changed:
            write_file(path, env, 0o644)
        if not DRY:
            if port not in have or force:
                run(["systemctl", "enable", "--now", f"wgctl-tcp@{port}.socket"], check=False)
            elif changed:                                   # new target: restart the proxy
                run(["systemctl", "stop", f"wgctl-tcp@{port}.service"], check=False)
    for port in have - set(want):
        if not DRY:
            run(["systemctl", "disable", "--now", f"wgctl-tcp@{port}.socket"], check=False)
            run(["systemctl", "stop", f"wgctl-tcp@{port}.service"], check=False)
        os.remove(f"{TCP_DIR}/{port}.env")


def svc_target_ok(st, ip):
    """Target: an address in a location's network or an active client. The VPS itself and service addresses are refused."""
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        die(T("Ціль: IP-адреса, напр. 192.168.1.20"))
    if a.version != 4 or a.is_loopback or a.is_link_local or a.is_multicast or a.is_unspecified or str(a) in (HUB_IP, PUBLIC_IP):
        die(T("Ця адреса не може бути ціллю"))
    kind, where = site_host(st, {"backend": f"http://{ip}"})
    if kind in ("location", "client"):
        return kind, where
    die(T("{0} не належить ні до мережі локації, ні до пристрою з ключем. Доступні: ", ip)
        + ", ".join([n for l in st["locations"].values() for n in l.get("networks", [])] + [T("адреси ключів {0}X", NET)]))


def free_port(st):
    used = {sv["port"] for sv in st.get("services", {}).values()}
    for p in range(TCP_PORTS[0], TCP_PORTS[1] + 1):
        if p not in used:
            return p
    die(T("Вільних портів немає"))


def cmd_tcp_setup(a):
    """One-time setup: service templates and a chain in nftables. Shows the changes and asks for confirmation."""
    need_tty(T("Налаштування TCP-сервісів"))
    if not DRY and not os.path.exists(PROXYD):
        die(T("Не знайдено {0} (входить у systemd)", PROXYD))
    text = open(NFT_CONF).read()
    new = nft_conf_patched(text)
    if new is None:
        die(T("Не вдалося знайти в {0} місце для змін (рядки 'table inet filter' і 'udp dport 51820 accept'). Нічого не змінено.", NFT_CONF))
    import difflib
    if new != text:
        print(T("Зміни в {0}:\n", NFT_CONF))
        sys.stdout.writelines(difflib.unified_diff(text.splitlines(True), new.splitlines(True), T("було"), T("стане")))
        print(T("\nЛанцюг wgctl_tcp спершу порожній: нові дозволи з'являться лише коли ви додасте сервіс і дасте доступ."))
        if not a.yes and input(T("Застосувати? Напишіть так: ")).strip().lower() != T("так"):
            die(T("Скасовано, нічого не змінено"))
    st = load()
    if not os.path.exists(TCP_NFT):
        write_file(TCP_NFT, render_tcp_nft(st), 0o644)
    if new != text:
        if not DRY:
            r = run(["nft", "-c", "-f", "-"], new, check=False)
            if r.returncode != 0:
                die(T("Перевірка nftables не пройшла, нічого не змінено: ") + r.stderr.strip())
        shutil.copy2(NFT_CONF, NFT_CONF + ".before-wgctl-tcp")
        write_file(NFT_CONF, new, 0o644)
        if not DRY:
            r = run(["nft", "-f", NFT_CONF], check=False)
            if r.returncode != 0:
                shutil.copy2(NFT_CONF + ".before-wgctl-tcp", NFT_CONF)
                run(["nft", "-f", NFT_CONF], check=False)
                die(T("nftables не прийняв нові правила, повернуто попередні: ") + r.stderr.strip())
    for path, body in tcp_units().items():
        write_file(path, body, 0o644)
    if not DRY:
        run(["systemctl", "daemon-reload"])
    apply_tcp(st)
    log(T("EVENT:security Налаштовано TCP-сервіси (ланцюг wgctl_tcp у nftables)"))
    print(T("Готово. Копія попереднього файлу: {0}.before-wgctl-tcp\nДалі: wgctl tcp add <ім'я> <IP>:<порт>", NFT_CONF))


def parse_target(v):
    m = re.fullmatch(r"([\d.]+)(?::(\d{1,5}))?", v.strip())
    if not m:
        die(T("Ціль у форматі IP:порт, напр. 192.168.1.20:22"))
    port = int(m.group(2) or 0)
    if not 1 <= port <= 65535:
        die(T("Вкажіть порт цілі 1-65535, напр. 192.168.1.20:22"))
    return m.group(1), port


def cmd_tcp_add(a):
    name = a.name
    if not NAME_RE.match(name) or name in RESERVED:
        die(T("Ім'я: малі латинські літери, цифри, дефіс"))
    ip, tport = parse_target(a.target)
    with Lock():
        st = load()
        svcs = st.setdefault("services", {})
        if name in svcs or name in st["sites"]:
            die(T("Ім'я {0} вже зайняте сайтом або сервісом", name))
        kind, where = svc_target_ok(st, ip)
        port = a.port or free_port(st)
        if not TCP_PORTS[0] <= port <= TCP_PORTS[1] or any(sv["port"] == port for sv in svcs.values()):
            die(T("Порт хаба: вільний з {0}-{1}", TCP_PORTS[0], TCP_PORTS[1]))
        svcs[name] = {"target": ip, "target_port": tport, "port": port, "note": clean_note(a.note),
                      "allow": [], "created": now(), "health": {}}
        save(st)
        apply_tcp(st)
    notify(T("Додано TCP-сервіс: {0} ({1}:{2} -> {3}:{4})", name, HUB_IP, port, ip, tport), "access")
    print(T("Сервіс {0}: підключення {1}.{2}:{3} -> {4}:{5}. Доступ поки ні в кого: wgctl tcp allow {6} <ключ>", name, name, DOMAIN, port, ip, tport, name))
    if not tcp_ready():
        print(T("Увага: спершу виконайте разове налаштування: sudo wgctl tcp setup"))


def cmd_tcp_set(a):
    with Lock():
        st = load()
        sv = st.get("services", {}).get(a.name) or die(T("Сервісу {0} немає", a.name))
        if a.target:
            ip, tport = parse_target(a.target)
            svc_target_ok(st, ip)
            sv["target"], sv["target_port"], sv["health"] = ip, tport, {}
        if a.note is not None:
            sv["note"] = clean_note(a.note)
        save(st)
        apply_tcp(st)
    log(T("EVENT:info Змінено TCP-сервіс {0}: {1}:{2}", a.name, sv['target'], sv['target_port']))
    print(T("Сервіс {0} оновлено", a.name))


def cmd_tcp_rm(a):
    with Lock():
        st = load()
        if a.name not in st.get("services", {}):
            die(T("Сервісу {0} немає", a.name))
        del st["services"][a.name]
        save(st)
        apply_tcp(st)
    notify(T("Видалено TCP-сервіс: {0}", a.name), "access")
    print(T("Сервіс {0} видалено", a.name))


def cmd_tcp_allow(a, deny=False):
    with Lock():
        st = load()
        sv = st.get("services", {}).get(a.name) or die(T("Сервісу {0} немає", a.name))
        for who in a.who:
            c = st["clients"].get(who)
            if not deny and (not c or c["status"] == "revoked"):
                die(T("Ключа {0} немає", who))
        cur = set(sv.get("allow", []))
        sv["allow"] = sorted(cur - set(a.who) if deny else cur | set(a.who))
        save(st)
        apply_tcp(st)
    log(T("EVENT:info {0} доступ до TCP-сервісу {1}: {2}", T("Забрано") if deny else T("Надано"), a.name, ', '.join(a.who)))
    print(T("{0}: доступ мають {1}", a.name, ', '.join(sv['allow']) or T("ніхто")))


def tcp_probe(ip, port):
    import socket
    t0 = time.time()
    try:
        with socket.create_connection((ip, port), timeout=3):
            return {"ok": True, "ms": int((time.time() - t0) * 1000), "ts": now()}
    except OSError:
        return {"ok": False, "ms": None, "ts": now()}


def services_view(st):
    out = []
    for name, sv in sorted(st.get("services", {}).items(), key=lambda x: x[1]["port"]):
        kind, where = site_host(st, {"backend": f"http://{sv['target']}"})
        allow = [n for n in sv.get("allow", []) if n in st["clients"] and st["clients"][n]["status"] != "revoked"]
        out.append({"name": name, "host": f"{name}.{DOMAIN}", **sv, "allow": allow, "on_kind": kind, "on": where,
                    "on_title": (st["locations"].get(where) or {}).get("title") or where if kind == "location" else "",
                    "kind": next((k for k, p in TCP_PRESETS.items() if p == sv["target_port"]), "tcp")})
    return out


def cmd_tcp_list(a):
    st = load()
