# ---- WireGuard -------------------------------------------------------------
def base_conf(text):
    if BEGIN in text:
        pre, rest = text.split(BEGIN, 1)
        post = rest.split(END, 1)[1] if END in rest else ""
        text = pre.rstrip() + "\n" + post.lstrip("\n")
    return text.rstrip() + "\n"


def render_wg(st):
    lines = [BEGIN]
    live = [(n, c) for n, c in st["clients"].items() if c["status"] in ("active", "disabled")]
    for name, c in sorted(live, key=lambda x: octet(x[1]["ip"])):
        lines += ["", "[Peer]", f"# client: {name}", f"PublicKey = {c['pubkey']}"]
        if c.get("psk"):
            lines.append(f"PresharedKey = {c['psk']}")
        lines.append(f"AllowedIPs = {c['ip']}/32")
    for name, l in sorted(st["locations"].items()):
        if l.get("managed") and l.get("pubkey"):           # locations added with wgctl location add
            lines += ["", "[Peer]", f"# location: {name}", f"PublicKey = {l['pubkey']}"]
            if l.get("psk"):
                lines.append(f"PresharedKey = {l['psk']}")
            lines.append("AllowedIPs = " + ", ".join([f"{l['ip']}/32"] + l.get("networks", [])))
    lines += ["", END]
    return "\n".join(lines) + "\n"


def apply_wg(st):
    with open(WG_CONF) as f:
        text = f.read()
    new = base_conf(text) + "\n" + render_wg(st)
    if new == text:
        return
    backup(WG_CONF)
    write_file(WG_CONF, new)
    if DRY:
        return
    r = subprocess.run(["bash", "-c", f"wg syncconf {IFACE} <(wg-quick strip {IFACE})"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(T("Помилка застосування WireGuard: ") + r.stderr.strip())


def dump():
    """pubkey -> endpoint, handshake, rx, tx."""
    if os.environ.get("WGCTL_DUMP"):
        with open(os.environ["WGCTL_DUMP"]) as f:
            lines = f.read().splitlines()
    else:
        lines = run(["wg", "show", IFACE, "dump"]).stdout.splitlines()
    peers = {}
    for line in lines[1:]:
        p = line.split("\t")
        if len(p) >= 7:
            peers[p[0]] = {"endpoint": p[2], "hs": int(p[4]), "rx": int(p[5]), "tx": int(p[6])}
    return peers


def server_pubkey():
    if os.environ.get("WGCTL_SRV_PUB"):
        return os.environ["WGCTL_SRV_PUB"]
    return run(["wg", "show", IFACE, "public-key"]).stdout.strip()


def genkeys():
    priv = run(["wg", "genkey"]).stdout.strip()
    pub = run(["wg", "pubkey"], priv).stdout.strip()
    psk = run(["wg", "genpsk"]).stdout.strip()
    return priv, pub, psk


def client_conf(priv, ip, psk):
    return ("[Interface]\n"
            f"PrivateKey = {priv}\n"
            f"Address = {ip}/32\n\n"
            "[Peer]\n"
            f"PublicKey = {server_pubkey()}\n"
            f"PresharedKey = {psk}\n"
            f"Endpoint = {ENDPOINT}\n"
            f"AllowedIPs = {HUB_IP}/32\n"
            "PersistentKeepalive = 25\n")


