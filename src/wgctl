def own_port_ok(port):
    """Ports of the VPS itself that may be given to a site: not service ports (SSH, Caddy, its API, the panel) and not TCP services."""
    return port >= 1024 and port not in (2019, 8090) and not TCP_PORTS[0] <= port <= TCP_PORTS[1]


def norm_backend(b, st):
    """Backend: only an IPv4 address in a location's network, a key's address or the VPS itself (on an allowed port).
    Host names are not accepted: otherwise DNS or forms like 127.1 would bypass these checks."""
    if not re.match(r"^https?://", b):
        b = "http://" + b
    m = re.fullmatch(r"(https?)://(\d{1,3}(?:\.\d{1,3}){3})(?::(\d{1,5}))?/?", b)
    if not m:
        die(T("Бекенд у форматі http://192.168.1.20:80 або https://192.168.1.21:8006"))
    port = int(m.group(3) or (443 if m.group(1) == "https" else 80))
    if not 1 <= port <= 65535:
        die(T("Порт бекенда: 1-65535"))
    try:
        ip = ipaddress.IPv4Address(m.group(2))
    except ValueError:
        die(T("Бекенд у форматі http://192.168.1.20:80 або https://192.168.1.21:8006"))
    if ip.is_loopback or str(ip) in (HUB_IP, PUBLIC_IP):
        if not own_port_ok(port):
            # 2019 Caddy API, 8090 panel, <1024 SSH and Caddy itself, 2201-2999 TCP services: otherwise a site would bypass their filters
            die(T("Порт {0} на самому VPS зайнятий службами (SSH, Caddy, панель) і не може бути сайтом", port))
    elif site_host(st, {"backend": f"http://{ip}"})[0] not in ("location", "client"):
        die(T("{0} не належить ні до мережі локації, ні до пристрою з ключем. Доступні: ", ip)
            + ", ".join([n for l in st["locations"].values() for n in l.get("networks", [])] + [T("адреси ключів {0}X", NET)]))
    return f"{m.group(1)}://{ip}" + (f":{m.group(3)}" if m.group(3) else "")


