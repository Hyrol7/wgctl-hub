def cert_expiry():
    files = glob.glob(f"{CADDY_CERTS}/*/wildcard_.{DOMAIN}/wildcard_.{DOMAIN}.crt")
    if not files or not shutil.which("openssl"):
        return None
    r = run(["openssl", "x509", "-enddate", "-noout", "-in", files[0]], check=False)
    m = re.search(r"notAfter=(.+)", r.stdout)
    if not m:
        return None
    return int(dt.datetime.strptime(m.group(1).strip(), "%b %d %H:%M:%S %Y %Z")
               .replace(tzinfo=dt.timezone.utc).timestamp())


def service_active(name):
    if DRY:
        return True
    return run(["systemctl", "is-active", name], check=False).stdout.strip() == "active"


def location_view(name, l, peers):
    p = peers.get(l.get("pubkey", ""))
    hs = p["hs"] if p else 0
    age = now() - hs if hs else None
    state = ("down" if age is None or age > LOCATION_DOWN_SEC else
             "warn" if age > LOCATION_WARN_SEC else "ok")
    return {"name": name, "note": l.get("note", ""), "title": l.get("title") or name, "state": state,
            "handshake": hs, "endpoint": (p or {}).get("endpoint", ""), "ip": l.get("ip"),
            "sites": l.get("sites", []), "networks": l.get("networks", []), "managed": bool(l.get("managed")),
            "panel": bool(l.get("panel")), "has_conf": os.path.exists(f"{CONF_DIR}/location-{name}.conf")}


def topology(st, peers):
    """What lives where: sites by location, on client devices, on the VPS and elsewhere; device summary."""
    t = now()
    groups = {"location": {}, "client": {}, "vps": [], "other": []}
    for name, s in sorted(st["sites"].items()):
        kind, where = site_host(st, s)
        h = s.get("health") or {}
        item = {"name": name, "ok": h.get("ok"), "ms": h.get("ms"), "public": bool(s.get("public"))}
        if kind in ("location", "client"):
            groups[kind].setdefault(where, []).append(item)
        else:
            groups[kind].append(item)
    for name, sv in sorted(st.get("services", {}).items()):
        kind, where = site_host(st, {"backend": f"http://{sv['target']}"})
        h = sv.get("health") or {}
        item = {"name": name, "ok": h.get("ok"), "ms": h.get("ms"), "public": False, "svc": True, "port": sv["port"]}
        if kind in ("location", "client"):
            groups[kind].setdefault(where, []).append(item)
    devices = []
    for n, c in sorted(st["clients"].items(), key=lambda x: octet(x[1]["ip"])):
        if c["status"] == "revoked":
            continue
        idle = (t - idle_from(c)) // 86400
        state = ("bad" if c.get("suspect") or c.get("disabled_reason") == "suspicious" else
                 "warn" if c["status"] == "active" and c.get("autorevoke", True) and INACTIVE_DAYS - idle <= WARN_DAYS else
                 "off" if c["status"] == "disabled" else "ok" if c.get("online") else "idle")
        hs = (peers.get(c["pubkey"]) or {}).get("hs", 0)
        online = bool(hs) and t - hs < ONLINE_SEC
        if state == "ok" and not online:
            state = "idle"
        elif state == "idle" and online:
            state = "ok"
        devices.append({"name": n, "state": state, "online": online,
                        "sites": groups["client"].get(n, [])})
    return {"locations": {n: groups["location"].get(n, []) for n in st["locations"]},
