def ev(text, cat="access", client=None, user=None, level=None, icon=None, link=None):
    """An event: text for the admin, category, client, (optional) text for the user themselves,
    level (critical | warning | info; by default from the category), icon and panel page."""
    return {"text": text, "cat": cat, "client": client, "user": user, "level": level, "icon": icon, "link": link}


def notify(msg, cat="access", client=None, user=None, level=None, icon=None, link=None):
    """Log + Signal notification queue. Never breaks the main action."""
    level = level if level in LEVELS else LEVEL_BY_CAT.get(cat, "info")
    log(f"EVENT:{cat} {msg}")
    try:
        cfg, phone, panel_on, is_client = notify_cfg(), "", False, False
        try:
            with open(STATE) as f:
                stj = json.load(f)
            panel_on = bool(stj.get("panel", {}).get("enabled"))
            if client:
                is_client = client in stj["clients"]
                phone = (stj["clients"].get(client) or {}).get("phone", "")
        except (OSError, ValueError, KeyError):
            pass
        if link is None and is_client and level != "info":
            link = f"/c/{client}"
        url = f"https://{PANEL_HOST}{link}" if link and panel_on else ""
        icon = icon or event_icon(cat, level)
        item = {"kind": "admin", "text": msg, "level": level, "icon": icon, "url": url}
        items = []
        if (cat != "connect" or cfg.get("connect")) and cat != "info":
            items += [{**t, **item} for t in admin_targets(cfg, level)]
        if user and phone and cfg.get("users", True):
            items.append({"to": phone, "group": False, "kind": "user", "text": f"{icon} {fmt_ts(now())[11:]}  {user}"})
        if items:
            enqueue(items)
    except Exception as e:
        log(f"notify error: {e!r}")


def notify_events(events):
    for e in events:
        notify(e["text"], e["cat"], e.get("client"), e.get("user"), e.get("level"), e.get("icon"), e.get("link"))


def run(cmd, inp=None, check=True, env=None):
    r = subprocess.run(cmd, input=inp, capture_output=True, text=True, env=env,
                       stdin=None if inp is not None else subprocess.DEVNULL)
    if check and r.returncode != 0:
        die(T("Помилка: {0}: {1}", ' '.join(cmd), (r.stderr or r.stdout).strip()))
    return r


def write_file(path, text, mode=0o600):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with open(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def shred(path):
    if os.path.exists(path):
        if shutil.which("shred"):
            subprocess.run(["shred", "-u", path])
        if os.path.exists(path):
            os.remove(path)


def backup(path):
    if not os.path.exists(path):
        return
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    stamp = dt.datetime.now(TZ).strftime("%Y%m%d-%H%M%S")
    shutil.copy2(path, f"{BACKUP_DIR}/{os.path.basename(path)}.{stamp}")
    base = os.path.basename(path) + "."
    old = sorted(f for f in os.listdir(BACKUP_DIR) if f.startswith(base))
    for name in old[:-KEEP_BACKUPS]:
        os.remove(os.path.join(BACKUP_DIR, name))


def parse_date(s):
    if s in (None, "", "none", "ні"):
        return None
    try:
        d = dt.date.fromisoformat(s)
    except ValueError:
        die(T("Дата у форматі РРРР-ММ-ДД, напр. 2026-12-31, або none"))
    if d < dt.datetime.now(TZ).date():
        die(T("Дата {0} уже минула", d.isoformat()))
    return d.isoformat()


def qr(path, svg=False):
    if not shutil.which("qrencode"):
        die(T("Немає qrencode. Встановіть: apt install -y qrencode"))
    if svg:
        return run(["qrencode", "-t", "SVG", "-r", path]).stdout
    subprocess.run(["qrencode", "-t", "ansiutf8", "-r", path])


def onoff(s):
    if s in ("on", "yes", "так", "1", "true"):
        return True
    if s in ("off", "no", "ні", "0", "false"):
        return False
    die(T("Значення: on або off"))


class Lock:
    def __enter__(self):
        os.makedirs(os.path.dirname(LOCK), exist_ok=True)
        self.f = open(LOCK, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


