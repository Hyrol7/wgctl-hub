_GEO = {}


def _db(name):
    if name not in _GEO:
        _GEO[name] = None
        path = f"{GEO_DIR}/{name}.mmdb"
        if os.path.exists(path):
            try:
                import maxminddb
                _GEO[name] = maxminddb.open_database(path)
            except ImportError:
                log(T("geo: немає python3-maxminddb"))
    return _GEO[name]


def geo_lookup(ip):
    """Country, city, coordinates, provider. Local databases only, no outside requests."""
    if os.environ.get("WGCTL_GEO_FAKE"):
        with open(os.environ["WGCTL_GEO_FAKE"]) as f:
            g = json.load(f).get(ip, {})
    else:
        g = {}
        city = _db("city")
        r = city.get(ip) if city else None
        if r:
            g["cc"] = (r.get("country") or {}).get("iso_code", "")
            g["country"] = ((r.get("country") or {}).get("names") or {}).get("en", "")
            g["city"] = ((r.get("city") or {}).get("names") or {}).get("en", "")
            loc = r.get("location") or {}
            if "latitude" in loc:
                g["lat"], g["lon"] = round(loc["latitude"], 3), round(loc["longitude"], 3)
        asn = _db("asn")
        r = asn.get(ip) if asn else None
        if r:
            g["asn"] = r.get("autonomous_system_number")
            g["org"] = r.get("autonomous_system_organization", "")
    org = (g.get("org") or "").lower()
    g["hosting"] = any(w in org for w in HOSTING_WORDS)
    tor = f"{GEO_DIR}/tor-exits.txt"
    g["tor"] = bool(os.path.exists(tor) and ip in open(tor).read().split())
    return g


def place(e):
    parts = [e.get("cc", ""), e.get("city", "")]
    s = " ".join(x for x in parts if x) or T("невідомо")
    return s + (f", {e['org']}" if e.get("org") else "")


def km(a, b):
    from math import asin, cos, radians, sin, sqrt
    la1, lo1, la2, lo2 = map(radians, (a["lat"], a["lon"], b["lat"], b["lon"]))
    h = sin((la2 - la1) / 2) ** 2 + cos(la1) * cos(la2) * sin((lo2 - lo1) / 2) ** 2
    return 2 * 6371 * asin(sqrt(h))


def flag(c, name, reason, events, user=None):
    """Flag "candidate for blocking" + notification (at most once an hour for the same reason)."""
    t = now()
    if c.get("suspect") == reason and t - c.get("suspect_at", 0) < 3600:
        return
    c["suspect"], c["suspect_at"] = reason, t
    events.append(ev(T("Підозра: {0}: {1}. Кандидат на блокування", name, reason), "security", name, user, icon="🕵️"))


def geo_rules(name, c, entry, prev, events):
    cc, org = entry.get("cc"), entry.get("org", "")
    if entry.get("tor"):
        flag(c, name, T("підключення через Tor ({0})", entry['ip']), events)
    elif entry.get("hosting") and org not in c.get("trusted_orgs", []):
        flag(c, name, T("адреса хостингу або VPN-сервісу: {0} ({1})", org, entry['ip']), events)
    if cc:
        seen = c.setdefault("countries", [])
        if not seen:
            seen.append(cc)                       # first connection = home country
        elif cc not in seen:
            flag(c, name, T("нова країна {0} ({1}), раніше: {2}", cc, place(entry), ', '.join(seen)), events,
                 T("{0}: пристрій «{1}» підключився до VPN з незвичного місця ({2}). Якщо це не ви, негайно повідомте адміністратора.", BRAND, name, place(entry)))
    if prev and "lat" in entry and "lat" in prev:
        dist = km(prev, entry)
        hours = max((entry["ts"] - prev["ts"]) / 3600, 1 / 60)
        if entry.get("cc") != prev.get("cc") and dist >= TRAVEL_MIN_KM and dist / hours > TRAVEL_KMH:
            flag(c, name, T("неможлива подорож: {0} -> {1}, {2} км за {3} хв", place(prev), place(entry), int(dist), int(hours * 60)), events,
                 T("{0}: пристрій «{1}» підключився до VPN з незвичного місця ({2}). Якщо це не ви, негайно повідомте адміністратора.", BRAND, name, place(entry)))


