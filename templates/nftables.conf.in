#!/usr/sbin/nft -f
# Firewall for a wgctl hub (generated by install.sh, safe to edit).
# Policy: drop everything inbound except SSH, WireGuard, the hub's own HTTPS
# for VPN clients and locations, and Cloudflare for public sites.
# Nothing is forwarded: clients reach sites only through Caddy on the hub,
# never the home networks directly, and never each other.
flush ruleset

define WAN = "@WAN@"
define VPN_CLIENTS = @CLIENTS@
define VPN_LOCATIONS = @LOCATIONS@
include "/etc/nftables.d/cloudflare.nft"

# wgctl: TCP services (chain wgctl_tcp; the file is managed by wgctl)
include "/etc/nftables.d/wgctl-tcp.nft"

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        tcp dport @SSH_PORT@ accept
        udp dport @WG_PORT@ accept
        jump wgctl_tcp        # wgctl: allowed TCP services
        iifname "@IFACE@" ip saddr $VPN_CLIENTS tcp dport { 80, 443 } accept
        iifname "@IFACE@" ip saddr $VPN_LOCATIONS tcp dport 443 accept
        iifname $WAN ip saddr $CLOUDFLARE tcp dport 443 accept
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        meta l4proto ipv6-icmp accept
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
    }
    chain output {
        type filter hook output priority filter; policy accept;
    }
}
